{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "LogVue": {
    "Title": "Shelfwarden",
    // Deletes log entries older than this many days. 0 keeps everything.
    "RetentionDays": 30
  },
  "AllowedHosts": "*",
  "BulkEditMaxBookCount": 100
}
