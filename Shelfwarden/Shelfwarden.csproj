<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>shelfwarden-web-2589b324-ac0c-49ce-8caa-b1a7380a2ecd</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result" Version="10.1.0" />
		<PackageReference Include="Autofac" Version="9.1.0" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.7" />
		<!--
		  Workaround for https://github.com/dotnet/efcore/issues/38107 — the EF 10.0.6+ design
		  tooling expects Microsoft.EntityFrameworkCore.Design to be referenced on the *startup*
		  project as well, otherwise an older transitive copy gets loaded and `dotnet ef` fails
		  with `MissingMethodException: AbstractionsStrings.ArgumentIsEmpty(Object)`.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.71" />
		<PackageReference Include="Sejil" Version="3.0.4" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.MSSqlServer" Version="9.0.3" />
		<PackageReference Include="Serilog.Sinks.MySQL" Version="5.0.0" />
		<PackageReference Include="Serilog.Sinks.Postgresql.Alternative" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.SQLite" Version="6.0.0" />

		<!--
			KokoroSharp.CPU (referenced transitively via Shelfwarden.Services) only copies its
			"voices" content into $(OutputPath) via a raw AfterTargets="Build" <Copy> task, which
			does not flow into `dotnet publish` output (used by the Dockerfile). Referencing the
			base KokoroSharp package directly here (GeneratePathProperty) gives us
			$(PkgKokoroSharp) so we can publish the voices ourselves below.
		-->
		<PackageReference Include="KokoroSharp" Version="0.6.7" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shelfwarden.Core\Shelfwarden.Core.csproj" />
		<ProjectReference Include="..\Shelfwarden.Data\Shelfwarden.Data.csproj" />
		<ProjectReference Include="..\Shelfwarden.Data.Sqlite\Shelfwarden.Data.Sqlite.csproj" />
		<ProjectReference Include="..\Shelfwarden.Data.Sql\Shelfwarden.Data.Sql.csproj" />
		<ProjectReference Include="..\Shelfwarden.Data.Npgsql\Shelfwarden.Data.Npgsql.csproj" />
		<ProjectReference Include="..\Shelfwarden.Data.MySql\Shelfwarden.Data.MySql.csproj" />
		<ProjectReference Include="..\Shelfwarden.Models\Shelfwarden.Models.csproj" />
		<ProjectReference Include="..\Shelfwarden.Services\Shelfwarden.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\img\" />
	</ItemGroup>

	<!--
		KokoroSharp voice files (see KokoroEngineProvider.EnsureVoicesLoaded, which reads from
		AppContext.BaseDirectory + "voices"). Published explicitly as Content so they land in
		the `dotnet publish` output (e.g. the Docker image), not just in the build bin folder.

		The "espeak" folder is also required — KokoroSharp's integrated phonemization (text ->
		phonemes, needed for every supported language including English) only works through the
		bundled eSpeak NG backend. Without it, synthesis fails even though the voice list itself
		loads fine.
	-->
	<ItemGroup Condition="'$(PkgKokoroSharp)' != ''">
		<Content Include="$(PkgKokoroSharp)\content\voices\**\*" Link="voices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="$(PkgKokoroSharp)\content\espeak\**\*" Link="espeak\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
