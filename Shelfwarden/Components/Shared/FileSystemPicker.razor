@*
    FileSystemPicker.razor
    ----------------------
    Reusable Blazor Server component for browsing the server/container filesystem and
    picking a folder or file. Designed for use in Docker deployments where the host
    filesystem is mounted into the container.

    PARAMETERS:
        Mode              - PickerMode.Folder (default) or PickerMode.File
        AllowedExtensions - Optional file filter (file mode only), e.g. new[]{ ".epub", ".pdf" }. Null = all files.
        RootPath          - Starting root path. Defaults to "/" on Linux, or first drive root on Windows.
        Title             - Dialog title text.
        OnConfirm         - Callback with the selected path (string).
        OnCancel          - Callback when the dialog is dismissed.

    USAGE (folder picker):
        <FileSystemPicker
            Mode="FileSystemPicker.PickerMode.Folder"
            Title="Select a Shelf Folder"
            OnConfirm="HandleFolderSelected"
            OnCancel="HidePicker" />

    USAGE (file picker):
        <FileSystemPicker
            Mode="FileSystemPicker.PickerMode.File"
            AllowedExtensions='new[]{ ".epub", ".pdf", ".mobi" }'
            Title="Select an Ebook"
            OnConfirm="HandleFileSelected"
            OnCancel="HidePicker" />
*@

@using System.IO

<div class="fsp-overlay" @onclick="HandleOverlayClick">
    <div class="fsp-dialog" @onclick:stopPropagation="true">

        <div class="fsp-header">
            <div class="fsp-header-left">
                <i class="bi @(Mode == PickerMode.File ? "bi-file-earmark-text" : "bi-folder2-open") fsp-icon"></i>
                <span class="fsp-title">@Title</span>
            </div>
            <button class="fsp-close" @onclick="Cancel" title="Cancel">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="fsp-breadcrumb">
            @for (int i = 0; i < _breadcrumbs.Count; i++)
            {
                var crumb = _breadcrumbs[i];
                var isLast = i == _breadcrumbs.Count - 1;
                if (isLast)
                {
                    <span class="fsp-crumb fsp-crumb--active">@crumb.Label</span>
                }
                else
                {
                    <button class="fsp-crumb fsp-crumb--link" @onclick="() => NavigateTo(crumb.Path)">@crumb.Label</button>
                    <span class="fsp-crumb-sep">›</span>
                }
            }
        </div>

        <div class="fsp-body">
            @if (_error != null)
            {
                <div class="fsp-error">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@_error
                </div>
            }
            else if (_entries.Count == 0)
            {
                <div class="fsp-empty">This folder is empty.</div>
            }
            else
            {
                <ul class="fsp-list">
                    @foreach (var entry in _entries)
                    {
                        var e = entry;
                        var isSelected = _selectedPath == e.FullPath;

                        <li class="fsp-item @(isSelected ? "fsp-item--selected" : "") @(e.IsDirectory ? "fsp-item--dir" : "fsp-item--file")"
                            @onclick="() => HandleEntryClick(e)"
                            @ondblclick="() => HandleEntryDoubleClick(e)">
                            <i class="bi @(e.IsDirectory ? "bi-folder-fill" : GetFileIcon(e.Name)) fsp-item-icon"></i>
                            <span class="fsp-item-name">@e.Name</span>
                            @if (!e.IsDirectory)
                            {
                                <span class="fsp-item-meta">@FormatSize(e.Size)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="fsp-footer">
            <div class="fsp-selection">
                @if (_selectedPath != null)
                {
                    <span class="fsp-selection-label">Selected:</span>
                    <span class="fsp-selection-path" title="@_selectedPath">@TruncatePath(_selectedPath)</span>
                }
                else if (Mode == PickerMode.Folder)
                {
                    <span class="fsp-selection-hint">Double-click a folder to open it, or click once to select it.</span>
                }
                else
                {
                    <span class="fsp-selection-hint">Click a file to select it, or double-click to select and confirm.</span>
                }
            </div>
            <div class="fsp-actions">
                @if (Mode == PickerMode.Folder)
                {
                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(_currentPath == WindowsVirtualRoot)"
                        @onclick="SelectCurrentFolder"
                        title="Use the currently browsed folder">
                    <i class="bi bi-folder-check me-1"></i>Use Current Folder
                </button>
                }
                <button class="btn btn-link btn-sm px-2" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary btn-sm"
                        disabled="@(_selectedPath == null)"
                        @onclick="Confirm">
                    <i class="bi bi-check-lg me-1"></i>Select
                </button>
            </div>
        </div>

    </div>
</div>

<style>
    .fsp-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1060;
        animation: fsp-fade-in 0.15s ease;
    }

    @@keyframes fsp-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .fsp-dialog {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        width: min(680px, 95vw);
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.04);
        animation: fsp-slide-in 0.18s ease;
        font-family: var(--bs-body-font-family);
        color: var(--bs-body-color);
    }

    @@keyframes fsp-slide-in {
        from { transform: translateY(12px) scale(0.98); opacity: 0; }
        to   { transform: translateY(0)    scale(1);    opacity: 1; }
    }

    /* ── Header ── */
    .fsp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .fsp-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fsp-icon { font-size: 1.1rem; color: var(--bs-primary); }

    .fsp-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--bs-emphasis-color);
        letter-spacing: 0.01em;
    }

    .fsp-close {
        background: none;
        border: none;
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        line-height: 1;
        transition: color 0.15s, background 0.15s;
    }

    .fsp-close:hover {
        color: var(--bs-body-color);
        background: var(--bs-secondary-bg);
    }

    /* ── Breadcrumb ── */
    .fsp-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 2px;
        padding: 9px 20px;
        background: var(--bs-tertiary-bg);
        border-bottom: 1px solid var(--bs-border-color);
        font-size: 0.82rem;
    }

    .fsp-crumb { color: var(--bs-secondary-color); }

    .fsp-crumb--link {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--bs-link-color);
        padding: 2px 5px;
        border-radius: 3px;
        font-size: 0.82rem;
        transition: background 0.12s;
    }

    .fsp-crumb--link:hover {
        background: var(--bs-secondary-bg);
        color: var(--bs-emphasis-color);
    }

    .fsp-crumb--active {
        color: var(--bs-body-color);
        font-weight: 500;
        padding: 2px 5px;
    }

    .fsp-crumb-sep {
        color: var(--bs-border-color);
        font-size: 0.9rem;
    }

    /* ── Body / file list ── */
    .fsp-body {
        flex: 1;
        overflow-y: auto;
        padding: 8px 12px;
        min-height: 260px;
    }

    .fsp-body::-webkit-scrollbar { width: 6px; }
    .fsp-body::-webkit-scrollbar-track { background: transparent; }
    .fsp-body::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 3px; }

    .fsp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .fsp-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.1s;
        user-select: none;
    }

    .fsp-item:hover { background: var(--bs-secondary-bg); }

    .fsp-item--selected {
        background: var(--bs-tertiary-bg) !important;
        outline: 1px solid rgba(var(--bs-primary-rgb), 0.35);
    }

    .fsp-item--file.fsp-item--selected {
        outline-color: rgba(var(--bs-success-rgb), 0.35);
    }

    .fsp-item-icon {
        font-size: 0.95rem;
        flex-shrink: 0;
        color: var(--bs-secondary-color);
    }

    .fsp-item--dir .fsp-item-icon { color: var(--bs-warning); }

    .fsp-item-name {
        flex: 1;
        font-size: 0.88rem;
        color: var(--bs-body-color);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .fsp-item--dir .fsp-item-name { color: var(--bs-emphasis-color); }

    .fsp-item-meta {
        font-size: 0.75rem;
        color: var(--bs-secondary-color);
        flex-shrink: 0;
    }

    .fsp-error {
        padding: 20px;
        color: var(--bs-danger);
        font-size: 0.88rem;
    }

    .fsp-empty {
        padding: 40px 20px;
        text-align: center;
        color: var(--bs-secondary-color);
        font-size: 0.88rem;
    }

    /* ── Footer ── */
    .fsp-footer {
        border-top: 1px solid var(--bs-border-color);
        padding: 14px 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .fsp-selection {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        min-height: 1.2em;
    }

    .fsp-selection-label {
        color: var(--bs-secondary-color);
        flex-shrink: 0;
    }

    .fsp-selection-path {
        color: var(--bs-success);
        font-family: var(--bs-font-monospace, 'Consolas', monospace);
        font-size: 0.8rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .fsp-selection-hint {
        color: var(--bs-secondary-color);
        font-style: italic;
    }

    .fsp-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        align-items: center;
    }
</style>

@code {
    // Sentinel path used when on Windows with no explicit RootPath — represents the "This PC" drive list view.
    private const string WindowsVirtualRoot = "\x00DRIVES";

    // ── Public API ──────────────────────────────────────────────────────────────

    public enum PickerMode { Folder, File }

    /// Whether to pick a Folder or a File.
    [Parameter] public PickerMode Mode { get; set; } = PickerMode.Folder;

    /// File extensions to show (file mode only). Null = show all files. E.g. new[]{ ".epub", ".pdf" }
    [Parameter] public string[]? AllowedExtensions { get; set; }

    /// Root path to start from. Defaults to "/" on Linux, or a "This PC" drive list on Windows.
    [Parameter] public string? RootPath { get; set; }

    /// Dialog title.
    [Parameter] public string Title { get; set; } = "Select";

    /// Fired with the selected path when the user confirms.
    [Parameter] public EventCallback<string> OnConfirm { get; set; }

    /// Fired when the user cancels or clicks outside.
    [Parameter] public EventCallback OnCancel { get; set; }

    // ── Private state ──────────────────────────────────────────────────────────

    private string _currentPath = "/";
    private string? _selectedPath;
    private string? _error;
    private List<FileSystemEntry> _entries = new();
    private List<Breadcrumb> _breadcrumbs = new();

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        // When no RootPath is given on Windows, show the full drive list first.
        _currentPath = RootPath ?? (IsWindows() ? WindowsVirtualRoot : "/");
        LoadEntries(_currentPath);
    }

    // ── Navigation ────────────────────────────────────────────────────────────

    private void NavigateTo(string path)
    {
        _selectedPath = null;
        _currentPath = path;
        LoadEntries(path);
    }

    private void LoadEntries(string path)
    {
        _error = null;
        _entries.Clear();

        try
        {
            if (path == WindowsVirtualRoot)
            {
                // Windows "This PC" — enumerate all ready drives as navigable entries.
                var drives = DriveInfo.GetDrives()
                    .Where(d => d.IsReady)
                    .OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase)
                    .Select(d => new FileSystemEntry
                    {
                        Name = string.IsNullOrWhiteSpace(d.VolumeLabel)
                            ? d.Name.TrimEnd('\\', '/')
                            : $"{d.Name.TrimEnd('\\', '/')}  —  {d.VolumeLabel}",
                        FullPath = d.RootDirectory.FullName,
                        IsDirectory = true
                    });
                _entries.AddRange(drives);
            }
            else
            {
                var dirs = Directory.GetDirectories(path)
                    .OrderBy(d => Path.GetFileName(d), StringComparer.OrdinalIgnoreCase)
                    .Select(d => new FileSystemEntry
                    {
                        Name = Path.GetFileName(d),
                        FullPath = d,
                        IsDirectory = true
                    });
                _entries.AddRange(dirs);

                if (Mode == PickerMode.File)
                {
                    var files = Directory.GetFiles(path)
                        .Where(f => AllowedExtensions == null ||
                                    AllowedExtensions.Contains(Path.GetExtension(f), StringComparer.OrdinalIgnoreCase))
                        .OrderBy(f => Path.GetFileName(f), StringComparer.OrdinalIgnoreCase)
                        .Select(f => new FileSystemEntry
                        {
                            Name = Path.GetFileName(f),
                            FullPath = f,
                            IsDirectory = false,
                            Size = new FileInfo(f).Length
                        });
                    _entries.AddRange(files);
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _error = "Access denied to this folder.";
        }
        catch (Exception ex)
        {
            _error = $"Could not read folder: {ex.Message}";
        }

        BuildBreadcrumbs(path);
    }

    private void BuildBreadcrumbs(string path)
    {
        _breadcrumbs.Clear();

        var isVirtualRoot = RootPath == null && IsWindows();
        var rootPath  = isVirtualRoot ? WindowsVirtualRoot : (RootPath ?? "/");
        var rootLabel = IsWindows() ? "This PC" : "/";

        _breadcrumbs.Add(new Breadcrumb { Label = rootLabel, Path = rootPath });

        if (path == rootPath) return;

        if (isVirtualRoot)
        {
            // Windows with no explicit root: path is a normal absolute Windows path.
            // First add the drive root segment ("C:\"), then subdirectory segments.
            var driveRoot = Path.GetPathRoot(path);
            if (string.IsNullOrEmpty(driveRoot)) return;

            var driveLabel = driveRoot.TrimEnd('\\', '/'); // "C:\" → "C:"
            _breadcrumbs.Add(new Breadcrumb { Label = driveLabel, Path = driveRoot });

            if (string.Equals(path, driveRoot, StringComparison.OrdinalIgnoreCase)) return;

            var relative = Path.GetRelativePath(driveRoot, path);
            var accumulated = driveRoot;
            foreach (var part in relative.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                                         .Where(p => !string.IsNullOrEmpty(p)))
            {
                accumulated = Path.Combine(accumulated, part);
                _breadcrumbs.Add(new Breadcrumb { Label = part, Path = accumulated });
            }
        }
        else
        {
            // Explicit RootPath (or Linux "/" default).
            var relative = Path.GetRelativePath(rootPath, path);
            if (relative == ".") return;

            var accumulated = rootPath;
            foreach (var part in relative.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
                                         .Where(p => !string.IsNullOrEmpty(p)))
            {
                accumulated = Path.Combine(accumulated, part);
                _breadcrumbs.Add(new Breadcrumb { Label = part, Path = accumulated });
            }
        }
    }

    // ── Interaction ───────────────────────────────────────────────────────────

    private void HandleEntryClick(FileSystemEntry entry)
    {
        if (Mode == PickerMode.Folder && entry.IsDirectory)
            _selectedPath = entry.FullPath;
        else if (Mode == PickerMode.File && !entry.IsDirectory)
            _selectedPath = entry.FullPath;
    }

    private void HandleEntryDoubleClick(FileSystemEntry entry)
    {
        if (entry.IsDirectory)
            NavigateTo(entry.FullPath);
        else if (Mode == PickerMode.File)
        {
            _selectedPath = entry.FullPath;
            Confirm();
        }
    }

    private void SelectCurrentFolder()
    {
        if (_currentPath != WindowsVirtualRoot)
            _selectedPath = _currentPath;
    }

    private void HandleOverlayClick() => Cancel();

    private void Cancel()
    {
        if (OnCancel.HasDelegate)
            OnCancel.InvokeAsync();
    }

    private void Confirm()
    {
        if (_selectedPath != null && OnConfirm.HasDelegate)
            OnConfirm.InvokeAsync(_selectedPath);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static bool IsWindows() =>
        System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(
            System.Runtime.InteropServices.OSPlatform.Windows);

    private static string GetFileIcon(string filename) =>
        Path.GetExtension(filename).ToLowerInvariant() switch
        {
            ".epub"                      => "bi-book",
            ".pdf"                       => "bi-file-earmark-pdf",
            ".mobi" or ".azw" or ".azw3" => "bi-file-earmark-text",
            ".cbz" or ".cbr"             => "bi-images",
            ".txt"                       => "bi-file-earmark-text",
            ".jpg" or ".jpeg"
                or ".png" or ".gif"
                or ".webp"               => "bi-file-earmark-image",
            ".mp3" or ".flac" or ".ogg"  => "bi-file-earmark-music",
            ".mp4" or ".mkv" or ".avi"   => "bi-file-earmark-play",
            ".zip" or ".tar" or ".gz"    => "bi-file-earmark-zip",
            _                            => "bi-file-earmark"
        };

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024                => $"{bytes} B",
        < 1024 * 1024         => $"{bytes / 1024.0:F1} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _                     => $"{bytes / (1024.0 * 1024 * 1024):F1} GB"
    };

    private static string TruncatePath(string path)
    {
        const int max = 60;
        return path.Length <= max ? path : "…" + path[^(max - 1)..];
    }

    // ── Inner types ───────────────────────────────────────────────────────────

    private class FileSystemEntry
    {
        public string Name { get; set; } = "";
        public string FullPath { get; set; } = "";
        public bool IsDirectory { get; set; }
        public long Size { get; set; }
    }

    private class Breadcrumb
    {
        public string Label { get; set; } = "";
        public string Path { get; set; } = "";
    }
}
