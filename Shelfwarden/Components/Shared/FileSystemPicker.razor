@*
    FileSystemPicker.razor
    ----------------------
    Reusable Blazor Server component for browsing the server/container filesystem and
    picking a folder or file. Designed for use in Docker deployments where the host
    filesystem is mounted into the container.

    PARAMETERS:
        Mode              - PickerMode.Folder (default) or PickerMode.File
        AllowedExtensions - Optional file filter (file mode only), e.g. new[]{ ".epub", ".pdf" }. Null = all files.
        RootPath          - Starting root path. Defaults to "/" on Linux, or first drive root on Windows.
        Title             - Dialog title text.
        OnConfirm         - Callback with the selected path (string).
        OnCancel          - Callback when the dialog is dismissed.

    USAGE (folder picker):
        <FileSystemPicker
            Mode="FileSystemPicker.PickerMode.Folder"
            Title="Select a Shelf Folder"
            OnConfirm="HandleFolderSelected"
            OnCancel="HidePicker" />

    USAGE (file picker):
        <FileSystemPicker
            Mode="FileSystemPicker.PickerMode.File"
            AllowedExtensions='new[]{ ".epub", ".pdf", ".mobi" }'
            Title="Select an Ebook"
            OnConfirm="HandleFileSelected"
            OnCancel="HidePicker" />
*@

<div class="fsp-overlay" @onclick="HandleOverlayClick">
    <div class="fsp-dialog" @onclick:stopPropagation="true">

        <div class="fsp-header">
            <div class="fsp-header-left">
                <i class="bi @(Mode == PickerMode.File ? "bi-file-earmark-text" : "bi-folder2-open") fsp-icon"></i>
                <span class="fsp-title">@Title</span>
            </div>
            <button class="fsp-close" @onclick="Cancel" title="Cancel">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="fsp-breadcrumb">
            @for (int i = 0; i < _breadcrumbs.Count; i++)
            {
                var crumb = _breadcrumbs[i];
                var isLast = i == _breadcrumbs.Count - 1;
                if (isLast)
                {
                    <span class="fsp-crumb fsp-crumb--active">@crumb.Label</span>
                }
                else
                {
                    <button class="fsp-crumb fsp-crumb--link" @onclick="() => NavigateTo(crumb.Path)">@crumb.Label</button>
                    <span class="fsp-crumb-sep">›</span>
                }
            }
        </div>

        <div class="fsp-body">
            @if (_error != null)
            {
                <div class="fsp-error">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@_error
                </div>
            }
            else if (_entries.Count == 0)
            {
                <div class="fsp-empty">This folder is empty.</div>
            }
            else
            {
                <ul class="fsp-list">
                    @foreach (var entry in _entries)
                    {
                        var e = entry;
                        var isSelected = _selectedPath == e.FullPath;

                        <li class="fsp-item @(isSelected ? "fsp-item--selected" : "") @(e.IsDirectory ? "fsp-item--dir" : "fsp-item--file")"
                            @onclick="() => HandleEntryClick(e)"
                            @ondblclick="() => HandleEntryDoubleClick(e)">
                            <i class="bi @(e.IsDirectory ? "bi-folder-fill" : GetFileIcon(e.Name)) fsp-item-icon"></i>
                            <span class="fsp-item-name">@e.Name</span>
                            @if (!e.IsDirectory)
                            {
                                <span class="fsp-item-meta">@FormatSize(e.Size)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="fsp-footer">
            <div class="fsp-selection">
                @if (_selectedPath != null)
                {
                    <span class="fsp-selection-label">Selected:</span>
                    <span class="fsp-selection-path" title="@_selectedPath">@TruncatePath(_selectedPath)</span>
                }
                else if (Mode == PickerMode.Folder)
                {
                    <span class="fsp-selection-hint">Double-click a folder to open it, or click once to select it.</span>
                }
                else
                {
                    <span class="fsp-selection-hint">Click a file to select it, or double-click to select and confirm.</span>
                }
            </div>
            <div class="fsp-actions">
                @if (Mode == PickerMode.Folder)
                {
                <button class="btn btn-outline-secondary btn-sm"
                        disabled="@(_currentPath == WindowsVirtualRoot)"
                        @onclick="SelectCurrentFolder"
                        title="Use the currently browsed folder">
                    <i class="bi bi-folder-check me-1"></i>Use Current Folder
                </button>
                }
                <button class="btn btn-link btn-sm px-2" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary btn-sm"
                        disabled="@(_selectedPath == null)"
                        @onclick="Confirm">
                    <i class="bi bi-check-lg me-1"></i>Select
                </button>
            </div>
        </div>

    </div>
</div>
