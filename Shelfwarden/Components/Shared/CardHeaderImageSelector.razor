@using Microsoft.AspNetCore.Components.Forms
@inject ILogger<CardHeaderImageSelector> Logger

<div class="card-header-image-selector">
    <label class="form-label">Tile header image</label>
    <div class="btn-group-vertical btn-group-sm mb-3 d-flex flex-column align-items-stretch" role="group">
        <input type="radio" class="btn-check" name="@_groupName" id="@($"{_groupName}-rand")"
               checked="@(Mode == CardHeaderBannerMode.RandomCovers)"
               @onchange="@(() => SetMode(CardHeaderBannerMode.RandomCovers))" />
        <label class="btn btn-outline-secondary text-start" for="@($"{_groupName}-rand")">
            <i class="bi bi-shuffle me-1"></i> Random covers (up to @CardBannerLimits.MaxStripCovers from this list; refreshes each visit)
        </label>

        <input type="radio" class="btn-check" name="@_groupName" id="@($"{_groupName}-up")"
               checked="@(Mode == CardHeaderBannerMode.UploadedImage)"
               @onchange="@(() => SetMode(CardHeaderBannerMode.UploadedImage))" />
        <label class="btn btn-outline-secondary text-start" for="@($"{_groupName}-up")">
            <i class="bi bi-image me-1"></i> Upload an image
        </label>

        <input type="radio" class="btn-check" name="@_groupName" id="@($"{_groupName}-sel")"
               checked="@(Mode == CardHeaderBannerMode.SelectedBooks)"
               @onchange="@(() => SetMode(CardHeaderBannerMode.SelectedBooks))" />
        <label class="btn btn-outline-secondary text-start" for="@($"{_groupName}-sel")">
            <i class="bi bi-grid-3x2-gap me-1"></i> Choose up to @CardBannerLimits.MaxStripCovers books
        </label>
    </div>

    @if (Mode == CardHeaderBannerMode.UploadedImage)
    {
        <div class="mb-3">
            <InputFile OnChange="OnFileChosenAsync" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control form-control-sm" />
            <div class="form-text">JPG, PNG, GIF, or WebP. Max 2 MB.</div>
        </div>
    }

    @if (Mode == CardHeaderBannerMode.SelectedBooks)
    {
        <div class="mb-1">
            <div class="d-flex flex-wrap gap-1 mb-2">
                @if (SelectedBooks.Count == 0)
                {
                    <span class="text-secondary small fst-italic">No books selected yet.</span>
                }
                else
                {
                    @foreach (var b in SelectedBooks)
                    {
                        <span class="chip chip-tag">
                            <span>@b.Title</span>
                            <button type="button" class="btn-close btn-close-sm ms-1" aria-label="Remove"
                                    @onclick="@(() => RemoveBookAsync(b))"></button>
                        </span>
                    }
                }
            </div>
            <div class="position-relative">
                <input class="form-control form-control-sm" type="text"
                       placeholder="Search books in this list…"
                       value="@bookQuery"
                       @oninput="OnBookQueryInput"
                       @onfocus="@(() => showSuggestions = true)" />
                @if (showSuggestions && bookSuggestions.Count > 0)
                {
                    <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 220px; overflow-y: auto; z-index: 40;">
                        @foreach (var b in bookSuggestions)
                        {
                            <li>
                                <button type="button" class="dropdown-item" @onclick="@(() => AddBookAsync(b))">
                                    <span class="fw-semibold">@b.Title</span>
                                    @if (!string.IsNullOrEmpty(b.PrimaryAuthor))
                                    {
                                        <span class="text-secondary small"> — @b.PrimaryAuthor</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="form-text">Pick at most @CardBannerLimits.MaxStripCovers; order is left to right on the tile.</div>
        </div>
    }
</div>
