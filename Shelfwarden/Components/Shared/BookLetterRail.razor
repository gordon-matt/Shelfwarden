<div class="book-letter-rail" role="group" aria-label="Filter by first letter of title or sort title">
    @foreach (var filter in BookListLetterFilter.Options)
    {
        bool active = string.Equals(StartsWith ?? string.Empty, filter.Value, StringComparison.Ordinal);
        <button type="button"
                class="book-letter-btn @(active ? "active" : null) @(filter.Value.Length == 0 ? "book-letter-btn-all" : null)"
                title="@(string.IsNullOrEmpty(filter.Value) ? "Show all books" : $"Title or sort title: {filter.Label}")"
                @onclick="() => OnSelectAsync(filter.Value)">
            @filter.Label
        </button>
    }
</div>
