@if (AsButton)
{
    <button type="button"
            class="btn btn-sm btn-outline-secondary"
            title="Add to reading list"
            @onclick="OpenPicker"
            @onclick:stopPropagation="true"
            @onclick:preventDefault="true">
        <i class="bi bi-list-ol"></i>@if (!string.IsNullOrEmpty(ButtonLabel))
        {
            <span class="ms-1">@ButtonLabel</span>
        }
    </button>
}
else
{
    <li>
        <button type="button" class="dropdown-item"
                @onclick="OpenPicker"
                @onclick:stopPropagation="true"
                @onclick:preventDefault="true">
            <i class="bi bi-list-ol me-1"></i> Add to reading list…
        </button>
    </li>
}
