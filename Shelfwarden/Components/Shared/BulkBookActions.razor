@inject ICollectionService CollectionService
@inject IReadingListService ReadingListService
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (SelectedBookIds.Count > 0)
{
    <button type="button"
            class="btn btn-sm btn-outline-primary"
            disabled="@busy"
            title="Add selected books to a collection"
            @onclick="OpenCollectionModalAsync">
        <i class="bi bi-bookshelf"></i> Add to collection
    </button>
    <button type="button"
            class="btn btn-sm btn-outline-primary"
            disabled="@busy"
            title="Append selected books to a reading list"
            @onclick="OpenReadingListModalAsync">
        <i class="bi bi-list-ol"></i> Add to reading list
    </button>
}

@if (collectionModalOpen)
{
    <div class="modal modal-show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.35);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add to collection</h5>
                    <button type="button" class="btn-close" @onclick="CloseCollectionModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (collectionsLoadError is not null)
                    {
                        <div class="alert alert-danger mb-0">@collectionsLoadError</div>
                    }
                    else if (writableCollections.Count == 0)
                    {
                        <p class="text-secondary mb-0">No collections you can add to. Create one from the Collections page.</p>
                    }
                    else
                    {
                        <label class="form-label">Collection</label>
                        <select class="form-select" @bind="selectedCollectionId">
                            @foreach (var c in writableCollections)
                            {
                                <option value="@c.Id">@c.Name@(c.IsGlobal ? " (global)" : "")</option>
                            }
                        </select>
                        <p class="small text-secondary mt-2 mb-0">
                            Adds @SelectedBookIds.Count book@(SelectedBookIds.Count == 1 ? "" : "s") (skips any already in the collection).
                        </p>
                    }
                    @if (bulkActionError is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@bulkActionError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCollectionModal" disabled="@busy">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(busy || writableCollections.Count == 0)"
                            @onclick="ConfirmAddToCollectionAsync">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Add
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (readingListModalOpen)
{
    <div class="modal modal-show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.35);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add to reading list</h5>
                    <button type="button" class="btn-close" @onclick="CloseReadingListModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (readingListsLoadError is not null)
                    {
                        <div class="alert alert-danger mb-0">@readingListsLoadError</div>
                    }
                    else if (readingLists.Count == 0)
                    {
                        <p class="text-secondary mb-0">No reading lists yet. Create one from the Reading lists page.</p>
                    }
                    else
                    {
                        <label class="form-label">Reading list</label>
                        <select class="form-select" @bind="selectedReadingListId">
                            @foreach (var l in readingLists)
                            {
                                <option value="@l.Id">@l.Name</option>
                            }
                        </select>
                        <p class="small text-secondary mt-2 mb-0">
                            Appends @SelectedBookIds.Count book@(SelectedBookIds.Count == 1 ? "" : "s") to the end (skips duplicates).
                        </p>
                    }
                    @if (bulkActionError is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@bulkActionError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseReadingListModal" disabled="@busy">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(busy || readingLists.Count == 0)"
                            @onclick="ConfirmAddToReadingListAsync">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Add
                    </button>
                </div>
            </div>
        </div>
    </div>
}
