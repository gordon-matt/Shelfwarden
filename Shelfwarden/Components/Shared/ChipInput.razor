@*
    Generic "pick or create" multi-select used on the BookEdit form for Authors / Genres.
    The `Selected` parameter is a list of (Id, Name) pairs (mirrors AuthorDto / GenreDto).
    `OnAdd(name)` is called with the typed-in name when the user picks an existing suggestion
    or enters a new one — the parent resolves it (via *Service.GetOrCreateAsync) and pushes
    the new option back into Selected. Keeps this component dumb about the actual entity.
*@
@typeparam TItem where TItem : class

<div class="chip-input">
    <div class="chip-input-tags d-flex flex-wrap gap-1 mb-2">
        @if (Selected.Count == 0)
        {
            <span class="text-secondary small fst-italic">No @Label.ToLowerInvariant() yet.</span>
        }
        else
        {
            @foreach (var item in Selected)
            {
                <span class="chip @(ChipCssSuffix)">
                    <span>@NameOf(item)</span>
                    <button type="button" class="btn-close btn-close-sm ms-1"
                            aria-label="Remove" title="Remove"
                            @onclick="() => RemoveAsync(item)"></button>
                </span>
            }
        }
    </div>

    <div class="position-relative">
        <input class="form-control form-control-sm" type="text"
               placeholder="@($"Add {Label.ToLowerInvariant()}…")"
               @bind="input" @bind:event="oninput"
               @bind:after="OnInputChangedAsync"
               onkeydown="if(event.key==='Enter'){event.preventDefault();}"
               @onkeyup="OnKeyUpAsync"
               @onkeyup:stopPropagation="true"
               @onfocus="OnFocusAsync" />

        @if (showSuggestions && (suggestions.Count > 0 || !string.IsNullOrWhiteSpace(input)))
        {
            <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 220px; overflow-y: auto;">
                @foreach (var s in suggestions)
                {
                    <li>
                        <button type="button" class="dropdown-item" @onclick="() => CommitAsync(NameOf(s))">
                            @NameOf(s)
                        </button>
                    </li>
                }
                @if (AllowCreate && !string.IsNullOrWhiteSpace(input) && !suggestions.Any(s => string.Equals(NameOf(s), input.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item" @onclick="() => CommitAsync(input!.Trim())">
                            <i class="bi bi-plus-lg"></i> Create "<strong>@input.Trim()</strong>"
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</div>
