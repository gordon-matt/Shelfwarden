@* Three-dot menu — same Bootstrap dropdown pattern as BookCard / SeriesIndex. *@
<div class="extra-content-item-menu dropend @MenuClass">
    <button type="button"
            class="btn btn-sm extra-content-item-menu-toggle"
            data-bs-toggle="dropdown"
            data-bs-config='{"popperConfig":{"strategy":"fixed"}}'
            aria-expanded="false"
            aria-label="Content actions"
            @onclick:stopPropagation="true"
            @onclick:preventDefault="true">
        <i class="bi bi-three-dots-vertical"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @if (ShowView)
        {
            <li>
                <button type="button" class="dropdown-item"
                        @onclick="OnViewClick"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true">
                    <i class="bi bi-eye me-1"></i> View
                </button>
            </li>
        }
        @if (ShowOpenPdf)
        {
            <li>
                <a class="dropdown-item" href="extra-content/@Item.Id" target="_blank" rel="noopener"
                   @onclick:stopPropagation="true">
                    <i class="bi bi-filetype-pdf me-1"></i> Open PDF
                </a>
            </li>
        }
        <li>
            <button type="button" class="dropdown-item"
                    @onclick="DownloadAsync"
                    @onclick:stopPropagation="true"
                    @onclick:preventDefault="true">
                <i class="bi bi-download me-1"></i> Download
            </button>
        </li>
        @if (ShowAssign)
        {
            <li>
                <button type="button" class="dropdown-item"
                        @onclick="OnAssignClick"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true">
                    <i class="bi bi-person-plus me-1"></i> Assign to author
                </button>
            </li>
            <li>
                <button type="button" class="dropdown-item"
                        @onclick="OnTagsClick"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true">
                    <i class="bi bi-tags me-1"></i> Tags
                </button>
            </li>
        }
        else
        {
            <AuthorizeView Roles="@Constants.Roles.Administrator">
                <Authorized>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item"
                                @onclick="OnTagsClick"
                                @onclick:stopPropagation="true"
                                @onclick:preventDefault="true">
                            <i class="bi bi-tags me-1"></i> Tags
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item"
                                @onclick="OnRenameClick"
                                @onclick:stopPropagation="true"
                                @onclick:preventDefault="true">
                            <i class="bi bi-pencil me-1"></i> Rename
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item text-danger"
                                @onclick="OnDeleteClick"
                                @onclick:stopPropagation="true"
                                @onclick:preventDefault="true">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </li>
                </Authorized>
            </AuthorizeView>
        }
    </ul>
</div>
