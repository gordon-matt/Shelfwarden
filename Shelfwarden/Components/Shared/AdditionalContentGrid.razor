@inject IJSRuntime JS
@inject IAdditionalContentService ContentService

@if (Items is { Count: > 0 })
{
    <div class="additional-content-grid">
        <div class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <label class="form-label small text-body-secondary mb-1">Tag</label>
                <select class="form-select form-select-sm"
                        @bind="tagFilterId"
                        @bind:after="OnTagFilterChanged">
                    <option value="0">Any</option>
                    <option value="-1">None</option>
                    @foreach (var tag in tagFilterOptions)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </div>
        </div>

        @if (filteredItems.Count == 0)
        {
            <div class="text-secondary small fst-italic py-2">No items match the selected tag filter.</div>
        }

        @if (ShowTabs)
        {
            <ul class="nav nav-tabs mb-3 additional-content-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button type="button"
                            class="nav-link @(activeTab == "images" ? "active" : null)"
                            id="additional-content-tab-images"
                            role="tab"
                            aria-selected="@(activeTab == "images" ? "true" : "false")"
                            @onclick='() => ActivateTab("images")'>
                        Images
                        <span class="badge text-bg-secondary ms-1">@imageItems.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button"
                            class="nav-link @(activeTab == "other" ? "active" : null)"
                            id="additional-content-tab-other"
                            role="tab"
                            aria-selected="@(activeTab == "other" ? "true" : "false")"
                            @onclick='() => ActivateTab("other")'>
                        Other
                        <span class="badge text-bg-secondary ms-1">@otherItems.Count</span>
                    </button>
                </li>
            </ul>
        }

        @if (ShowImageGallery)
        {
            @* CSS multi-column gallery — avoids Blazor Server / JS Masonry init races (single-column stack). *@
            <div @key="ImagesMasonryKey" class="additional-content-image-columns">
                @foreach (var item in imageItems)
                {
                    <div class="content-masonry-column-item">
                        <figure class="content-masonry-card">
                            <div class="content-masonry-thumb-wrap">
                                <button type="button"
                                        class="content-masonry-thumb-btn"
                                        title="View @item.FileName"
                                        @onclick="() => OpenViewer(item)">
                                    <img src="extra-content/@item.Id"
                                         class="content-masonry-img"
                                         alt=""
                                         loading="lazy"
                                         decoding="async" />
                                </button>
                                <ExtraContentItemContextMenu Item="item"
                                                             OnView="() => OpenViewer(item)"
                                                             OnTags="() => OpenTagsModal(item)"
                                                             OnRename="() => OpenRename(item)"
                                                             OnDelete="() => ConfirmDeleteAsync(item)" />
                            </div>
                            <figcaption class="content-masonry-footer">
                                <div class="content-masonry-title text-truncate small fw-medium" title="@item.FileName">@item.FileName</div>
                                <div class="content-masonry-meta text-secondary small">
                                    @item.FileExtension.TrimStart('.').ToUpperInvariant()
                                    · @FormatBytes(item.FileSizeBytes)
                                    @if (item.Books.Count > 0)
                                    {
                                        <span> · @item.Books.Count book@(item.Books.Count == 1 ? "" : "s")</span>
                                    }
                                    @if (item.Series.Count > 0)
                                    {
                                        <span> · @item.Series.Count series</span>
                                    }
                                </div>
                                @if (item.Tags.Count > 0)
                                {
                                    <div class="content-masonry-tags d-flex flex-wrap gap-1 mt-1">
                                        @foreach (var tag in item.Tags)
                                        {
                                            <span class="badge rounded-pill text-bg-light border">@tag.Name</span>
                                        }
                                    </div>
                                }
                            </figcaption>
                        </figure>
                    </div>
                }
            </div>
        }

        @if (ShowOtherList)
        {
            @foreach (var item in otherItems)
            {
                <div class="content-item-card">
                    <div class="content-item-icon">
                        <i class="bi @GetFileIcon(item.FileExtension)"></i>
                    </div>
                    <div class="content-item-body">
                        <div class="content-item-name text-truncate" title="@item.FileName">@item.FileName</div>
                        <div class="content-item-meta text-secondary small">
                            @item.FileExtension.TrimStart('.').ToUpperInvariant()
                            · @FormatBytes(item.FileSizeBytes)
                            @if (item.Books.Count > 0)
                            {
                                <span> · @item.Books.Count book@(item.Books.Count == 1 ? "" : "s")</span>
                            }
                            @if (item.Series.Count > 0)
                            {
                                <span> · @item.Series.Count series</span>
                            }
                        </div>
                        @if (item.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="badge rounded-pill text-bg-light border small">@tag.Name</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="content-item-actions">
                        @if (IsViewable(item.FileExtension))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="View" @onclick="() => OpenViewer(item)">
                                <i class="bi bi-eye"></i>
                            </button>
                        }
                        else if (IsPdf(item.FileExtension))
                        {
                            <a class="btn btn-sm btn-outline-secondary"
                               href="extra-content/@item.Id" target="_blank" rel="noopener"
                               title="Open PDF">
                                <i class="bi bi-filetype-pdf"></i>
                            </a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                title="Download" @onclick="() => DownloadItem(item.Id)">
                            <i class="bi bi-download"></i>
                        </button>
                        <AuthorizeView Roles="@Constants.Roles.Administrator">
                            <Authorized>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        title="Tags" @onclick="() => OpenTagsModal(item)">
                                    <i class="bi bi-tags"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        title="Rename" @onclick="() => OpenRename(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Delete" @onclick="() => ConfirmDeleteAsync(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            }
        }
    </div>
}
else if (ShowEmptyState)
{
    <div class="text-secondary small fst-italic py-2">No extra content associated.</div>
}

<EditExtraContentTagsModal IsOpen="tagsModalOpen"
                          Title="@tagsModalTitle"
                          ItemIds="tagsModalItemIds"
                          InitialTagNames="tagsModalInitialNames"
                          AuthorIdForTagSuggestions="TagScopeAuthorId"
                          OnClose="CloseTagsModal"
                          OnSaved="OnTagsSavedAsync" />

@* Content viewer modal (text / images) *@
@if (viewerItem is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-truncate">@viewerItem.FileName</h5>
                    <button type="button" class="btn-close" @onclick="CloseViewer" aria-label="Close"></button>
                </div>
                <div class="modal-body content-viewer-body">
                    @if (viewerLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status"></div>
                        </div>
                    }
                    else if (IsImage(viewerItem.FileExtension))
                    {
                        <img src="extra-content/@viewerItem.Id" alt="@viewerItem.FileName" class="img-fluid mx-auto d-block" />
                    }
                    else if (IsVideo(viewerItem.FileExtension))
                    {
                        <video controls preload="metadata" class="w-100 content-viewer-video">
                            <source src="extra-content/@viewerItem.Id" type="@GetVideoMimeType(viewerItem.FileExtension)" />
                        </video>
                    }
                    else if (viewerCsvRows is { Length: > 0 })
                    {
                        <div class="content-viewer-table-wrap">
                            <table class="table table-sm table-striped table-bordered content-viewer-table mb-0">
                                <thead>
                                    <tr>
                                        @foreach (var cell in viewerCsvRows[0])
                                        {
                                            <th scope="col">@cell</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in viewerCsvRows.Skip(1))
                                    {
                                        <tr>
                                            @foreach (var cell in row)
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (viewerContent is not null)
                    {
                        @if (IsHtml(viewerItem.FileExtension))
                        {
                            <div class="content-viewer-html">@((MarkupString)viewerContent)</div>
                        }
                        else
                        {
                            <pre class="content-viewer-text">@viewerContent</pre>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="() => DownloadItem(viewerItem.Id)">
                        <i class="bi bi-download"></i> Download
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseViewer">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* Rename modal *@
@if (renameItem is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rename</h5>
                    <button type="button" class="btn-close" @onclick="CloseRename" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (renameError is not null)
                    {
                        <div class="alert alert-danger py-2">@renameError</div>
                    }
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="renameName" maxlength="512" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseRename">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveRenameAsync" disabled="@renameSaving">
                        @if (renameSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
