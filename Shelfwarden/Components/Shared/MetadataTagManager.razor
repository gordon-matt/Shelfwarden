<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-8">
        <label class="form-label small text-body-secondary mb-1">Search @EntityPlural</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="@($"Search {EntityPlural}...")" @bind="tagQuery" @bind:event="oninput" @onkeyup="OnTagQueryKeyUp" />
        </div>
    </div>
    <div class="col-md-4 d-flex justify-content-md-end gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="ClearTagSelection" disabled="@(selectedTagIds.Count == 0)">
            <i class="bi bi-x-circle"></i> Clear
        </button>
        <button type="button" class="btn btn-outline-primary" @onclick="OpenTagCreateAsync">
            <i class="bi bi-plus-circle"></i> Add @EntitySingular
        </button>
    </div>
</div>

<div class="selection-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
    <span class="text-secondary small">
        <i class="bi bi-check2-square"></i> @selectedTagIds.Count selected
    </span>
    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(selectedTagIds.Count < 2)" @onclick="OpenTagMergeModal">
        <i class="bi bi-intersect"></i> Merge selected
    </button>
    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(selectedTagIds.Count == 0)" @onclick="DeleteSelectedTagsAsync">
        <i class="bi bi-trash"></i> Delete selected
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RemoveUnusedTagsAsync">
        <i class="bi bi-eraser"></i> Remove unused
    </button>
</div>

@if (tags is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading @EntityPlural…</div>
    </div>
}
else if (tags.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-hash empty-icon"></i>
        <h3>No @EntityPlural found</h3>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 1%;"></th>
                        <th>Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in tags)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@selectedTagIds.Contains(t.Id)"
                                       @onchange="e => ToggleTagSelection(t.Id, (bool)(e.Value ?? false))" />
                            </td>
                            <td>
                                @if (Kind == MetadataTagManager.TagKind.Book)
                                {
                                    <a href="@($"books?tagId={t.Id}")">@t.Name</a>
                                }
                                else
                                {
                                    @t.Name
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => OpenTagRenameAsync(t))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteTagAsync(t))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (tagMergeModalOpen && tagMergeCandidates.Count > 0)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);" @onclick="CloseTagMergeModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Merge @EntityPlural</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseTagMergeModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-3">
                        Choose the @EntitySingular to keep. The other selected @EntityPlural will be merged into it and deleted.
                    </p>
                    @foreach (var c in tagMergeCandidates)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="@MergeRadioName"
                                   id="@($"merge-primary-tag-{Kind}-{c.Id}")"
                                   checked="@(tagMergeTargetId == c.Id)"
                                   @onchange="@(() => tagMergeTargetId = c.Id)" />
                            <label class="form-check-label" for="@($"merge-primary-tag-{Kind}-{c.Id}")">@c.Name</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseTagMergeModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmTagMergeAsync">Merge</button>
                </div>
            </div>
        </div>
    </div>
}
