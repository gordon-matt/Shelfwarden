@inject IBookMetadataService BookMetadataService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fetch metadata online</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <p class="text-body-secondary small">
                        Search Google Books and Open Library, then pick a match to fill in the form.
                        Nothing is saved until you hit <strong>Save</strong> on the book.
                    </p>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Title</label>
                            <input class="form-control" @bind="searchTitle" @bind:event="oninput" @onkeydown="OnKeyDown" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Author</label>
                            <input class="form-control" @bind="searchAuthor" @bind:event="oninput" @onkeydown="OnKeyDown" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small mb-1">ISBN</label>
                            <input class="form-control" @bind="searchIsbn" @bind:event="oninput" @onkeydown="OnKeyDown" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" class="btn btn-primary w-100" @onclick="SearchAsync" disabled="@isSearching">
                                @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger py-2">@errorMessage</div>
                    }

                    @if (isSearching)
                    {
                        <div class="text-center text-secondary py-4">
                            <div class="spinner-border" role="status"></div>
                            <div class="mt-2 small">Searching online sources…</div>
                        </div>
                    }
                    else if (hasSearched && results.Count == 0 && string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-secondary py-2 mb-0">No matches were found. Try a different title, author, or ISBN.</div>
                    }
                    else if (results.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2">
                            @for (int i = 0; i < results.Count; i++)
                            {
                                int idx = i;
                                var match = results[idx];
                                bool isSelected = selectedIndex == idx;
                                <div role="button" tabindex="0"
                                     class="border rounded p-2 metadata-candidate @(isSelected ? "border-primary bg-primary-subtle" : "border-secondary-subtle")"
                                     @onclick="() => selectedIndex = idx">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="metadata-candidate-cover flex-shrink-0">
                                            @if (!string.IsNullOrWhiteSpace(match.CoverUrl))
                                            {
                                                <img src="@match.CoverUrl" alt="Cover for @match.Title"
                                                     loading="lazy" referrerpolicy="no-referrer"
                                                     onerror="this.classList.add('d-none');this.parentElement.classList.add('no-cover')" />
                                                <i class="bi bi-book placeholder-icon"></i>
                                            }
                                            else
                                            {
                                                <div class="no-cover w-100 h-100 d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-book placeholder-icon"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">
                                                @match.Title
                                                @if (!string.IsNullOrWhiteSpace(match.Subtitle))
                                                {
                                                    <span class="fw-normal opacity-75">: @match.Subtitle</span>
                                                }
                                            </div>
                                            <div class="small opacity-75">
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@match.Provider</span>
                                                @if (match.Authors.Count > 0)
                                                {
                                                    <span> · @string.Join(", ", match.Authors)</span>
                                                }
                                                @if (match.PublishedOn is { } d)
                                                {
                                                    <span> · @d.Year</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(match.Publisher))
                                                {
                                                    <span> · @match.Publisher</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(match.Isbn))
                                                {
                                                    <span> · ISBN @match.Isbn</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(match.Description))
                                            {
                                                <div class="small mt-1 text-body-secondary">@Preview(match.Description)</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(match.CoverUrl))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                                        @onclick="() => UseCoverOnlyAsync(match)"
                                                        @onclick:stopPropagation="true">
                                                    <i class="bi bi-image me-1"></i> Use this cover only
                                                </button>
                                            }
                                        </div>
                                        <span class="badge align-self-start @(isSelected ? "bg-primary-subtle text-primary-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                            @(isSelected ? "Selected" : "Select")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@(selectedIndex < 0)" @onclick="ApplySelectedAsync">
                        <i class="bi bi-check-lg me-1"></i> Use this metadata
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
