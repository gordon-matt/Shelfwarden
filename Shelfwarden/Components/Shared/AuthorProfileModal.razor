@inject IAuthorService AuthorService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Author</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link @(activeTab == ModalTab.Manual ? "active" : null)"
                                    @onclick="() => SetTabAsync(ModalTab.Manual)">
                                Manual Edit
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link @(activeTab == ModalTab.Match ? "active" : null)"
                                    @onclick="() => SetTabAsync(ModalTab.Match)">
                                Match
                            </button>
                        </li>
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert alert-info py-2">@statusMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger py-2">@errorMessage</div>
                    }

                    @if (activeTab == ModalTab.Manual)
                    {
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" @bind="manualName" @bind:event="oninput" maxlength="256" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Biography</label>
                            <textarea class="form-control" rows="8" @bind="manualBiography"></textarea>
                        </div>
                        <div>
                            <label class="form-label">Photo</label>
                            <InputFile OnChange="OnPhotoSelectedAsync" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,image/*" />
                            @if (!string.IsNullOrWhiteSpace(selectedPhotoName))
                            {
                                <div class="small text-body-secondary mt-1">Selected: @selectedPhotoName</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label">Source</label>
                                <select class="form-select" value="@selectedProvider" @onchange="OnProviderChangedAsync">
                                    <option value="">All sources</option>
                                    @foreach (var p in providers)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label">Author name</label>
                                <div class="input-group">
                                    <input class="form-control" @bind="authorMatchQuery" @bind:event="oninput"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SearchProviderAsync(); })" />
                                    <button type="button" class="btn btn-primary" @onclick="SearchProviderAsync" disabled="@isSearching">
                                        @if (isSearching)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (providerMatches.Count == 0 && hasSearched && !isSearching && string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-secondary py-2 mb-0">No author matches were found.</div>
                        }
                        else if (providerMatches.Count > 0)
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var match in providerMatches)
                                {
                                    bool isSelected = pendingMatchSelection is not null
                                        && pendingMatchSelection.Provider == match.Provider
                                        && pendingMatchSelection.ProviderId == match.ProviderId;
                                    <button type="button"
                                            class="btn text-start border @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick="() => SelectMatch(match)">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="d-flex align-items-start gap-2">
                                                @if (!string.IsNullOrWhiteSpace(match.PhotoUrl))
                                                {
                                                    <div class="author-match-photo flex-shrink-0">
                                                        <img src="@match.PhotoUrl" alt="Photo of @match.Name"
                                                             loading="lazy" referrerpolicy="no-referrer"
                                                             onerror="this.classList.add('d-none');this.parentElement.classList.add('no-photo')" />
                                                        <i class="bi bi-person placeholder-icon"></i>
                                                    </div>
                                                }
                                                <div>
                                                <div class="fw-semibold">
                                                    @match.Name
                                                    <span class="badge bg-info-subtle text-info-emphasis ms-1">@match.Provider</span>
                                                </div>
                                                <div class="small opacity-75">
                                                    @if (!string.IsNullOrWhiteSpace(match.BirthDate) || !string.IsNullOrWhiteSpace(match.DeathDate))
                                                    {
                                                        <span>@match.BirthDate-@match.DeathDate · </span>
                                                    }
                                                    <span>Bio: @(match.HasBio ? "yes" : "no")</span>
                                                    <span> · Photo: @(match.HasPhoto ? "yes" : "no")</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(match.TopBooks))
                                                {
                                                    <div class="small mt-1 fst-italic opacity-75">@match.TopBooks</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(match.BioPreview))
                                                {
                                                    <div class="small mt-1">@match.BioPreview</div>
                                                }
                                                </div>
                                            </div>
                                            <span class="badge @(isSelected ? "bg-primary-subtle text-primary-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                                @(isSelected ? "Selected" : "Select")
                                            </span>
                                        </div>
                                    </button>
                                }
                            </div>
                        }

                        @if (isAwaitingImportConfirmation && pendingMatchSelection is not null)
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                <div class="fw-semibold mb-1">Are you sure?</div>
                                <div class="small">This will import biography/photo for <strong>@AuthorName</strong> from the <strong>@pendingMatchSelection.Provider</strong> match <strong>@pendingMatchSelection.Name</strong>.</div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync">Close</button>
                    @if (activeTab == ModalTab.Manual)
                    {
                        <button type="button" class="btn btn-primary" @onclick="SaveManualAsync" disabled="@isSavingManual">
                            @if (isSavingManual)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save
                        </button>
                    }
                    else if (!isAwaitingImportConfirmation)
                    {
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@(pendingMatchSelection is null)"
                                @onclick="StartImportConfirmation">
                            Continue
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelImportConfirmation">Back</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmImportAsync" disabled="@isImporting">
                            @if (isImporting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Yes, import
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
