@implements IAsyncDisposable
@inject IJSRuntime JS

@* Per-browser theme in localStorage — modal only; opener is <ThemePickerOpener /> in the topbar. *@
<div class="modal fade" id="themePickerModal" tabindex="-1" aria-labelledby="themePickerModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="themePickerModalLabel">Bootswatch theme</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-body-secondary mb-2">
                    Your choice is saved in this browser only. Preview with a click; save with
                    <strong>OK</strong>, or <strong>Cancel</strong> / close to restore the previous theme.
                </p>
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" role="tab" aria-selected="@(_showDarkTab ? "true" : "false")"
                                class="nav-link @(_showDarkTab ? "active" : null)"
                                @onclick="() => _showDarkTab = true">
                            Dark
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" role="tab" aria-selected="@(_showDarkTab ? "false" : "true")"
                                class="nav-link @(_showDarkTab ? null : "active")"
                                @onclick="() => _showDarkTab = false">
                            Light
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-3">
                    <div class="list-group theme-picker-theme-list" role="tabpanel">
                        @foreach (string t in _showDarkTab
                            ? Constants.BootswatchThemes.DarkThemes
                            : Constants.BootswatchThemes.LightThemes)
                        {
                            bool isPreview = string.Equals(t, _previewTheme, StringComparison.OrdinalIgnoreCase);
                            bool isSaved = string.Equals(t, _committedTheme, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2 @(isPreview ? "active" : null)"
                                    @onclick="() => PreviewThemeAsync(t)">
                                <span>@TitleCase(t)</span>
                                @if (isSaved)
                                {
                                    <span class="badge rounded-pill ms-2">Saved</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="OkAsync">OK</button>
            </div>
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<ThemePicker>? _dotNetRef;

    /// <summary>Last theme persisted to localStorage (last OK).</summary>
    private string _committedTheme = Constants.ServerSettingDefaults.Theme;

    /// <summary>Theme currently applied in the browser (may differ while the modal is open).</summary>
    private string _previewTheme = Constants.ServerSettingDefaults.Theme;

    private bool _closedWithOk;

    /// <summary>Which of the two tabs is showing. Follows the applied theme's color scheme.</summary>
    private bool _showDarkTab = Constants.BootswatchThemes.IsDarkColorScheme(Constants.ServerSettingDefaults.Theme);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("shelfwarden.registerThemeModalDismiss", "themePickerModal", _dotNetRef);

            var raw = await JS.InvokeAsync<string>("shelfwarden.getStoredTheme");
            if (TryNormalizeTheme(raw, out var stored))
            {
                _committedTheme = stored;
                _previewTheme = stored;
                await ApplyThemeToDomAsync(stored);
            }

            StateHasChanged();
        }
    }

    private async Task PreviewThemeAsync(string theme)
    {
        if (string.Equals(theme, _previewTheme, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await ApplyThemeToDomAsync(theme);
        StateHasChanged();
    }

    private async Task OkAsync()
    {
        await JS.InvokeVoidAsync("shelfwarden.setStoredTheme", _previewTheme);
        _committedTheme = _previewTheme;
        _closedWithOk = true;
        await JS.InvokeVoidAsync("shelfwarden.hideModal", "themePickerModal");
    }

    private async Task CancelAsync()
    {
        await ApplyThemeToDomAsync(_committedTheme);
        await JS.InvokeVoidAsync("shelfwarden.hideModal", "themePickerModal");
    }

    private async Task ApplyThemeToDomAsync(string theme)
    {
        bool isDark = Constants.BootswatchThemes.IsDarkColorScheme(theme);
        await JS.InvokeVoidAsync(
            "shelfwarden.setThemeHref",
            $"lib/bootswatch/dist/{theme}/bootstrap.min.css",
            isDark ? "dark" : "light");
        _previewTheme = theme;
        _showDarkTab = isDark;
    }

    [JSInvokable]
    public async Task OnThemeModalDismissed()
    {
        if (_closedWithOk)
        {
            _closedWithOk = false;
            return;
        }

        if (!string.Equals(_previewTheme, _committedTheme, StringComparison.OrdinalIgnoreCase))
        {
            await ApplyThemeToDomAsync(_committedTheme);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is not null)
        {
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private static bool TryNormalizeTheme(string? raw, out string normalized)
    {
        normalized = Constants.ServerSettingDefaults.Theme;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        var t = raw.Trim().ToLowerInvariant();
        if (!Constants.BootswatchThemes.All.Contains(t, StringComparer.Ordinal))
        {
            return false;
        }

        normalized = t;
        return true;
    }

    private static string TitleCase(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];
}
