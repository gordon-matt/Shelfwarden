@inject IServerSettingsService ServerSettings
@inject IJSRuntime JS

@* Theme is a server-wide setting so only admins can change it. *@
<AuthorizeView Roles="@Constants.Roles.Administrator">
    <Authorized>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false" title="Theme">
                <i class="bi bi-palette"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Bootswatch theme</h6></li>
                @foreach (string t in Constants.BootswatchThemes.All)
                {
                    <li>
                        <button type="button"
                                class="dropdown-item @(string.Equals(t, current, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                @onclick="() => SelectAsync(t)">
                            @TitleCase(t)
                            @if (string.Equals(t, current, StringComparison.OrdinalIgnoreCase))
                            {
                                <i class="bi bi-check2 ms-2"></i>
                            }
                        </button>
                    </li>
                }
            </ul>
        </li>
    </Authorized>
</AuthorizeView>

@code {
    private string current = Constants.ServerSettingDefaults.Theme;

    protected override async Task OnInitializedAsync()
    {
        var result = await ServerSettings.GetAsync();
        if (result.IsSuccess)
        {
            current = result.Value.Theme;
        }
    }

    private async Task SelectAsync(string theme)
    {
        if (string.Equals(theme, current, StringComparison.OrdinalIgnoreCase)) return;

        var result = await ServerSettings.SetThemeAsync(theme);
        if (!result.IsSuccess) return;

        current = theme;
        // Swap the stylesheet href in-place so the change is instant — no full reload.
        await JS.InvokeVoidAsync("shelfwarden.setThemeHref", $"lib/bootswatch/dist/{theme}/bootstrap.min.css");
    }

    private static string TitleCase(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];
}
