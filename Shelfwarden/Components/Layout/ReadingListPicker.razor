@* Wrap children so CascadingValue(this) is available before they render. *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@* Modal host — openers are <AddToReadingListAction /> on book/series tiles. *@
@if (IsOpen)
{
    <div class="modal modal-show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.35); z-index: 1060;"
         @onclick="Close">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add to reading list</h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (busy && readingLists.Count == 0 && loadError is null)
                    {
                        <div class="text-center text-secondary py-3">
                            <span class="spinner-border spinner-border-sm me-1"></span> Loading…
                        </div>
                    }
                    else if (loadError is not null)
                    {
                        <div class="alert alert-danger mb-0">@loadError</div>
                    }
                    else if (readingLists.Count == 0)
                    {
                        <p class="text-secondary mb-0">No reading lists yet. Create one from the Reading lists page.</p>
                    }
                    else
                    {
                        <label class="form-label">Reading list</label>
                        <select class="form-select" @bind="selectedReadingListId">
                            @foreach (var l in readingLists)
                            {
                                <option value="@l.Id">@l.Name</option>
                            }
                        </select>
                        <p class="small text-secondary mt-2 mb-0">@ModalSubtitle</p>
                    }
                    @if (actionError is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@actionError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close" disabled="@busy">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(busy || readingLists.Count == 0)"
                            @onclick="ConfirmAsync">
                        @if (busy && readingLists.Count > 0)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Add
                    </button>
                </div>
            </div>
        </div>
    </div>
}
