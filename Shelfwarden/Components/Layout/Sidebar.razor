@inject IAuthProviderService AuthProvider
@inject ILibraryService LibraryService
@inject ICollectionService CollectionService
@inject IReadingListService ReadingListService

<aside class="app-sidebar @(Open ? "open" : "")" id="appSidebar">
    <a class="app-sidebar-brand" href="/" @onclick="CloseOnNavigate">
        <i class="bi bi-bookshelf"></i>
        <span>Shelfwarden</span>
    </a>

    <div class="app-sidebar-section">
        <div class="app-sidebar-section-title">Browse</div>
        <ul class="app-sidebar-nav">
            <li>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseOnNavigate">
                    <i class="bi bi-house-door"></i> Home
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="books" @onclick="CloseOnNavigate">
                    <i class="bi bi-book"></i> All books
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="libraries" @onclick="CloseOnNavigate">
                    <i class="bi bi-collection"></i> Libraries
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="authors" @onclick="CloseOnNavigate">
                    <i class="bi bi-person-lines-fill"></i> Authors
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="series" @onclick="CloseOnNavigate">
                    <i class="bi bi-collection-fill"></i> Series
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="collections" @onclick="CloseOnNavigate">
                    <i class="bi bi-bookshelf"></i>
                    <span>Collections</span>
                    @if (collections is { Count: > 0 })
                    {
                        <span class="badge text-bg-secondary ms-auto">@collections.Count</span>
                    }
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="reading-lists" @onclick="CloseOnNavigate">
                    <i class="bi bi-list-ol"></i>
                    <span>Reading lists</span>
                    @if (readingLists is { Count: > 0 })
                    {
                        <span class="badge text-bg-secondary ms-auto">@readingLists.Count</span>
                    }
                </NavLink>
            </li>
        </ul>
    </div>

    @if (readingLists is { Count: > 0 })
    {
        <div class="app-sidebar-section">
            <div class="app-sidebar-section-title">Reading next</div>
            <ul class="app-sidebar-nav">
                @foreach (var l in readingLists.Take(5))
                {
                    <li>
                        <NavLink class="nav-link" href="@($"reading-lists/{l.Id}")" @onclick="CloseOnNavigate">
                            <i class="bi bi-list-ol"></i>
                            <span class="text-truncate">@l.Name</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    @if (libraries is { Count: > 0 })
    {
        <div class="app-sidebar-section">
            <div class="app-sidebar-section-title">Your libraries</div>
            <ul class="app-sidebar-nav">
                @foreach (var lib in libraries)
                {
                    <li>
                        <NavLink class="nav-link" href="@($"libraries/{lib.Id}")" @onclick="CloseOnNavigate">
                            <i class="bi bi-folder2-open"></i>
                            <span class="text-truncate">@lib.Name</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    <AuthorizeView Roles="@Constants.Roles.Administrator">
        <Authorized>
            <div class="app-sidebar-section">
                <div class="app-sidebar-section-title">Admin</div>
                <ul class="app-sidebar-nav">
                    <li>
                        <NavLink class="nav-link" href="users" @onclick="CloseOnNavigate">
                            <i class="bi bi-people"></i> Users
                        </NavLink>
                    </li>
                </ul>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="app-sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-5 text-secondary"></i>
                    <div class="flex-grow-1 text-truncate">
                        <div class="text-truncate small fw-semibold">@context.User.Identity?.Name</div>
                        @if (AuthProvider.Provider != Shelfwarden.Services.AuthProvider.None)
                        {
                            <a class="small text-decoration-none" href="@LogoutUrl">Sign out</a>
                        }
                        else
                        {
                            <span class="small text-secondary">Local user</span>
                        }
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-primary w-100" href="@LoginUrl">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnRequestClose { get; set; }

    private List<LibraryDto>? libraries;
    private IReadOnlyList<CollectionDto>? collections;
    private IReadOnlyList<ReadingListDto>? readingLists;

    protected override async Task OnInitializedAsync()
    {
        // Best-effort: if the user isn't signed in (and these endpoints require auth) we just
        // leave the sections empty rather than blowing up the whole layout.
        try
        {
            var libsTask = LibraryService.GetAllAsync();
            var collectionsTask = CollectionService.ListAsync();
            var listsTask = ReadingListService.ListAsync();
            await Task.WhenAll(libsTask, collectionsTask, listsTask);

            if (libsTask.Result.IsSuccess) libraries = libsTask.Result.Value.ToList();
            if (collectionsTask.Result.IsSuccess) collections = collectionsTask.Result.Value;
            if (listsTask.Result.IsSuccess) readingLists = listsTask.Result.Value;
        }
        catch
        {
            // Anonymous browsing — leave the sidebar minimal.
        }
    }

    private async Task CloseOnNavigate()
    {
        if (Open && OnRequestClose.HasDelegate)
        {
            await OnRequestClose.InvokeAsync();
        }
    }

    private string LoginUrl => AuthProvider.Provider switch
    {
        Shelfwarden.Services.AuthProvider.Identity => "Identity/Account/Login",
        Shelfwarden.Services.AuthProvider.Keycloak => "auth/login",
        _ => "/",
    };

    private string LogoutUrl => AuthProvider.Provider switch
    {
        Shelfwarden.Services.AuthProvider.Identity => "Identity/Account/Logout",
        Shelfwarden.Services.AuthProvider.Keycloak => "auth/logout",
        _ => "/",
    };
}
