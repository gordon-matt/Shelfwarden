@implements IDisposable
@inject IAuthProviderService AuthProvider
@inject IShelfService ShelfService
@inject ICollectionService CollectionService
@inject IReadingListService ReadingListService
@inject ISidebarNavRefreshService SidebarNavRefresh

<aside class="app-sidebar @(Open ? "open" : "")" id="appSidebar">
    <a class="app-sidebar-brand" href="/" @onclick="CloseOnNavigate">
        <img class="app-sidebar-brand-logo app-sidebar-brand-logo-light" src="@Assets["img/Logo.png"]"
             alt="Shelfwarden" />
        <img class="app-sidebar-brand-logo app-sidebar-brand-logo-dark" src="@Assets["img/Logo_Light.png"]"
             alt="Shelfwarden" />
    </a>

    <div class="app-sidebar-section">
        <div class="app-sidebar-section-title">Browse</div>
        <ul class="app-sidebar-nav">
            <li>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseOnNavigate">
                    <i class="bi bi-house-door"></i> Home
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="books" @onclick="CloseOnNavigate">
                    <i class="bi bi-book"></i> All books
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="shelves" @onclick="CloseOnNavigate">
                    <i class="bi bi-collection"></i> Shelves
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="authors" @onclick="CloseOnNavigate">
                    <i class="bi bi-person-lines-fill"></i> Authors
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="series" @onclick="CloseOnNavigate">
                    <i class="bi bi-collection-fill"></i> Series
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="collections" @onclick="CloseOnNavigate">
                    <i class="bi bi-bookshelf"></i>
                    <span>Collections</span>
                    @if (collections is { Count: > 0 })
                    {
                        <span class="badge text-bg-secondary ms-auto">@collections.Count</span>
                    }
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="reading-lists" @onclick="CloseOnNavigate">
                    <i class="bi bi-list-ol"></i>
                    <span>Reading lists</span>
                    @if (readingLists is { Count: > 0 })
                    {
                        <span class="badge text-bg-secondary ms-auto">@readingLists.Count</span>
                    }
                </NavLink>
            </li>
        </ul>
    </div>

    @if (readingLists is { Count: > 0 })
    {
        <div class="app-sidebar-section">
            <div class="app-sidebar-section-title">Reading next</div>
            <ul class="app-sidebar-nav">
                @foreach (var l in readingLists.Take(5))
                {
                    <li>
                        <NavLink class="nav-link" href="@($"reading-lists/{l.Id}")" @onclick="CloseOnNavigate">
                            <i class="bi bi-list-ol"></i>
                            <span class="text-truncate">@l.Name</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    @if (shelves is { Count: > 0 })
    {
        <div class="app-sidebar-section">
            <div class="app-sidebar-section-title">Your shelves</div>
            <ul class="app-sidebar-nav">
                @foreach (var lib in shelves)
                {
                    <li>
                        <NavLink class="nav-link" href="@($"shelves/{lib.Id}")" @onclick="CloseOnNavigate">
                            <i class="bi bi-folder2-open"></i>
                            <span class="text-truncate">@lib.Name</span>
                        </NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    <AuthorizeView Roles="@Constants.Roles.Administrator">
        <Authorized>
            <div class="app-sidebar-section">
                <div class="app-sidebar-section-title">Admin</div>
                <ul class="app-sidebar-nav">
                    <li>
                        <NavLink class="nav-link" href="users" @onclick="CloseOnNavigate">
                            <i class="bi bi-people"></i> Users
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-link" href="metadata" @onclick="CloseOnNavigate">
                            <i class="bi bi-tags"></i> Metadata
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-link" href="extra-content" @onclick="CloseOnNavigate">
                            <i class="bi bi-folder-plus"></i> Extra Content
                        </NavLink>
                    </li>
                    <li>
                        <a class="nav-link" href="/hangfire" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-speedometer2"></i> Hangfire
                        </a>
                    </li>
                    <li>
                        <a class="nav-link" href="/sejil" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-journal-text"></i> Logging
                        </a>
                    </li>
                </ul>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="app-sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-5 text-secondary"></i>
                    <div class="flex-grow-1 text-truncate">
                        <div class="text-truncate small fw-semibold">@context.User.Identity?.Name</div>
                        @if (AuthProvider.Provider != Shelfwarden.Services.Auth.AuthProvider.None)
                        {
                            @* POST avoids Identity UI's GET /Identity/Account/Logout confirmation ("Click here to log out"). *@
                            @if (AuthProvider.Provider == Shelfwarden.Services.Auth.AuthProvider.Keycloak)
                            {
                                <form method="post" action="/auth/logout" class="d-inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="small btn btn-link p-0 align-baseline text-decoration-none">Sign out</button>
                                </form>
                            }
                            else if (AuthProvider.Provider == Shelfwarden.Services.Auth.AuthProvider.Identity)
                            {
                                @* Identity UI OnPost only redirects when returnUrl is set; otherwise it stays on /Identity/Account/Logout with a success message. *@
                                <form method="post" action="/Identity/Account/Logout" class="d-inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit" class="small btn btn-link p-0 align-baseline text-decoration-none">Sign out</button>
                                </form>
                            }
                        }
                        else
                        {
                            <span class="small text-secondary">Local user</span>
                        }
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-primary w-100" href="@LoginUrl">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnRequestClose { get; set; }
    
    private List<ShelfDto>? shelves;
    private IReadOnlyList<CollectionDto>? collections;
    private IReadOnlyList<ReadingListDto>? readingLists;

    protected override void OnInitialized()
    {
        SidebarNavRefresh.NavigationDataChanged += OnNavigationDataChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSidebarDataAsync();
    }

    private void OnNavigationDataChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSidebarDataAsync();
            StateHasChanged();
        });
    }

    /// <summary>Reloads shelves, collections, and reading lists shown in the sidebar.</summary>
    private async Task LoadSidebarDataAsync()
    {
        // Best-effort: if the user isn't signed in (and these endpoints require auth) we just
        // leave the sections empty rather than blowing up the whole layout.
        try
        {
            var libsTask = ShelfService.GetAllAsync();
            var collectionsTask = CollectionService.ListAsync();
            var listsTask = ReadingListService.ListAsync();
            await Task.WhenAll(libsTask, collectionsTask, listsTask);

            if (libsTask.Result.IsSuccess) shelves = libsTask.Result.Value.ToList();
            if (collectionsTask.Result.IsSuccess) collections = collectionsTask.Result.Value;
            if (listsTask.Result.IsSuccess) readingLists = listsTask.Result.Value;
        }
        catch
        {
            // Anonymous browsing — leave the sidebar minimal.
        }
    }

    void IDisposable.Dispose() => SidebarNavRefresh.NavigationDataChanged -= OnNavigationDataChanged;

    private async Task CloseOnNavigate()
    {
        if (Open && OnRequestClose.HasDelegate)
        {
            await OnRequestClose.InvokeAsync();
        }
    }

    private string LoginUrl => AuthProvider.Provider switch
    {
        Shelfwarden.Services.Auth.AuthProvider.Identity => "Identity/Account/Login",
        Shelfwarden.Services.Auth.AuthProvider.Keycloak => "auth/login",
        _ => "/",
    };

}
