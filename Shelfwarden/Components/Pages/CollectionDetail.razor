@page "/collections/{Id:int}"
@attribute [Authorize]
@inject ICollectionService CollectionService
@inject IBookService BookService
@inject IUserContextService UserContext
@inject ISidebarNavRefreshService SidebarNavRefresh
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(collection?.Name ?? "Collection") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading collection…</div>
    </div>
}
else if (collection is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Collection not found</h3>
        <p>It may have been deleted, or you don't have permission to see it.</p>
        <a class="btn btn-outline-secondary" href="collections">
            <i class="bi bi-arrow-left"></i> Back to collections
        </a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <a href="collections" class="text-secondary text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All collections
            </a>
            <h1 class="mb-1 mt-1 d-flex align-items-center gap-2">
                @collection.Name
                @if (collection.IsGlobal)
                {
                    <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-globe"></i> Global</span>
                }
            </h1>
            @if (!string.IsNullOrEmpty(collection.Description))
            {
                <p class="text-secondary mb-0">@collection.Description</p>
            }
        </div>
        @if (canModify)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="() => editing = !editing">
                    <i class="bi bi-pencil-square"></i> @(editing ? "Cancel" : "Edit")
                </button>
                <button class="btn btn-outline-danger" @onclick="DeleteAsync">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        }
    </div>

    @if (editing && canModify)
    {
        <div class="card mb-4">
            <div class="card-body">
                <EditForm Model="editModel" OnValidSubmit="SaveAsync" FormName="edit-collection">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Name" />
                            <ValidationMessage For="() => editModel.Name" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="editModel.Description" />
                        </div>
                        @if (isAdministrator)
                        {
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="editModel.IsGlobal" id="collection-edit-global" />
                                    <label class="form-check-label" for="collection-edit-global">
                                        Global collection (visible to every signed-in user)
                                    </label>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <CardHeaderImageSelector @bind-Mode="bannerMode"
                                                     SelectedBooks="bannerSelectedBooks"
                                                     SearchBooksInScopeAsync="SearchBooksInCollectionForBannerAsync"
                                                     OnUploadAsync="UploadCollectionBannerAsync"
                                                     OnSelectedBooksChanged="StateHasChanged" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@savingEdit">
                            <i class="bi bi-check-lg"></i> Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (canModify)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add a book</h5>
                <div class="position-relative">
                    <input class="form-control" type="text" placeholder="Search books to add…"
                           value="@searchInput" @oninput="OnSearchInput" @onfocus="() => showSearch = true" />
                    @if (showSearch && searchResults.Count > 0)
                    {
                        <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 280px; overflow-y: auto; z-index: 50;">
                            @foreach (var b in searchResults)
                            {
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                                            @onclick="() => AddBookAsync(b)">
                                        <span class="fw-semibold">@b.Title</span>
                                        @if (!string.IsNullOrEmpty(b.PrimaryAuthor))
                                        {
                                            <span class="text-secondary small">— @b.PrimaryAuthor</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }

    @if (collection.Books.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-bookmark-x empty-icon"></i>
            <h3>This collection is empty</h3>
            @if (canModify)
            {
                <p>Use the search box above to drop books into this collection.</p>
            }
            else
            {
                <p>The owner hasn't added any books yet.</p>
            }
        </div>
    }
    else
    {
        @if (isAdministrator && collection.Books.Count > 0)
        {
            <div class="selection-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary small">
                    <i class="bi bi-check2-square"></i> @selectedBookIds.Count selected
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllVisible" disabled="@(FilteredBooks.Count == 0)">
                    <i class="bi bi-ui-checks"></i> Select visible
                </button>
                @if (CanSelectAllMatching)
                {
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="SelectAllMatching"
                            disabled="@(MatchingBooksCount == 0)">
                        <i class="bi bi-check2-all"></i>
                        Select all@(MatchingBooksCount > 0 ? $" ({MatchingBooksCount})" : "")
                    </button>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
                <BulkBookActions SelectedBookIds="selectedBookIds" />
                <button class="btn btn-sm btn-primary ms-auto" @onclick="GoToBatchEdit" disabled="@(selectedBookIds.Count == 0)">
                    <i class="bi bi-pencil-square"></i> Batch edit
                </button>
            </div>
        }
        <div class="book-browse-layout">
            <div class="book-browse-content">
                @if (FilteredBooks.Count == 0)
                {
                    <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2">
                        <span>No books in this collection match the <strong>@startsWithFilter</strong> filter.</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLetterFilter">
                            Show all
                        </button>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(startsWithFilter))
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLetterFilter">
                                <i class="bi bi-x-circle"></i> Clear title filter
                            </button>
                        </div>
                    }
                    <div class="book-grid">
                        @foreach (var b in FilteredBooks)
                        {
                            <div class="book-card-wrap @(isAdministrator && selectedBookIds.Contains(b.Id) ? "selected" : null)">
                                @if (isAdministrator)
                                {
                                    <input class="form-check-input book-card-select" type="checkbox"
                                           checked="@selectedBookIds.Contains(b.Id)"
                                           @onchange="e => ToggleSelection(b.Id, (bool)(e.Value ?? false))" />
                                }
                                @if (canModify)
                                {
                                    <BookCard Book="b"
                                              SelectionMode="selectedBookIds.Count > 0"
                                              IsSelected="selectedBookIds.Contains(b.Id)"
                                              OnSelectionToggled="checkedNow => ToggleSelection(b.Id, checkedNow)">
                                        <ExtraMenuItems>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        @onclick="() => RemoveBookAsync(b.Id)"
                                                        @onclick:stopPropagation="true"
                                                        @onclick:preventDefault="true">
                                                    <i class="bi bi-x-circle me-1"></i> Remove from collection
                                                </button>
                                            </li>
                                        </ExtraMenuItems>
                                    </BookCard>
                                }
                                else
                                {
                                    <BookCard Book="b" />
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <BookLetterRail @bind-StartsWith="startsWithFilter" />
        </div>
    }
}
