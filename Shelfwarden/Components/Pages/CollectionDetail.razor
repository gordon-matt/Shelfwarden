@page "/collections/{Id:int}"
@attribute [Authorize]
@inject ICollectionService CollectionService
@inject IBookService BookService
@inject IUserContextService UserContext
@inject ISidebarNavRefreshService SidebarNavRefresh
@inject NavigationManager NavigationManager

<PageTitle>@(collection?.Name ?? "Collection") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading collection…</div>
    </div>
}
else if (collection is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Collection not found</h3>
        <p>It may have been deleted, or you don't have permission to see it.</p>
        <a class="btn btn-outline-secondary" href="collections">
            <i class="bi bi-arrow-left"></i> Back to collections
        </a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <a href="collections" class="text-secondary text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All collections
            </a>
            <h1 class="mb-1 mt-1 d-flex align-items-center gap-2">
                @collection.Name
                @if (collection.IsGlobal)
                {
                    <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-globe"></i> Global</span>
                }
            </h1>
            @if (!string.IsNullOrEmpty(collection.Description))
            {
                <p class="text-secondary mb-0">@collection.Description</p>
            }
        </div>
        @if (canModify)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" @onclick="() => editing = !editing">
                    <i class="bi bi-pencil-square"></i> @(editing ? "Cancel" : "Edit")
                </button>
                <button class="btn btn-outline-danger" @onclick="DeleteAsync">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        }
    </div>

    @if (editing && canModify)
    {
        <div class="card mb-4">
            <div class="card-body">
                <EditForm Model="editModel" OnValidSubmit="SaveAsync" FormName="edit-collection">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="editModel.Name" />
                            <ValidationMessage For="() => editModel.Name" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="editModel.Description" />
                        </div>
                        @if (UserContext.IsAdministrator())
                        {
                            <div class="col-12">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="editModel.IsGlobal" id="collection-edit-global" />
                                    <label class="form-check-label" for="collection-edit-global">
                                        Global collection (visible to every signed-in user)
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@savingEdit">
                            <i class="bi bi-check-lg"></i> Save
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (canModify)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Add a book</h5>
                <div class="position-relative">
                    <input class="form-control" type="text" placeholder="Search books to add…"
                           value="@searchInput" @oninput="OnSearchInput" @onfocus="() => showSearch = true" />
                    @if (showSearch && searchResults.Count > 0)
                    {
                        <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 280px; overflow-y: auto; z-index: 50;">
                            @foreach (var b in searchResults)
                            {
                                <li>
                                    <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                                            @onclick="() => AddBookAsync(b)">
                                        <span class="fw-semibold">@b.Title</span>
                                        @if (!string.IsNullOrEmpty(b.PrimaryAuthor))
                                        {
                                            <span class="text-secondary small">— @b.PrimaryAuthor</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }

    @if (collection.Books.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-bookmark-x empty-icon"></i>
            <h3>This collection is empty</h3>
            @if (canModify)
            {
                <p>Use the search box above to drop books into this collection.</p>
            }
            else
            {
                <p>The owner hasn't added any books yet.</p>
            }
        </div>
    }
    else
    {
        @if (UserContext.IsAdministrator() && collection.Books.Count > 0)
        {
            <div class="selection-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary small">
                    <i class="bi bi-check2-square"></i> @selectedBookIds.Count selected
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllVisible" disabled="@(FilteredBooks.Count == 0)">
                    <i class="bi bi-ui-checks"></i> Select visible
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="SelectAllMatching"
                        disabled="@(MatchingBooksCount == 0)">
                    <i class="bi bi-check2-all"></i>
                    Select all@(MatchingBooksCount > 0 ? $" ({MatchingBooksCount})" : "")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
                <BulkBookActions SelectedBookIds="selectedBookIds" />
                <button class="btn btn-sm btn-primary ms-auto" @onclick="GoToBatchEdit" disabled="@(selectedBookIds.Count == 0)">
                    <i class="bi bi-pencil-square"></i> Batch edit
                </button>
            </div>
        }
        <div class="book-browse-layout">
            <div class="book-browse-content">
                @if (FilteredBooks.Count == 0)
                {
                    <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2">
                        <span>No books in this collection match the <strong>@startsWithFilter</strong> filter.</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyStartsWithFilter(string.Empty)">
                            Show all
                        </button>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(startsWithFilter))
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ApplyStartsWithFilter(string.Empty)">
                                <i class="bi bi-x-circle"></i> Clear title filter
                            </button>
                        </div>
                    }
                    <div class="book-grid">
                        @foreach (var b in FilteredBooks)
                        {
                            <div class="book-card-wrapper book-card-wrap @(UserContext.IsAdministrator() && selectedBookIds.Contains(b.Id) ? "selected" : null)">
                                @if (UserContext.IsAdministrator())
                                {
                                    <input class="form-check-input book-card-select" type="checkbox"
                                           checked="@selectedBookIds.Contains(b.Id)"
                                           @onchange="e => ToggleSelection(b.Id, (bool)(e.Value ?? false))" />
                                }
                                <BookCard Book="b" />
                                @if (canModify)
                                {
                                    <button class="btn btn-sm btn-danger book-card-remove" title="Remove from collection"
                                            @onclick="() => RemoveBookAsync(b.Id)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="book-letter-rail" role="group" aria-label="Book title letter filter">
                @foreach (var filter in LetterFilters)
                {
                    bool active = string.Equals(startsWithFilter ?? string.Empty, filter.Value, StringComparison.Ordinal);
                    <button type="button"
                            class="book-letter-btn @(active ? "active" : null) @(filter.Value.Length == 0 ? "book-letter-btn-all" : null)"
                            title="Show @filter.Label titles"
                            @onclick="() => ApplyStartsWithFilter(filter.Value)">
                        @filter.Label
                    </button>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CollectionDetailDto? collection;
    private bool loading = true;
    private bool canModify;

    private bool editing;
    private bool savingEdit;
    private EditModel editModel = new();

    private string? searchInput;
    private bool showSearch;
    private IReadOnlyList<BookListItemDto> searchResults = [];
    private CancellationTokenSource? searchCts;
    private string? startsWithFilter;
    private static readonly (string Value, string Label)[] LetterFilters =
    [
        (string.Empty, "All"),
        ("#", "#"),
        ("A", "A"), ("B", "B"), ("C", "C"), ("D", "D"), ("E", "E"), ("F", "F"), ("G", "G"),
        ("H", "H"), ("I", "I"), ("J", "J"), ("K", "K"), ("L", "L"), ("M", "M"), ("N", "N"),
        ("O", "O"), ("P", "P"), ("Q", "Q"), ("R", "R"), ("S", "S"), ("T", "T"), ("U", "U"),
        ("V", "V"), ("W", "W"), ("X", "X"), ("Y", "Y"), ("Z", "Z")
    ];
    private IReadOnlyList<BookListItemDto> FilteredBooks =>
        collection?.Books.Where(MatchesStartsWithFilter).ToList() ?? [];

    private int MatchingBooksCount => collection?.Books.Count(MatchesStartsWithFilter) ?? 0;

    private readonly HashSet<int> selectedBookIds = [];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        var result = await CollectionService.GetByIdAsync(Id);
        if (result.IsSuccess)
        {
            collection = result.Value;
            selectedBookIds.Clear();
            editModel = new EditModel
            {
                Name = collection.Name,
                Description = collection.Description,
                IsGlobal = collection.IsGlobal,
            };
            string? userId = UserContext.GetCurrentUserId();
            // Owner can always modify; admins can modify the global flavour. Personal
            // collections owned by other users are 403'd by the service before we get here.
            canModify = collection.IsGlobal
                ? UserContext.IsAdministrator()
                : collection.OwnerUserId == userId;
        }
        else
        {
            collection = null;
        }
    }

    private async Task SaveAsync()
    {
        savingEdit = true;
        try
        {
            var result = await CollectionService.UpdateAsync(Id, new UpdateCollectionRequest
            {
                Name = editModel.Name,
                Description = editModel.Description,
                IsGlobal = UserContext.IsAdministrator() && editModel.IsGlobal,
            });
            if (result.IsSuccess)
            {
                editing = false;
                SidebarNavRefresh.NotifyNavigationDataChanged();
                await LoadAsync();
            }
        }
        finally
        {
            savingEdit = false;
        }
    }

    private async Task DeleteAsync()
    {
        var result = await CollectionService.DeleteAsync(Id);
        if (result.IsSuccess)
        {
            SidebarNavRefresh.NotifyNavigationDataChanged();
            NavigationManager.NavigateTo("collections");
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString();
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(200, token);
            if (string.IsNullOrWhiteSpace(searchInput))
            {
                searchResults = [];
                showSearch = false;
                return;
            }

            var result = await BookService.SearchAsync(new BookSearchRequest
            {
                Query = searchInput,
                Page = 1,
                PageSize = 8,
            }, token);
            if (token.IsCancellationRequested) return;

            // Filter out books already in the collection so the user doesn't try to re-add them.
            var existing = collection?.Books.Select(b => b.Id).ToHashSet() ?? [];
            searchResults = result.IsSuccess
                ? result.Value.Items.Where(b => !existing.Contains(b.Id)).ToList()
                : [];
            showSearch = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private async Task AddBookAsync(BookListItemDto book)
    {
        var result = await CollectionService.AddBookAsync(Id, book.Id);
        if (result.IsSuccess)
        {
            searchInput = string.Empty;
            searchResults = [];
            showSearch = false;
            await LoadAsync();
        }
    }

    private async Task RemoveBookAsync(int bookId)
    {
        var result = await CollectionService.RemoveBookAsync(Id, bookId);
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
    }

    private void ApplyStartsWithFilter(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            startsWithFilter = null;
        }
        else
        {
            startsWithFilter = string.Equals(startsWithFilter, value, StringComparison.Ordinal) ? null : value;
        }
    }

    private bool MatchesStartsWithFilter(BookListItemDto book)
    {
        if (string.IsNullOrWhiteSpace(startsWithFilter))
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(book.Title))
        {
            return false;
        }

        if (startsWithFilter == "#")
        {
            char first = book.Title[0];
            return !char.IsLetter(first);
        }

        return book.Title.StartsWith(startsWithFilter, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleSelection(int bookId, bool include)
    {
        if (include) selectedBookIds.Add(bookId);
        else selectedBookIds.Remove(bookId);
    }

    private void SelectAllVisible()
    {
        foreach (var b in FilteredBooks) selectedBookIds.Add(b.Id);
    }

    private void SelectAllMatching()
    {
        if (collection is null || MatchingBooksCount == 0) return;
        foreach (var b in collection.Books.Where(MatchesStartsWithFilter))
        {
            selectedBookIds.Add(b.Id);
        }
    }

    private void ClearSelection() => selectedBookIds.Clear();

    private void GoToBatchEdit()
    {
        if (selectedBookIds.Count == 0) return;
        string ids = string.Join(',', selectedBookIds.Order());
        NavigationManager.NavigateTo($"books/batch-edit?ids={ids}&return=collections/{Id}");
    }

    private sealed class EditModel
    {
        [Required, StringLength(256)]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public bool IsGlobal { get; set; }
    }
}
