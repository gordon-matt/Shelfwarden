@page "/authors"
@attribute [Authorize]
@inject IAuthorService AuthorService
@inject NavigationManager NavigationManager

<PageTitle>Authors - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Authors</h1>
    @if (authors is not null)
    {
        <span class="text-secondary small">@authors.Count author@(authors.Count == 1 ? "" : "s")</span>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search authors..." @bind="query" @bind:event="oninput" @onkeyup="OnQueryKeyUp" />
        </div>
    </div>
</div>

@if (authors is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading authors…</div>
    </div>
}
else if (authors.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-person-lines-fill empty-icon"></i>
        <h3>No authors found</h3>
        <p>Once libraries have been scanned, the authors of those books will appear here.</p>
    </div>
}
else
{
    <div class="author-grid">
        @foreach (var a in authors)
        {
            <div class="author-tile author-tile-shell">
                <a class="author-tile" href="@($"authors/{a.Id}")" title="@a.Name">
                    <div class="author-avatar">
                        <img src="@GetAuthorPhotoUrl(a.Id)" alt="@a.Name"
                             loading="lazy"
                             onerror="this.classList.add('d-none');this.parentElement.classList.add('no-photo')" />
                        <i class="bi bi-person placeholder-icon"></i>
                    </div>
                    <div class="author-tile-name text-truncate">@a.Name</div>
                    <div class="author-tile-count text-secondary small">
                        @a.BookCount book@(a.BookCount == 1 ? "" : "s")
                    </div>
                </a>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary author-tile-edit"
                                title="Match author with OpenLibrary"
                                @onclick="() => OpenAuthorMatchModalAsync(a)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>
}

@if (isAuthorMatchModalOpen && selectedAuthor is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Match Author from OpenLibrary</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAuthorMatchModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Author name</label>
                    <div class="input-group mb-3">
                        <input class="form-control" @bind="authorMatchQuery" @bind:event="oninput" />
                        <button type="button" class="btn btn-primary" @onclick="SearchOpenLibraryAsync" disabled="@isSearchingOpenLibrary">
                            @if (isSearchingOpenLibrary)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(authorMatchError))
                    {
                        <div class="alert alert-danger py-2">@authorMatchError</div>
                    }

                    @if (openLibraryMatches.Count == 0 && hasSearchedOpenLibrary && string.IsNullOrWhiteSpace(authorMatchError))
                    {
                        <div class="alert alert-secondary py-2 mb-0">No OpenLibrary author matches were found.</div>
                    }
                    else if (openLibraryMatches.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var match in openLibraryMatches)
                            {
                                bool isSelected = pendingMatchSelection?.OpenLibraryId == match.OpenLibraryId;
                                <button type="button"
                                        class="btn text-start border @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => SelectMatch(match)">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <div class="fw-semibold">@match.Name</div>
                                            <div class="small opacity-75">
                                                <span>@match.OpenLibraryId</span>
                                                @if (!string.IsNullOrWhiteSpace(match.BirthDate) || !string.IsNullOrWhiteSpace(match.DeathDate))
                                                {
                                                    <span> · @match.BirthDate-@match.DeathDate</span>
                                                }
                                                <span> · Bio: @(match.HasBio ? "yes" : "no")</span>
                                                <span> · Photo: @(match.HasPhoto ? "yes" : "no")</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(match.BioPreview))
                                            {
                                                <div class="small mt-1">@match.BioPreview</div>
                                            }
                                        </div>
                                        <span class="badge @(isSelected ? "bg-light text-dark" : "bg-secondary-subtle text-secondary-emphasis")">
                                            @(isSelected ? "Selected" : "Select")
                                        </span>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (isAwaitingImportConfirmation && pendingMatchSelection is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <div class="fw-semibold mb-1">Are you sure?</div>
                            <div class="small">This will import biography/photo for <strong>@selectedAuthor.Name</strong> from OpenLibrary match <strong>@pendingMatchSelection.OpenLibraryId</strong>.</div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAuthorMatchModal">Cancel</button>
                    @if (!isAwaitingImportConfirmation)
                    {
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@(pendingMatchSelection is null)"
                                @onclick="StartImportConfirmation">
                            Continue
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelImportConfirmation">Back</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmImportAsync" disabled="@isImportingOpenLibrary">
                            @if (isImportingOpenLibrary)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Yes, import
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private IReadOnlyList<AuthorListItemDto>? authors;
    private string query = string.Empty;
    private CancellationTokenSource? searchCts;
    private readonly Dictionary<int, long> authorPhotoVersions = [];

    private bool isAuthorMatchModalOpen;
    private AuthorListItemDto? selectedAuthor;
    private string authorMatchQuery = string.Empty;
    private bool isSearchingOpenLibrary;
    private bool hasSearchedOpenLibrary;
    private bool isImportingOpenLibrary;
    private bool isAwaitingImportConfirmation;
    private string? authorMatchError;
    private IReadOnlyList<OpenLibraryAuthorMatchDto> openLibraryMatches = [];
    private OpenLibraryAuthorMatchDto? pendingMatchSelection;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Cancel any in-flight search so we never display stale results out of order.
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        var result = await AuthorService.ListAsync(query, token);
        if (token.IsCancellationRequested) return;

        authors = result.IsSuccess ? result.Value : [];
    }

    private async Task OnQueryKeyUp(KeyboardEventArgs e)
    {
        // Tiny debounce: query on Enter immediately, otherwise wait for the user to stop typing.
        if (e.Key == "Enter")
        {
            await LoadAsync();
            return;
        }

        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            if (token.IsCancellationRequested) return;
            await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OpenAuthorMatchModalAsync(AuthorListItemDto author)
    {
        selectedAuthor = author;
        isAuthorMatchModalOpen = true;
        authorMatchQuery = author.Name;
        authorMatchError = null;
        hasSearchedOpenLibrary = false;
        isAwaitingImportConfirmation = false;
        pendingMatchSelection = null;
        openLibraryMatches = [];
        await SearchOpenLibraryAsync();
    }

    private void CloseAuthorMatchModal()
    {
        isAuthorMatchModalOpen = false;
        selectedAuthor = null;
        authorMatchQuery = string.Empty;
        authorMatchError = null;
        hasSearchedOpenLibrary = false;
        isAwaitingImportConfirmation = false;
        pendingMatchSelection = null;
        openLibraryMatches = [];
        isSearchingOpenLibrary = false;
        isImportingOpenLibrary = false;
    }

    private async Task SearchOpenLibraryAsync()
    {
        authorMatchError = null;
        hasSearchedOpenLibrary = true;
        isAwaitingImportConfirmation = false;
        pendingMatchSelection = null;

        if (string.IsNullOrWhiteSpace(authorMatchQuery))
        {
            openLibraryMatches = [];
            authorMatchError = "Please enter an author name to search.";
            return;
        }

        isSearchingOpenLibrary = true;
        try
        {
            var result = await AuthorService.SearchOpenLibraryAuthorsAsync(authorMatchQuery, 10);
            openLibraryMatches = result.IsSuccess ? result.Value : [];
            if (!result.IsSuccess)
            {
                authorMatchError = "OpenLibrary search failed.";
            }
        }
        finally
        {
            isSearchingOpenLibrary = false;
        }
    }

    private void SelectMatch(OpenLibraryAuthorMatchDto match)
    {
        pendingMatchSelection = match;
        isAwaitingImportConfirmation = false;
        authorMatchError = null;
    }

    private void StartImportConfirmation()
    {
        if (pendingMatchSelection is null)
        {
            return;
        }

        isAwaitingImportConfirmation = true;
    }

    private void CancelImportConfirmation()
    {
        isAwaitingImportConfirmation = false;
    }

    private async Task ConfirmImportAsync()
    {
        if (selectedAuthor is null || pendingMatchSelection is null)
        {
            return;
        }

        isImportingOpenLibrary = true;
        authorMatchError = null;
        try
        {
            var result = await AuthorService.ImportFromOpenLibraryAsync(selectedAuthor.Id, pendingMatchSelection.OpenLibraryId);
            if (!result.IsSuccess)
            {
                authorMatchError = "Import failed. Please try a different match.";
                return;
            }

            authorPhotoVersions[selectedAuthor.Id] = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            await LoadAsync();
            CloseAuthorMatchModal();
        }
        finally
        {
            isImportingOpenLibrary = false;
        }
    }

    private string GetAuthorPhotoUrl(int authorId)
    {
        long version = authorPhotoVersions.GetValueOrDefault(authorId, 0);
        return $"author-photos/{authorId}?v={version}";
    }
}
