@page "/authors"
@attribute [Authorize]
@inject IAuthorService AuthorService
@inject NavigationManager NavigationManager

<PageTitle>Authors - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Authors</h1>
    @if (authors is not null)
    {
        <span class="text-secondary small">@authors.Count author@(authors.Count == 1 ? "" : "s")</span>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search authors..." @bind="query" @bind:event="oninput" @onkeyup="OnQueryKeyUp" />
        </div>
    </div>
</div>

@if (authors is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading authors…</div>
    </div>
}
else if (authors.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-person-lines-fill empty-icon"></i>
        <h3>No authors found</h3>
        <p>Once libraries have been scanned, the authors of those books will appear here.</p>
    </div>
}
else
{
    <div class="author-grid">
        @foreach (var a in authors)
        {
            <div class="author-tile author-tile-shell">
                <a class="author-tile" href="@($"authors/{a.Id}")" title="@a.Name">
                    <div class="author-avatar">
                        @{
                            string photoUrl = GetAuthorPhotoUrl(a.Id);
                        }
                        <img src="@photoUrl" alt="@a.Name"
                             @key="photoUrl"
                             loading="lazy"
                             onerror="this.classList.add('d-none');this.parentElement.classList.add('no-photo')" />
                        <i class="bi bi-person placeholder-icon"></i>
                    </div>
                    <div class="author-tile-name text-truncate">@a.Name</div>
                    <div class="author-tile-count text-secondary small">
                        @a.BookCount book@(a.BookCount == 1 ? "" : "s")
                    </div>
                </a>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary author-tile-edit"
                                title="Edit author"
                                @onclick="() => OpenAuthorMatchModalAsync(a)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>
}

<AuthorProfileModal IsOpen="@isAuthorEditModalOpen"
                    AuthorId="@selectedAuthorId"
                    AuthorName="@selectedAuthorName"
                    CurrentBiography="@selectedAuthorBiography"
                    OnClose="CloseAuthorEditModalAsync"
                    OnSaved="OnAuthorSavedAsync" />

@code {
    private IReadOnlyList<AuthorListItemDto>? authors;
    private string query = string.Empty;
    private CancellationTokenSource? searchCts;
    private readonly Dictionary<int, long> authorPhotoVersions = [];

    private bool isAuthorEditModalOpen;
    private int selectedAuthorId;
    private string selectedAuthorName = string.Empty;
    private string? selectedAuthorBiography;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Cancel any in-flight search so we never display stale results out of order.
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        var result = await AuthorService.ListAsync(query, token);
        if (token.IsCancellationRequested) return;

        authors = result.IsSuccess ? result.Value : [];
    }

    private async Task OnQueryKeyUp(KeyboardEventArgs e)
    {
        // Tiny debounce: query on Enter immediately, otherwise wait for the user to stop typing.
        if (e.Key == "Enter")
        {
            await LoadAsync();
            return;
        }

        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            if (token.IsCancellationRequested) return;
            await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OpenAuthorMatchModalAsync(AuthorListItemDto author)
    {
        selectedAuthorId = author.Id;
        selectedAuthorName = author.Name;
        selectedAuthorBiography = author.Biography;
        isAuthorEditModalOpen = true;
    }

    private Task CloseAuthorEditModalAsync()
    {
        isAuthorEditModalOpen = false;
        return Task.CompletedTask;
    }

    private async Task OnAuthorSavedAsync()
    {
        authorPhotoVersions[selectedAuthorId] = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        await LoadAsync();
    }

    private string GetAuthorPhotoUrl(int authorId)
    {
        long version = authorPhotoVersions.GetValueOrDefault(authorId, 0);
        return $"author-photos/{authorId}?v={version}";
    }
}
