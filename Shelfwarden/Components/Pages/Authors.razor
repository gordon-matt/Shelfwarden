@page "/authors"
@attribute [Authorize]
@inject IAuthorService AuthorService
@inject IShelfService ShelfService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Authors - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="mb-0">Authors</h1>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        @if (authors is not null)
        {
            <span class="text-secondary small">
                @authors.Count author@(authors.Count == 1 ? "" : "s")
                @if (unknownBookCount > 0)
                {
                    <span> · @unknownBookCount book@(unknownBookCount == 1 ? "" : "s") without an author</span>
                }
            </span>
        }
        <AuthorizeView Roles="@Constants.Roles.Administrator">
            <Authorized>
                <button type="button"
                        class="btn btn-sm @(selectMode ? "btn-primary" : "btn-outline-secondary")"
                        title="Toggle select mode"
                        @onclick="ToggleSelectMode">
                    <i class="bi bi-check2-square"></i>
                    @if (selectMode)
                    {
                        <span class="ms-1">@selectedAuthorIds.Count selected</span>
                    }
                    else
                    {
                        <span class="ms-1">Select</span>
                    }
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (selectMode)
{
    <AuthorizeView Roles="@Constants.Roles.Administrator">
        <Authorized>
            <div class="selection-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary small">
                    <i class="bi bi-check2-square"></i> @selectedAuthorIds.Count selected
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllListed" disabled="@(authors is null || authors.Count == 0)">
                    <i class="bi bi-ui-checks"></i> Select listed
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedAuthorIds.Count == 0)">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
                <button class="btn btn-sm btn-outline-danger"
                        disabled="@(selectedAuthorIds.Count == 0)"
                        @onclick="DeleteSelectedAsync">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <button class="btn btn-sm btn-outline-primary"
                        disabled="@(selectedAuthorIds.Count < 2)"
                        @onclick="OpenMergeModalAsync">
                    <i class="bi bi-intersect"></i> Merge
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
}

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-6">
        <label class="form-label small text-body-secondary mb-1">Search</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search authors..." @bind="query" @bind:event="oninput" @onkeyup="OnQueryKeyUp" />
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <label class="form-label small text-body-secondary mb-1">Shelf</label>
        <select class="form-select"
                @bind="shelfId"
                @bind:after="OnShelfFilterChangedAsync">
            <option value="">All shelves</option>
            @foreach (var s in shelves)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
</div>

@if (authors is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading authors…</div>
    </div>
}
else if (authors.Count == 0 && unknownBookCount == 0)
{
    <div class="empty-state">
        <i class="bi bi-person-lines-fill empty-icon"></i>
        <h3>No authors found</h3>
        @if (string.IsNullOrEmpty(shelfId))
        {
            <p>Once shelves have been scanned, the authors of those books will appear here.</p>
        }
        else
        {
            <p>No authors have books on this shelf with the current search.</p>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="ClearShelfFilterAsync">
                Show all shelves
            </button>
        }
    </div>
}
else
{
    <div class="author-grid">
        <div class="author-tile-shell">
            <a class="author-tile" href="authors/unknown" title="Books with no linked authors">
                <div class="author-avatar author-avatar-unknown no-photo">
                    <i class="bi bi-question-lg placeholder-icon"></i>
                </div>
                <div class="author-tile-name text-truncate">Unknown</div>
                <div class="author-tile-count text-secondary small">
                    @unknownBookCount book@(unknownBookCount == 1 ? "" : "s")
                </div>
            </a>
        </div>
        @foreach (var a in authors)
        {
            <div class="author-tile-shell @(selectMode && selectedAuthorIds.Contains(a.Id) ? "selected" : null)">
                @if (selectMode)
                {
                    <input class="form-check-input author-tile-select" type="checkbox"
                           checked="@selectedAuthorIds.Contains(a.Id)"
                           @onchange="e => ToggleSelection(a.Id, (bool)(e.Value ?? false))"
                           @onclick:stopPropagation />
                }
                <a class="author-tile"
                   href="@($"authors/{a.Id}")"
                   title="@a.Name"
                   @onclick="() => HandleAuthorTileClick(a.Id)"
                   @onclick:preventDefault="@selectMode">
                    <div class="author-avatar">
                        @{
                            string photoUrl = GetAuthorPhotoUrl(a.Id);
                        }
                        <img src="@photoUrl" alt="@a.Name"
                             @key="photoUrl"
                             loading="lazy"
                             onerror="this.classList.add('d-none');this.parentElement.classList.add('no-photo')" />
                        <i class="bi bi-person placeholder-icon"></i>
                    </div>
                    <div class="author-tile-name text-truncate">@a.Name</div>
                    <div class="author-tile-count text-secondary small">
                        @a.BookCount book@(a.BookCount == 1 ? "" : "s")
                    </div>
                </a>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        @if (!selectMode)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary author-tile-edit"
                                    title="Edit author"
                                    @onclick="() => OpenAuthorMatchModalAsync(a)"
                                    @onclick:stopPropagation>
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>
}

<AuthorProfileModal IsOpen="@isAuthorEditModalOpen"
                    AuthorId="@selectedAuthorId"
                    AuthorName="@selectedAuthorName"
                    CurrentBiography="@selectedAuthorBiography"
                    OnClose="CloseAuthorEditModalAsync"
                    OnSaved="OnAuthorSavedAsync" />

@if (mergeModalOpen && mergeCandidates.Count > 0)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);" @onclick="CloseMergeModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Merge authors</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseMergeModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-3">
                        Choose the author record to keep. All books linked to the other selected authors will point to that record instead.
                    </p>
                    @foreach (var c in mergeCandidates)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="mergePrimaryAuthor"
                                   id="@($"merge-primary-{c.Id}")"
                                   checked="@(mergePrimaryAuthorId == c.Id)"
                                   @onchange="@(() => mergePrimaryAuthorId = c.Id)" />
                            <label class="form-check-label" for="@($"merge-primary-{c.Id}")">@c.Name</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseMergeModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmMergeAsync">Merge</button>
                </div>
            </div>
        </div>
    </div>
}
