@page "/"
@attribute [Authorize]
@inject IDashboardService DashboardService

<PageTitle>Home - Shelfwarden</PageTitle>

<h1 class="visually-hidden">Home</h1>

@if (dashboard is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading dashboard…</div>
    </div>
}
else
{
    <section class="mb-4">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-collection"></i></div>
                    <div>
                        <p class="stat-value">@dashboard.Stats.ShelfCount</p>
                        <p class="stat-label">Shelves</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-book"></i></div>
                    <div>
                        <p class="stat-value">@dashboard.Stats.BookCount</p>
                        <p class="stat-label">Books</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-person"></i></div>
                    <div>
                        <p class="stat-value">@dashboard.Stats.AuthorCount</p>
                        <p class="stat-label">Authors</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
                    <div>
                        <p class="stat-value">@dashboard.Stats.FinishedCount</p>
                        <p class="stat-label">Finished</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (dashboard.ContinueReading.Count > 0)
    {
        <section class="mb-5">
            <div class="section-header">
                <h2><i class="bi bi-bookmark-check me-1"></i> Continue Reading</h2>
            </div>
            <div class="book-grid">
                @foreach (var book in dashboard.ContinueReading)
                {
                    <BookCard Book="book" />
                }
            </div>
        </section>
    }

    <section class="mb-5">
        <div class="section-header">
            <h2><i class="bi bi-stars me-1"></i> Recently Added</h2>
            <div class="section-actions">
                <a class="btn btn-sm btn-outline-secondary" href="books">View all</a>
            </div>
        </div>

        @if (dashboard.RecentlyAdded.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-bookshelf empty-icon"></i>
                <h3>No books yet</h3>
                <p>Create a shelf and run a scan to import your first books.</p>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <a class="btn btn-primary" href="shelves/new"><i class="bi bi-plus-lg"></i> Add a shelf</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in dashboard.RecentlyAdded)
                {
                    <BookCard Book="book" />
                }
            </div>
        }
    </section>
}

@code {
    private DashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        var result = await DashboardService.GetAsync();
        if (result.IsSuccess)
        {
            dashboard = result.Value;
        }
        else
        {
            dashboard = new DashboardDto(
                new DashboardStatsDto(0, 0, 0, 0, 0),
                [],
                []);
        }
    }
}
