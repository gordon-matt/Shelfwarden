@page "/authors/{Id:int}"
@attribute [Authorize]
@inject IAuthorService AuthorService
@inject IAdditionalContentService ContentService
@inject IUserContextService UserContext
@inject NavigationManager NavigationManager

@if (author is null && !loadFailed)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading author…</div>
    </div>
}
else if (author is null)
{
    <PageTitle>Author not found - Shelfwarden</PageTitle>
    <div class="empty-state">
        <i class="bi bi-person-x empty-icon"></i>
        <h3>Author not found</h3>
        <p>The author you were looking for couldn't be loaded.</p>
        <a class="btn btn-outline-primary" href="authors"><i class="bi bi-arrow-left"></i> Back to authors</a>
    </div>
}
else
{
    <PageTitle>@author.Name - Shelfwarden</PageTitle>

    <div class="author-header mb-4">
        <div class="author-header-photo">
            <img src="@GetAuthorPhotoUrl(author.Id)" alt="@author.Name"
                 @key="GetAuthorPhotoUrl(author.Id)"
                 onerror="this.classList.add('d-none');this.parentElement.classList.add('no-photo')" />
            <i class="bi bi-person placeholder-icon"></i>
        </div>
        <div class="author-header-body">
            <h1 class="mb-2">@author.Name</h1>
            <div class="text-secondary small mb-3">
                @author.BookCount book@(author.BookCount == 1 ? "" : "s")
                @if (author.SeriesGroups.Count > 0)
                {
                    <span> · @author.SeriesGroups.Count series</span>
                }
            </div>
            <AuthorizeView Roles="@Constants.Roles.Administrator">
                <Authorized>
                    <div class="mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenAuthorEditModal">
                            <i class="bi bi-pencil-square"></i> Edit author
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
            @if (!string.IsNullOrWhiteSpace(author.Biography))
            {
                <p class="author-bio mb-0">@author.Biography</p>
            }
            else
            {
                <p class="text-secondary mb-0 fst-italic">No biography on file.</p>
            }
        </div>
    </div>

    @if (author.SeriesGroups.Count > 0)
    {
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <h2 class="mb-0">Series</h2>
                <a class="small text-decoration-none" href="series">Browse all series <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="book-grid">
                @foreach (var s in author.SeriesGroups)
                {
                    <div class="series-tile-shell">
                        <a class="series-tile" href="@($"series/{s.SeriesId}")" title="@s.SeriesName">
                            <div class="series-tile-cover">
                                <SeriesCollage Covers="s.Covers" />
                                <AuthorizeView Roles="@Constants.Roles.Administrator">
                                    <Authorized>
                                        <div class="series-tile-menu dropend">
                                            <button type="button"
                                                    class="btn btn-sm series-tile-menu-toggle"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-config='{"popperConfig":{"strategy":"fixed"}}'
                                                    aria-expanded="false"
                                                    aria-label="Series actions"
                                                    @onclick:stopPropagation="true"
                                                    @onclick:preventDefault="true">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button type="button" class="dropdown-item"
                                                            @onclick="() => OpenAssignContentSeries(s.SeriesId, s.SeriesName)"
                                                            @onclick:stopPropagation="true"
                                                            @onclick:preventDefault="true">
                                                        <i class="bi bi-folder-plus me-1"></i> Assign Content
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                            <div class="series-tile-body">
                                <div class="series-tile-name text-truncate">@s.SeriesName</div>
                                <div class="series-tile-count text-secondary small">
                                    @s.BookCount book@(s.BookCount == 1 ? "" : "s")
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>
    }

    @if (author.StandaloneBooks.Count > 0)
    {
        <section>
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h2 class="mb-0">Standalone books</h2>
                <div class="d-flex align-items-center gap-2">
                    <button type="button"
                            class="btn btn-sm @(selectMode ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="ToggleSelectMode">
                        <i class="bi bi-check2-square"></i>
                        @if (selectMode)
                        {
                            <span class="ms-1">@selectedBookIds.Count selected</span>
                        }
                        else
                        {
                            <span class="ms-1">Select</span>
                        }
                    </button>
                    @if (selectMode)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAll">
                            <i class="bi bi-check2-all"></i> Select all
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
                            <i class="bi bi-x-circle"></i> Clear
                        </button>
                        <BulkBookActions SelectedBookIds="selectedBookIds" />
                        <button class="btn btn-sm btn-primary" @onclick="GoToBatchEdit" disabled="@(selectedBookIds.Count == 0)">
                            <i class="bi bi-pencil-square"></i> Batch edit
                        </button>
                    }
                </div>
            </div>
            <div class="book-grid">
                @foreach (var b in author.StandaloneBooks)
                {
                    <div class="book-card-wrap @(selectMode && selectedBookIds.Contains(b.Id) ? "selected" : "")">
                        @if (selectMode)
                        {
                            <input class="form-check-input book-card-select" type="checkbox"
                                   checked="@selectedBookIds.Contains(b.Id)"
                                   @onchange="e => ToggleSelection(b.Id, (bool)(e.Value ?? false))" />
                        }
                        <BookCard Book="b"
                                  SelectionMode="selectMode && selectedBookIds.Count > 0"
                                  IsSelected="selectedBookIds.Contains(b.Id)"
                                  OnSelectionToggled="checkedNow => ToggleSelection(b.Id, checkedNow)">
                            <ExtraMenuItems>
                                <AuthorizeView Roles="@Constants.Roles.Administrator">
                                    <Authorized>
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    @onclick="() => OpenAssignContentBook(b.Id, b.Title)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick:preventDefault="true">
                                                <i class="bi bi-folder-plus me-1"></i> Assign Content
                                            </button>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                            </ExtraMenuItems>
                        </BookCard>
                    </div>
                }
            </div>
        </section>
    }
    else if (author.SeriesGroups.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-book empty-icon"></i>
            <h3>No books yet</h3>
            <p>Once a book by this author is scanned in, it will appear here.</p>
        </div>
    }

    @* Extra content associated with this author *@
    @if (extraContent is { Count: > 0 })
    {
        <section class="mt-5">
            <h2 class="mb-3">Extra Content</h2>
            <AdditionalContentGrid Items="extraContent"
                                   TagScopeAuthorId="Id"
                                   OnItemDeleted="RefreshExtraContentAsync"
                                   OnItemRenamed="OnContentItemRenamed"
                                   OnItemsChanged="RefreshExtraContentAsync" />
        </section>
    }
}

<AssignContentModal IsOpen="@isAssignContentModalOpen"
                    AuthorId="@Id"
                    EntityLabel="@assignEntityLabel"
                    EntityName="@assignEntityName"
                    EntityType="@assignEntityType"
                    EntityId="@assignEntityId"
                    OnClose="CloseAssignContent"
                    OnAssociated="RefreshExtraContentAsync" />

<AuthorProfileModal IsOpen="@isAuthorEditModalOpen"
                    AuthorId="@Id"
                    AuthorName="@(author?.Name ?? string.Empty)"
                    CurrentBiography="@author?.Biography"
                    OnClose="CloseAuthorEditModalAsync"
                    OnSaved="OnAuthorSavedAsync" />
