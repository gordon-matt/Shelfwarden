@page "/read/{Id:int}"
@attribute [Authorize]
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IBookService BookService
@inject IBookmarkService BookmarkService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(book?.Title ?? "Reader") - Shelfwarden</PageTitle>

@* Full-viewport shell: fixed chrome (toolbar + bottom bar) + flex main row (optional bookmarks
   sidebar + document viewport). Zoom/transform never applies to chrome — only pdf.js canvas scale
   or epub.js typography inside `.reader-document-content`. *@
@* Reader dark mode lives as a `reader-dark` class on <html> (set pre-paint by theme-init.js and
   toggled via JS), not here — that's what stops the light→dark flash when the reader opens. *@
<div class="reader-shell" @key="Id">
    <header class="reader-topbar reader-toolbar">
        <a class="btn btn-sm btn-outline-secondary border-0" href="@($"books/{Id}")" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="reader-title">
            @(book?.Title ?? "Loading…")
            @if (book is not null && book.Authors.Count > 0)
            {
                <span class="text-secondary small ms-2">@book.Authors[0].Name</span>
            }
        </div>
        @if (book?.FileFormat == EbookFormat.Epub)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToFirstPageAsync" @onclick:preventDefault="true" title="First page (Home)">
                <i class="bi bi-house"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" @onclick:preventDefault="true" title="Previous page (←)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPage" @onclick:preventDefault="true" title="Next page (→)">
                <i class="bi bi-chevron-right"></i>
            </button>
        }
        else if (book?.FileFormat == EbookFormat.Pdf)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="GoToFirstPageAsync" @onclick:preventDefault="true" title="First page (Home)">
                <i class="bi bi-house"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PrevPdfPage" @onclick:preventDefault="true" title="Previous page (←)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPdfPage" @onclick:preventDefault="true" title="Next page (→)">
                <i class="bi bi-chevron-right"></i>
            </button>
        }
        @if (book is not null)
        {
            @if (book.FileFormat != EbookFormat.Unknown)
            {
                <div class="btn-group btn-group-sm reader-zoom-group" role="group" aria-label="Zoom"
                     @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ZoomOutAsync" @onclick:preventDefault="true" title="Zoom out (smaller text / page)">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetZoomAsync" @onclick:preventDefault="true" title="Reset zoom">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ZoomInAsync" @onclick:preventDefault="true" title="Zoom in (larger text / page)">
                        <i class="bi bi-zoom-in"></i>
                    </button>
                </div>

                @* Icon + "active" look are driven entirely by CSS off the ancestor `.reader-dark`
                   class (see site.css) instead of a Blazor-tracked bool — that class is already
                   applied pre-paint by theme-init.js, so this button never needs a JS round-trip
                   + re-render on mount just to know which icon to show (that extra render was a
                   source of visible flicker on mobile). *@
                <button type="button"
                        class="btn btn-sm btn-outline-secondary reader-dark-toggle"
                        @onclick="ToggleReaderDarkModeAsync"
                        title="Toggle reader dark mode">
                    <i class="bi bi-moon-stars reader-dark-toggle-icon-off"></i>
                    <i class="bi bi-sun reader-dark-toggle-icon-on"></i>
                </button>
            }

            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddBookmarkAsync" title="Bookmark this spot">
                <i class="bi bi-bookmark-plus"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary @(showBookmarks ? "active" : null)"
                    @onclick="ToggleBookmarks" title="Bookmarks">
                <i class="bi bi-bookmarks"></i>
                @if (bookmarks.Count > 0)
                {
                    <span class="badge text-bg-secondary ms-1">@bookmarks.Count</span>
                }
            </button>
        }
    </header>

    <div class="reader-main">
        @if (showBookmarks)
        {
            <aside class="reader-sidebar reader-bookmarks-panel" aria-label="Bookmarks">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <strong>Bookmarks</strong>
                    <button class="btn-close" aria-label="Close" @onclick="() => showBookmarks = false"></button>
                </div>
                @if (bookmarks.Count == 0)
                {
                    <p class="text-secondary small mb-0">No bookmarks yet. Use <i class="bi bi-bookmark-plus"></i> in the toolbar to drop one.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var bm in bookmarks)
                        {
                            bool isOpen = expandedBookmarkId == bm.Id;
                            <li class="bookmark-row flex-column align-items-stretch">
                                <div class="d-flex align-items-start w-100">
                                    <button class="btn btn-link p-0 text-start flex-grow-1" @onclick="() => GotoBookmarkAsync(bm)" title="Jump to this spot">
                                        <span class="d-block fw-semibold">@(bm.Title ?? DefaultBookmarkTitle(bm))</span>
                                        <span class="d-block text-secondary small">
                                            @bm.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                            @if (bm.PageNumber.HasValue)
                                            {
                                                <text> · Page @bm.PageNumber</text>
                                            }
                                        </span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary border-0" title="Notes" @onclick="() => ToggleBookmarkNotes(bm)">
                                        <i class="bi bi-journal-text"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary border-0" title="Remove" @onclick="() => DeleteBookmarkAsync(bm)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                                @if (isOpen)
                                {
                                    <div class="w-100 mt-2">
                                        <textarea class="form-control form-control-sm" rows="3"
                                                  placeholder="Add a note…" @bind="bookmarkNoteDraft"></textarea>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <button class="btn btn-sm btn-primary" disabled="@bookmarkNoteSaving"
                                                    @onclick="() => SaveBookmarkNoteAsync(bm)">Save</button>
                                            @if (bookmarkNoteFlash is not null)
                                            {
                                                <span class="text-success small">@bookmarkNoteFlash</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </aside>
        }

        <div class="reader-document-viewport">
            <div class="reader-document-content">
                @if (loadError is not null)
                {
                    <div class="empty-state reader-document-empty">
                        <i class="bi bi-exclamation-triangle empty-icon"></i>
                        <h3>@loadError</h3>
                        <a class="btn btn-outline-secondary" href="books"><i class="bi bi-arrow-left"></i> Back to books</a>
                    </div>
                }
                else if (book is null)
                {
                    <div class="text-center text-secondary py-5 reader-document-empty">
                        <div class="spinner-border" role="status"></div>
                        <div class="mt-2">Loading book…</div>
                    </div>
                }
                else if (book.FileFormat == EbookFormat.Epub)
                {
                    <div id="epub-viewer" class="reader-format-host" @onkeydown="HandleKeyDown" tabindex="0"></div>
                }
                else if (book.FileFormat == EbookFormat.Pdf)
                {
                    <div id="pdf-viewer" class="reader-format-host pdf-scroll-root" tabindex="0" @onkeydown="HandlePdfKeyDown"></div>
                }
                else
                {
                    <div class="empty-state reader-document-empty">
                        <i class="bi bi-file-earmark-x empty-icon"></i>
                        <h3>Unsupported format</h3>
                        <p>Shelfwarden currently supports EPUB and PDF.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <footer class="reader-bottombar">
        @if (book?.FileFormat == EbookFormat.Epub)
        {
            <span class="text-secondary">
                <i class="bi bi-bookmark"></i>
                @(progressPercent.HasValue ? $"{progressPercent.Value:0}% read" : "Tracking progress…")
            </span>
        }
        else if (book?.FileFormat == EbookFormat.Pdf)
        {
            <span class="text-secondary">
                <i class="bi bi-bookmark"></i>
                @if (pdfPageCount > 0)
                {
                    <text>Page @pdfCurrentPage of @pdfPageCount</text>
                    @if (progressPercent.HasValue)
                    {
                        <span class="ms-2">@($"({progressPercent.Value:0}% read)")</span>
                    }
                }
                else
                {
                    <text>Loading…</text>
                }
            </span>
        }
        @if (lastSavedAt.HasValue)
        {
            <span class="ms-auto text-secondary small">
                <i class="bi bi-cloud-check"></i> Saved @FormatRelative(lastSavedAt.Value)
            </span>
        }
    </footer>
</div>
