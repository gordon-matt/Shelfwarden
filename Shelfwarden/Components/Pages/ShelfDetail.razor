@page "/shelves/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@implements IAsyncDisposable
@inject IShelfService ShelfService
@inject IBookService BookService
@inject IScanStatusService ScanStatusService
@inject ISidebarNavRefreshService SidebarNavRefresh
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<PageTitle>@(shelf?.Name ?? "Shelf") - Shelfwarden</PageTitle>

@if (shelf is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">@shelf.Name</h1>
            @if (!string.IsNullOrEmpty(shelf.Description))
            {
                <p class="text-body-secondary mb-0">@shelf.Description</p>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
                <button type="button"
                        class="btn @(viewMode == ViewMode.Grid ? "btn-primary" : "btn-outline-secondary")"
                        title="Grid view" @onclick="() => viewMode = ViewMode.Grid">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </button>
                <button type="button"
                        class="btn @(viewMode == ViewMode.List ? "btn-primary" : "btn-outline-secondary")"
                        title="List view" @onclick="() => viewMode = ViewMode.List">
                    <i class="bi bi-list-ul"></i>
                </button>
            </div>
        <AuthorizeView Roles="@Constants.Roles.Administrator">
            <Authorized>
                <div>
                    <button class="btn btn-outline-primary me-1"
                            @onclick="GoToBatchEdit"
                            disabled="@(selectedBookIds.Count == 0)">
                        <i class="bi bi-pencil-square"></i> Batch edit (@selectedBookIds.Count)
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ScanAsync">
                        <i class="bi bi-arrow-clockwise"></i> Scan
                    </button>
                    <a class="btn btn-outline-secondary ms-1" href="@($"shelves/{Id}/edit")">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <button class="btn btn-outline-danger ms-1" @onclick="DeleteAsync">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
        </div>
    </div>
    @if (scanIndicatorVisible)
    {
        <div class="scan-progress mb-3">
            <div class="progress" role="progressbar" aria-label="Scanning" style="height: 4px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                     style="width: 100%"></div>
            </div>
            <div class="small text-body-secondary mt-1">
                <i class="bi bi-hourglass-split"></i> Scan queued and running in the background...
            </div>
        </div>
    }

    <div class="book-browse-layout">
        <div class="book-browse-content">
            @if (isLoadingMoreBooks && books.Count == 0)
            {
                <p><em>Loading books...</em></p>
            }
            else if (books.Count == 0)
            {
                @if (string.IsNullOrWhiteSpace(startsWithFilter))
                {
                    <div class="alert alert-info">No books on this shelf yet. Run a scan to populate it.</div>
                }
                else
                {
                    <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2">
                        <span>No books on this shelf match the <strong>@startsWithFilter</strong> filter.</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLetterFilterAsync">
                            Show all
                        </button>
                    </div>
                }
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(startsWithFilter))
                {
                    <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLetterFilterAsync">
                            <i class="bi bi-x-circle"></i> Clear title filter
                        </button>
                    </div>
                }
                <div class="selection-toolbar mb-3 d-flex flex-wrap align-items-center gap-2">
                    <span class="text-secondary small">
                        <i class="bi bi-check2-square"></i> @selectedBookIds.Count selected
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllVisible" disabled="@(books.Count == 0)">
                        <i class="bi bi-ui-checks"></i> Select visible
                    </button>
                    @if (CanSelectAllMatching)
                    {
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="SelectAllMatchingAsync"
                                disabled="@(totalBookCount == 0 || selectAllMatchingBusy)">
                            @if (selectAllMatchingBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-check2-all"></i>
                            }
                            Select all@(totalBookCount > 0 ? $" ({totalBookCount})" : "")
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                    <BulkBookActions SelectedBookIds="selectedBookIds" />
                </div>
                @if (viewMode == ViewMode.List)
                {
                    <div class="book-list">
                        @foreach (var book in books)
                        {
                            <div class="book-list-wrap @(selectedBookIds.Contains(book.Id) ? "selected" : "")">
                                <input class="form-check-input book-list-select" type="checkbox"
                                       checked="@selectedBookIds.Contains(book.Id)"
                                       @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                                <BookListRow Book="book"
                                             SelectionMode="selectedBookIds.Count > 0"
                                             IsSelected="selectedBookIds.Contains(book.Id)"
                                             OnSelectionToggled="checkedNow => ToggleSelection(book.Id, checkedNow)" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="book-grid">
                        @foreach (var book in books)
                        {
                            <div class="book-card-wrap @(selectedBookIds.Contains(book.Id) ? "selected" : "")">
                                <input class="form-check-input book-card-select" type="checkbox"
                                       checked="@selectedBookIds.Contains(book.Id)"
                                       @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                                <BookCard Book="book"
                                          SelectionMode="selectedBookIds.Count > 0"
                                          IsSelected="selectedBookIds.Contains(book.Id)"
                                          OnSelectionToggled="checkedNow => ToggleSelection(book.Id, checkedNow)" />
                            </div>
                        }
                    </div>
                }

                @if (hasMoreBooks || isLoadingMoreBooks)
                {
                    <div class="text-center py-3">
                        @if (isLoadingMoreBooks)
                        {
                            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                            <span class="ms-2 text-secondary small">Loading more books...</span>
                        }
                        <div class="infinite-scroll-sentinel" @ref="infiniteScrollSentinel"></div>
                    </div>
                }
            }
        </div>

        <BookLetterRail @bind-StartsWith="startsWithFilter" @bind-StartsWith:after="OnLetterRailChangedAsync" />
    </div>
}
