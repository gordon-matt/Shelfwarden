@page "/libraries/{Id:int}"
@attribute [Authorize]
@implements IDisposable
@inject ILibraryService LibraryService
@inject IBookService BookService
@inject IScanStatusService ScanStatusService
@inject ISidebarNavRefreshService SidebarNavRefresh
@inject NavigationManager NavigationManager

<PageTitle>@(library?.Name ?? "Library") - Shelfwarden</PageTitle>

@if (library is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">@library.Name</h1>
            @if (!string.IsNullOrEmpty(library.Description))
            {
                <p class="text-body-secondary mb-0">@library.Description</p>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
                <button type="button"
                        class="btn @(viewMode == ViewMode.Grid ? "btn-primary" : "btn-outline-secondary")"
                        title="Grid view" @onclick="() => viewMode = ViewMode.Grid">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </button>
                <button type="button"
                        class="btn @(viewMode == ViewMode.List ? "btn-primary" : "btn-outline-secondary")"
                        title="List view" @onclick="() => viewMode = ViewMode.List">
                    <i class="bi bi-list-ul"></i>
                </button>
            </div>
        <AuthorizeView Roles="@Constants.Roles.Administrator">
            <Authorized>
                <div>
                    <button class="btn btn-outline-primary me-1"
                            @onclick="GoToBatchEdit"
                            disabled="@(selectedBookIds.Count == 0)">
                        <i class="bi bi-pencil-square"></i> Batch edit (@selectedBookIds.Count)
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ScanAsync">
                        <i class="bi bi-arrow-clockwise"></i> Scan
                    </button>
                    <a class="btn btn-outline-secondary ms-1" href="@($"libraries/{Id}/edit")">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <button class="btn btn-outline-danger ms-1" @onclick="DeleteAsync">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
        </div>
    </div>
    @if (scanIndicatorVisible)
    {
        <div class="scan-progress mb-3">
            <div class="progress" role="progressbar" aria-label="Scanning" style="height: 4px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                     style="width: 100%"></div>
            </div>
            <div class="small text-body-secondary mt-1">
                <i class="bi bi-hourglass-split"></i> Scan queued and running in the background...
            </div>
        </div>
    }

    @if (books is null)
    {
        <p><em>Loading books...</em></p>
    }
    else if (books.Items.Count == 0)
    {
        <div class="alert alert-info">No books in this library yet. Run a scan to populate it.</div>
    }
    else
    {
        <div class="selection-toolbar mb-3">
            <span class="text-secondary small">
                <i class="bi bi-check2-square"></i> @selectedBookIds.Count selected
            </span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllOnPage">
                <i class="bi bi-list-check"></i> Select page
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
                <i class="bi bi-x-circle"></i> Clear
            </button>
        </div>
        @if (viewMode == ViewMode.List)
        {
            <div class="book-list">
                @foreach (var book in books.Items)
                {
                    <div class="book-list-wrap @(selectedBookIds.Contains(book.Id) ? "selected" : "")">
                        <input class="form-check-input book-list-select" type="checkbox"
                               checked="@selectedBookIds.Contains(book.Id)"
                               @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                        <BookListRow Book="book" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in books.Items)
                {
                    <div class="book-card-wrap @(selectedBookIds.Contains(book.Id) ? "selected" : "")">
                        <input class="form-check-input book-card-select" type="checkbox"
                               checked="@selectedBookIds.Contains(book.Id)"
                               @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                        <BookCard Book="book" />
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private LibraryDto? library;
    private PagedList<BookListItemDto>? books;
    private readonly HashSet<int> selectedBookIds = [];
    private ViewMode viewMode = ViewMode.Grid;
    private bool scanIndicatorVisible;
    private DateTime? optimisticBusyUntilUtc;
    private CancellationTokenSource? pollCts;
    private enum ViewMode { Grid, List }

    protected override async Task OnParametersSetAsync()
    {
        var lib = await LibraryService.GetByIdAsync(Id);
        library = lib.IsSuccess ? lib.Value : null;

        if (library is not null)
        {
            var bookResult = await BookService.SearchAsync(new BookSearchRequest
            {
                LibraryId = Id,
                Page = 1,
                PageSize = 48,
                SortBy = BookSortBy.Title,
            });
            books = bookResult.IsSuccess ? bookResult.Value : null;
            selectedBookIds.Clear();
        }
    }

    protected override void OnInitialized()
    {
        pollCts = new CancellationTokenSource();
        _ = Task.Run(() => PollLoopAsync(pollCts.Token));
    }

    private async Task ScanAsync()
    {
        scanIndicatorVisible = true;
        optimisticBusyUntilUtc = DateTime.UtcNow.AddSeconds(20);
        StateHasChanged();
        var result = await LibraryService.ScheduleScanAsync(Id);
        if (!result.IsSuccess)
        {
            scanIndicatorVisible = false;
            optimisticBusyUntilUtc = null;
        }
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(1.5), token);
                if (token.IsCancellationRequested) break;
                await RefreshScanIndicatorAsync(token);
            }
            catch (TaskCanceledException)
            {
                break;
            }
        }
    }

    private async Task RefreshScanIndicatorAsync(CancellationToken cancellationToken)
    {
        var statusResult = await ScanStatusService.GetForLibraryAsync(Id, cancellationToken);
        if (!statusResult.IsSuccess) return;

        var status = statusResult.Value;
        bool optimisticBusy = optimisticBusyUntilUtc is { } until && until > DateTime.UtcNow;
        bool busy = IsBusy(status) || optimisticBusy;
        bool changed = scanIndicatorVisible != busy;
        scanIndicatorVisible = busy;

        // Scan just finished: refresh library + books so last-scan timestamp/counts are current.
        if (!IsBusy(status) && !optimisticBusy && changed && library is not null)
        {
            optimisticBusyUntilUtc = null;
            await OnParametersSetAsync();
        }

        // Once the backend reports real busy state, we no longer need optimistic hold.
        if (IsBusy(status))
        {
            optimisticBusyUntilUtc = null;
        }

        if (changed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsBusy(ScanStatusDto? status)
        => status is not null && (status.State == ScanState.Running || status.State == ScanState.Queued);

    private async Task DeleteAsync()
    {
        var result = await LibraryService.DeleteAsync(Id);
        if (result.IsSuccess)
        {
            SidebarNavRefresh.NotifyNavigationDataChanged();
            NavigationManager.NavigateTo("libraries");
        }
    }

    private void ToggleSelection(int id, bool include)
    {
        if (include) selectedBookIds.Add(id);
        else selectedBookIds.Remove(id);
    }

    private void SelectAllOnPage()
    {
        if (books is null) return;
        foreach (var b in books.Items) selectedBookIds.Add(b.Id);
    }

    private void ClearSelection() => selectedBookIds.Clear();

    private void GoToBatchEdit()
    {
        if (selectedBookIds.Count == 0) return;
        string ids = string.Join(',', selectedBookIds);
        NavigationManager.NavigateTo($"books/batch-edit?ids={ids}&return=libraries/{Id}");
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
    }
}
