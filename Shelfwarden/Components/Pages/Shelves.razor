@page "/shelves"
@attribute [Authorize]
@implements IDisposable
@using Shelfwarden.Infrastructure
@inject IShelfService ShelfService
@inject IScanStatusService ScanStatusService
@inject NavigationManager NavigationManager
@inject ILogger<Shelves> ShelvesLogger

<PageTitle>Shelves - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Shelves</h1>
    <AuthorizeView Roles="@Constants.Roles.Administrator">
        <Authorized>
            <a class="btn btn-primary" href="shelves/new">
                <i class="bi bi-plus-lg"></i> New shelf
            </a>
        </Authorized>
    </AuthorizeView>
</div>

@if (shelves is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading shelves…</div>
    </div>
}
else if (shelves.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-collection empty-icon"></i>
        <h3>No shelves yet</h3>
        <p>Administrators can create a shelf pointed at one or more folders to start indexing books.</p>
        <AuthorizeView Roles="@Constants.Roles.Administrator">
            <Authorized>
                <a class="btn btn-primary" href="shelves/new">
                    <i class="bi bi-plus-lg"></i> Create a shelf
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var lib in shelves)
        {
            var status = GetStatus(lib.Id);
            bool showBusy = IsBusy(status) || HasOptimisticBusy(lib.Id);
            <div class="col-md-6 col-lg-3">
                <div class="shelf-tile">
                    <a href="@($"shelves/{lib.Id}")" class="shelf-tile-banner text-decoration-none">
                        <ShelfTileBanner Preview="lib.Banner" FallbackIconClass="bi bi-bookshelf" />
                    </a>
                    <div class="card-body">
                        <h5 class="card-title d-flex justify-content-between align-items-start mb-2">
                            <a href="@($"shelves/{lib.Id}")" class="text-decoration-none text-reset">@lib.Name</a>
                            @RenderStatusBadge(status)
                        </h5>
                        @if (!string.IsNullOrEmpty(lib.Description))
                        {
                            <p class="card-text small text-body-secondary mb-2">@lib.Description</p>
                        }
                        <p class="card-text small mb-2">
                            <span class="chip"><i class="bi bi-book"></i> @lib.BookCount book@(lib.BookCount == 1 ? "" : "s")</span>
                            @if (lib.LastScannedAt.HasValue)
                            {
                                <span class="chip ms-1"
                                      title="@lib.LastScannedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")">
                                    <i class="bi bi-clock-history"></i> @FormatRelative(lib.LastScannedAt.Value)
                                </span>
                            }
                        </p>
                        @if (status?.Progress is { } prog || showBusy)
                        {
                            <div class="scan-progress mb-2">
                                <div class="progress" role="progressbar" aria-label="Scanning" style="height: 4px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                                         style="width: 100%"></div>
                                </div>
                                @if (status?.Progress is { } progress)
                                {
                                    <div class="d-flex flex-wrap gap-2 small mt-1 text-body-secondary">
                                        <span><i class="bi bi-files"></i> @progress.FilesScanned scanned</span>
                                        @if (progress.BooksAdded > 0)
                                        {
                                            <span class="text-success">+@progress.BooksAdded added</span>
                                        }
                                        @if (progress.BooksUpdated > 0)
                                        {
                                            <span class="text-info">~@progress.BooksUpdated updated</span>
                                        }
                                        @if (progress.Errors > 0)
                                        {
                                            <span class="text-danger">@progress.Errors error@(progress.Errors == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(progress.CurrentFile))
                                    {
                                        <div class="small text-body-secondary text-truncate" title="@progress.CurrentFile">
                                            <i class="bi bi-file-earmark"></i> @progress.CurrentFile
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="small text-body-secondary mt-1">
                                        <i class="bi bi-hourglass-split"></i> Scan queued — waiting for status...
                                    </div>
                                }
                            </div>
                        }
                        @if (lib.Folders.Count > 0)
                        {
                            <ul class="list-unstyled small mb-0 text-body-secondary">
                                @foreach (var f in lib.Folders)
                                {
                                    <li class="text-truncate" title="@f.Path"><i class="bi bi-folder me-1"></i>@f.Path</li>
                                }
                            </ul>
                        }
                    </div>
                    <AuthorizeView Roles="@Constants.Roles.Administrator">
                        <Authorized>
                            <div class="card-footer bg-transparent">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ScanAsync(lib.Id)"
                                        disabled="@showBusy">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    @(showBusy ? "Scanning..." : "Scan")
                                </button>
                                <a class="btn btn-sm btn-outline-secondary ms-1" href="@($"shelves/{lib.Id}/edit")">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>
}
