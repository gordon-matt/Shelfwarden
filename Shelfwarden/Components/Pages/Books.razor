@page "/books"
@attribute [Authorize]
@inject IBookService BookService
@inject ILibraryService LibraryService
@inject IAuthorService AuthorService
@inject ISeriesService SeriesService
@inject IGenreService GenreService
@inject NavigationManager NavigationManager

<PageTitle>Books - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Books</h1>
    <div class="d-flex align-items-center gap-3">
        @if (results is not null)
        {
            <span class="text-secondary small">@results.TotalCount result@(results.TotalCount == 1 ? "" : "s")</span>
        }
        <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
            <button type="button"
                    class="btn @(viewMode == ViewMode.Grid ? "btn-primary" : "btn-outline-secondary")"
                    title="Grid view" @onclick="() => SetViewMode(ViewMode.Grid)">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>
            <button type="button"
                    class="btn @(viewMode == ViewMode.List ? "btn-primary" : "btn-outline-secondary")"
                    title="List view" @onclick="() => SetViewMode(ViewMode.List)">
                <i class="bi bi-list-ul"></i>
            </button>
        </div>
        <button type="button"
                class="btn btn-sm @(selectMode ? "btn-primary" : "btn-outline-secondary")"
                title="Toggle select mode"
                @onclick="ToggleSelectMode">
            <i class="bi bi-check2-square"></i>
            @if (selectMode)
            {
                <span class="ms-1">@selectedBookIds.Count selected</span>
            }
            else
            {
                <span class="ms-1">Select</span>
            }
        </button>
    </div>
</div>

@if (selectMode)
{
    <div class="selection-toolbar mb-3">
        <span class="text-secondary small">
            <i class="bi bi-check2-square"></i> @selectedBookIds.Count selected
        </span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllOnPage" disabled="@(results is null || results.Items.Count == 0)">
            <i class="bi bi-list-check"></i> Select page
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection" disabled="@(selectedBookIds.Count == 0)">
            <i class="bi bi-x-circle"></i> Clear
        </button>
        <button class="btn btn-sm btn-primary ms-auto" @onclick="GoToBatchEdit" disabled="@(selectedBookIds.Count == 0)">
            <i class="bi bi-pencil-square"></i> Batch edit
        </button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <label class="form-label small text-body-secondary mb-1">Search</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search by title..." @bind="query" @bind:event="oninput" @onkeyup="OnQueryKeyUp" />
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-body-secondary mb-1">Sort</label>
        <select class="form-select" @bind="sortBy">
            <option value="@BookSortBy.Title">Title</option>
            <option value="@BookSortBy.AddedAt">Date added</option>
            <option value="@BookSortBy.UpdatedAt">Date updated</option>
            <option value="@BookSortBy.PublishedOn">Published date</option>
            <option value="@BookSortBy.NumberInSeries">Series order</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-body-secondary mb-1" for="sortDesc">Order</label>
        <div class="form-check form-switch mt-0">
            <input class="form-check-input" type="checkbox" id="sortDesc" @bind="sortDescending" />
            <label class="form-check-label" for="sortDesc">Descending</label>
        </div>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <label class="form-label small text-body-secondary mb-1">Library</label>
        <select class="form-select form-select-sm" @bind="libraryId">
            <option value="">All libraries</option>
            @foreach (var lib in libraries)
            {
                <option value="@lib.Id">@lib.Name</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label small text-body-secondary mb-1">Author</label>
        <select class="form-select form-select-sm" @bind="authorId">
            <option value="">Any author</option>
            @foreach (var a in authors)
            {
                <option value="@a.Id">@a.Name</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label small text-body-secondary mb-1">Series</label>
        <select class="form-select form-select-sm" @bind="seriesId">
            <option value="">Any series</option>
            @foreach (var s in series)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label small text-body-secondary mb-1">Genre</label>
        <select class="form-select form-select-sm" @bind="genreId">
            <option value="">Any genre</option>
            @foreach (var g in genres)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-3 d-flex align-items-end">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="awaitingReview" @bind="awaitingReview" />
            <label class="form-check-label" for="awaitingReview">Awaiting Review</label>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mb-3">
    @if (HasActiveFilters)
    {
        <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">
            <i class="bi bi-x-circle"></i> Clear
        </button>
    }
    <button class="btn btn-primary" @onclick="ApplyFilters">
        <i class="bi bi-funnel"></i> Apply
    </button>
</div>

@if (results is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading books…</div>
    </div>
}
else if (results.Items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-search empty-icon"></i>
        <h3>No matching books</h3>
        <p>
            @if (HasActiveFilters)
            {
                <span>Try clearing some filters or running a library scan to import more books.</span>
            }
            else
            {
                <span>You don't have any books yet. <a href="libraries">Add a library</a> to get started.</span>
            }
        </p>
        @if (HasActiveFilters)
        {
            <button class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">
                <i class="bi bi-x-circle"></i> Clear filters
            </button>
        }
    </div>
}
else
{
    @if (viewMode == ViewMode.List)
    {
        <div class="book-list">
            @foreach (var book in results.Items)
            {
                <div class="book-list-wrap @(selectMode && selectedBookIds.Contains(book.Id) ? "selected" : "")">
                    @if (selectMode)
                    {
                        <input class="form-check-input book-list-select" type="checkbox"
                               checked="@selectedBookIds.Contains(book.Id)"
                               @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                    }
                    <BookListRow Book="book" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="book-grid">
            @foreach (var book in results.Items)
            {
                <div class="book-card-wrap @(selectMode && selectedBookIds.Contains(book.Id) ? "selected" : "")">
                    @if (selectMode)
                    {
                        <input class="form-check-input book-card-select" type="checkbox"
                               checked="@selectedBookIds.Contains(book.Id)"
                               @onchange="e => ToggleSelection(book.Id, (bool)(e.Value ?? false))" />
                    }
                    <BookCard Book="book" />
                </div>
            }
        </div>
    }

    <nav class="mt-4 d-flex justify-content-between align-items-center" aria-label="Books pagination">
        <small class="text-body-secondary">
            Showing @((pageNumber - 1) * pageSize + 1)–@Math.Min(pageNumber * pageSize, results.TotalCount)
            of @results.TotalCount
        </small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoTo(pageNumber - 1)" disabled="@(pageNumber <= 1)">Previous</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@pageNumber / @Math.Max(results.TotalPages, 1)</span>
            </li>
            <li class="page-item @(pageNumber >= results.TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoTo(pageNumber + 1)" disabled="@(pageNumber >= results.TotalPages)">Next</button>
            </li>
        </ul>
    </nav>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryFromUrl { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewFromUrl { get; set; }

    [SupplyParameterFromQuery(Name = "series")]
    public int? SeriesFromUrl { get; set; }

    [SupplyParameterFromQuery(Name = "author")]
    public int? AuthorFromUrl { get; set; }

    private enum ViewMode { Grid, List }

    private PagedList<BookListItemDto>? results;
    private string? query;
    private string libraryId = "";
    private string authorId = "";
    private string seriesId = "";
    private string genreId = "";
    private bool awaitingReview;
    private BookSortBy sortBy = BookSortBy.Title;
    private bool sortDescending;
    private int pageNumber = 1;
    private ViewMode viewMode = ViewMode.Grid;
    private int pageSize = 24;

    private bool selectMode;
    private readonly HashSet<int> selectedBookIds = [];

    private IReadOnlyList<LibraryDto> libraries = [];
    private IReadOnlyList<AuthorDto> authors = [];
    private IReadOnlyList<SeriesDto> series = [];
    private IReadOnlyList<GenreDto> genres = [];

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(libraryId)
        || !string.IsNullOrEmpty(authorId)
        || !string.IsNullOrEmpty(seriesId)
        || !string.IsNullOrEmpty(genreId)
        || awaitingReview
        || !string.IsNullOrWhiteSpace(query);

    protected override async Task OnInitializedAsync()
    {
        // Load filter options + first page in parallel — they're independent queries.
        var librariesTask = LibraryService.GetAllAsync();
        var authorsTask = AuthorService.SearchAsync(null, limit: 200);
        var seriesTask = SeriesService.SearchAsync(null, limit: 200);
        var genresTask = GenreService.SearchAsync(null, limit: 200);

        await Task.WhenAll(librariesTask, authorsTask, seriesTask, genresTask);

        if (librariesTask.Result.IsSuccess) libraries = librariesTask.Result.Value;
        if (authorsTask.Result.IsSuccess) authors = authorsTask.Result.Value;
        if (seriesTask.Result.IsSuccess) series = seriesTask.Result.Value;
        if (genresTask.Result.IsSuccess) genres = genresTask.Result.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        // The topbar search posts its term as ?q=… — pick that up so search drops the user
        // straight onto a filtered books grid.
        if (!string.IsNullOrWhiteSpace(QueryFromUrl) && QueryFromUrl != query)
        {
            query = QueryFromUrl;
            pageNumber = 1;
        }
        if (string.Equals(ViewFromUrl, "list", StringComparison.OrdinalIgnoreCase))
        {
            viewMode = ViewMode.List;
            pageSize = 12;
        }
        // ?series= and ?author= make the books grid composable from author/series pages.
        if (SeriesFromUrl is { } sId && seriesId != sId.ToString())
        {
            seriesId = sId.ToString();
            pageNumber = 1;
        }
        if (AuthorFromUrl is { } aId && authorId != aId.ToString())
        {
            authorId = aId.ToString();
            pageNumber = 1;
        }
        await LoadAsync();
    }

    private async Task SetViewMode(ViewMode mode)
    {
        if (viewMode == mode) return;
        viewMode = mode;
        // List rows are larger so render fewer per page; grid uses the dense default.
        pageSize = mode == ViewMode.List ? 12 : 24;
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await BookService.SearchAsync(new BookSearchRequest
        {
            Page = pageNumber,
            PageSize = pageSize,
            Query = string.IsNullOrWhiteSpace(query) ? null : query,
            LibraryId = ParseId(libraryId),
            AuthorId = ParseId(authorId),
            SeriesId = ParseId(seriesId),
            GenreId = ParseId(genreId),
            AwaitingReview = awaitingReview,
            SortBy = sortBy,
            SortDescending = sortDescending,
        });

        results = result.IsSuccess ? result.Value : new PagedList<BookListItemDto>([], 0, pageNumber, pageSize);
    }

    private async Task ApplyFilters()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        query = null;
        libraryId = "";
        authorId = "";
        seriesId = "";
        genreId = "";
        awaitingReview = false;
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnQueryKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task GoTo(int target)
    {
        if (results is null) return;
        if (target < 1 || target > results.TotalPages) return;
        pageNumber = target;
        await LoadAsync();
    }

    private void ToggleSelectMode()
    {
        selectMode = !selectMode;
        if (!selectMode) selectedBookIds.Clear();
    }

    private void ToggleSelection(int id, bool include)
    {
        if (include) selectedBookIds.Add(id);
        else selectedBookIds.Remove(id);
    }

    private void SelectAllOnPage()
    {
        if (results is null) return;
        foreach (var b in results.Items) selectedBookIds.Add(b.Id);
    }

    private void ClearSelection() => selectedBookIds.Clear();

    private void GoToBatchEdit()
    {
        if (selectedBookIds.Count == 0) return;
        string ids = string.Join(',', selectedBookIds);
        // Round-trip back to the books page (preserving the current URL ish — simplest is /books).
        NavigationManager.NavigateTo($"books/batch-edit?ids={ids}&return=books");
    }

    private static int? ParseId(string raw) =>
        int.TryParse(raw, out int id) && id > 0 ? id : null;
}
