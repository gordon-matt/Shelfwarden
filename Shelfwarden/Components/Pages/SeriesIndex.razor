@page "/series"
@attribute [Authorize]
@inject ISeriesService SeriesService
@inject IUniverseService UniverseService
@inject IJSRuntime JS

<PageTitle>Series - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Series</h1>
    @if (series is not null)
    {
        <span class="text-secondary small">@series.Count series</span>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input class="form-control" placeholder="Search series..." @bind="query" @bind:event="oninput" @onkeyup="OnQueryKeyUp" />
        </div>
    </div>
</div>

@if (series is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading series…</div>
    </div>
}
else if (series.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-collection empty-icon"></i>
        <h3>No series yet</h3>
        <p>When books are scanned and assigned to a series, they will appear here.</p>
    </div>
}
else
{
    <div class="book-grid">
        @foreach (var s in series)
        {
            <div class="series-tile-shell">
                <a class="series-tile" href="@($"series/{s.Id}")" title="@s.Name">
                    @* Wrap the collage in a positioning container so the three-dot toggle can be
                       pinned to its bottom-right (matching BookCard) without having to know the
                       variable height of the title/count body underneath. *@
                    <div class="series-tile-cover">
                        <SeriesCollage Covers="s.Covers" />
                        <div class="series-tile-menu dropend">
                            <button type="button"
                                    class="btn btn-sm series-tile-menu-toggle"
                                    data-bs-toggle="dropdown"
                                    data-bs-config='{"popperConfig":{"strategy":"fixed"}}'
                                    aria-expanded="false"
                                    aria-label="Series actions"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <AddToActions SeriesId="s.Id" SubjectName="@s.Name" />
                                <AuthorizeView Roles="@Constants.Roles.Administrator">
                                    <Authorized>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    @onclick="() => OpenEditModal(s)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick:preventDefault="true">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger"
                                                    @onclick="() => ConfirmDeleteSeriesAsync(s)"
                                                    @onclick:stopPropagation="true"
                                                    @onclick:preventDefault="true">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                            </ul>
                        </div>
                    </div>
                    <div class="series-tile-body">
                        <div class="series-tile-name text-truncate">@s.Name</div>
                        <div class="series-tile-count text-secondary small">
                            @s.BookCount book@(s.BookCount == 1 ? "" : "s")
                        </div>
                        @if (!string.IsNullOrEmpty(s.UniverseName))
                        {
                            <div class="series-tile-count text-secondary small text-truncate">
                                <i class="bi bi-stars"></i> @s.UniverseName
                            </div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
}

@if (editModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit series</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    @if (editError is not null)
                    {
                        <div class="alert alert-danger py-2">@editError</div>
                    }
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editSeriesName" maxlength="256" />

                    <label class="form-label mt-3">Universe</label>
                    <select class="form-select" @bind="editUniverseId">
                        <option value="0">— None —</option>
                        @foreach (var u in universeOptions)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>

                    @if (editUniverseId > 0 && editUniverseId != originalUniverseId)
                    {
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="addSeriesBooksToUniverse"
                                   @bind="addSeriesBooksToUniverse" />
                            <label class="form-check-label" for="addSeriesBooksToUniverse">
                                Also add this series' books to the universe timeline
                            </label>
                        </div>
                        <div class="form-text">
                            Book membership stays explicit after this — later additions to the series won't
                            join the universe automatically.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveEditAsync" disabled="@editSaving">
                        @if (editSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
