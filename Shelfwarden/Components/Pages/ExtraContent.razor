@page "/extra-content"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@implements IAsyncDisposable
@inject IAdditionalContentService ContentService
@inject IAuthorService AuthorService
@inject ISeriesService SeriesService
@inject IJSRuntime JSRuntime

<PageTitle>Extra Content - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="mb-0">Extra Content</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenAddContentPicker"
                disabled="@(scanning || addContentBusy)" title="Register files already on disk (paths are not moved)">
            @if (addContentBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-plus-lg me-1"></i>
            }
            Add content
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ScanExtrasAsync" disabled="@(scanning || addContentBusy)">
            @if (scanning)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <text>Scanning...</text>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-1"></i>
                <text>Scan _extras folder</text>
            }
        </button>
    </div>
</div>

@if (scanMessage is not null)
{
    <div class="alert alert-info py-2 mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-info-circle"></i> @scanMessage
    </div>
}
@if (actionMessage is not null)
{
    <div class="alert alert-success py-2 mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle"></i> @actionMessage
    </div>
}
@if (actionError is not null)
{
    <div class="alert alert-danger py-2 mb-3">@actionError</div>
}

@* Filters *@
<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Author</label>
        <select class="form-select" @bind="authorFilter" @bind:after="OnFiltersChangedAsync">
            <option value="-1">None (unassigned)</option>
            <option value="0">Any</option>
            @if (authors is not null)
            {
                @foreach (var a in authors)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Series</label>
        <select class="form-select" @bind="seriesFilter" @bind:after="OnFiltersChangedAsync">
            <option value="-1">None (no series)</option>
            <option value="0">Any</option>
            @if (seriesList is not null)
            {
                @foreach (var s in seriesList)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Tag</label>
        <select class="form-select" @bind="tagFilterMode" @bind:after="OnTagModeChangedAsync">
            <option value="@TagFilterMode.Any">Any</option>
            <option value="@TagFilterMode.None">None</option>
            <option value="@TagFilterMode.Selected">Selected</option>
        </select>
    </div>
    @if (tagFilterMode == TagFilterMode.Selected)
    {
        <div class="col-md-8">
            <label class="form-label">Selected tags (must match all)</label>
            <ChipInput TItem="AdditionalContentTagDto"
                       Label="Tags"
                       Selected="selectedTagFilters"
                       ChipCssSuffix="chip-tag"
                       NameOf="(t => t.Name)"
                       SearchAsync="SearchTagFilterOptionsAsync"
                       OnAddAsync="AddTagFilterAsync"
                       AllowCreate="false"
                       OnChanged="OnFiltersChangedAsync" />
        </div>
    }
</div>

@* Bulk actions bar *@
@if (selectedIds.Count > 0)
{
    <div class="d-flex align-items-center gap-2 mb-3 p-2 bg-body-secondary rounded">
        <span class="small fw-semibold">@selectedIds.Count selected</span>
        <button type="button" class="btn btn-sm btn-danger" @onclick="BulkDeleteAsync" disabled="@bulkActionBusy">
            @if (bulkActionBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            <i class="bi bi-trash me-1"></i> Delete all
        </button>
        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenBulkAssign" disabled="@bulkActionBusy">
            <i class="bi bi-person-plus me-1"></i> Assign to Author
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenBulkTags" disabled="@bulkActionBusy">
            <i class="bi bi-tags me-1"></i> Edit tags
        </button>
    </div>
}

@if ((isLoadingMore && loadedItems.Count == 0) || (gridReloadPending && loadedItems.Count == 0))
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading...</div>
    </div>
}
else if (loadedItems.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-folder2 empty-icon"></i>
        <h3>No extra content</h3>
        <p>Drop files into the <code>_extras</code> folder and click &quot;Scan _extras folder&quot;, or use <strong>Add content</strong> to register files elsewhere on disk.</p>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="selectAll"
                   @bind="allSelected"
                   @bind:after="ToggleSelectAll" />
            <label class="form-check-label" for="selectAll">Select all (visible)</label>
        </div>
        <span class="text-secondary small">
            @totalCount total · showing @loadedItems.Count loaded
        </span>
    </div>

    <div class="extra-content-admin-grid">
        @foreach (var item in loadedItems)
        {
            <div class="content-admin-card @(selectedIds.Contains(item.Id) ? "selected" : "")">
                <div class="form-check content-admin-check" @onclick:stopPropagation="true">
                    <input class="form-check-input" type="checkbox"
                           id="@($"extra-admin-{item.Id}")"
                           checked="@selectedIds.Contains(item.Id)"
                           @onchange="e => ToggleItem(item.Id, (bool)(e.Value ?? false))" />
                </div>
                <div class="content-admin-card-hit @(selectedIds.Count > 0 ? "content-admin-card-hit--active" : "")"
                     @onclick="() => OnCardHitAreaClick(item.Id)">
                    <div class="content-admin-preview">
                        @if (IsImageExtension(item.FileExtension))
                        {
                            <img class="content-admin-preview-img"
                                 src="@($"extra-content/{item.Id}")"
                                 alt=""
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="content-admin-preview-icon">
                                <i class="bi @GetFileIcon(item.FileExtension)"></i>
                            </div>
                        }
                        <ExtraContentItemContextMenu Item="item"
                                                     ShowAssign="true"
                                                     OnTags="() => OpenSingleTags(item)"
                                                     OnAssign="() => OpenSingleAssign(item)" />
                    </div>
                    <div class="content-admin-card-footer">
                        <div class="fw-semibold text-truncate small" title="@item.FileName">@item.FileName</div>
                        <div class="text-secondary small">
                            @if (item.IsManuallyImported)
                            {
                                <span class="badge text-bg-info me-1" title="File path was registered as-is; not under _extras">External</span>
                            }
                            @if (item.AuthorName is not null)
                            {
                                <span><i class="bi bi-person me-1"></i>@item.AuthorName</span>
                            }
                            else
                            {
                                <span class="fst-italic">Unassigned</span>
                            }
                        </div>
                        <div class="text-secondary small">@FormatBytes(item.FileSizeBytes)</div>
                        @if (item.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="badge rounded-pill text-bg-light border small">@tag.Name</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-body-secondary">
            Showing @(loadedItems.Count == 0 ? 0 : 1)-@loadedItems.Count of @totalCount
        </small>
        @if (isLoadingMore && loadedItems.Count > 0)
        {
            <span class="text-secondary small"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Loading more…</span>
        }
    </div>
    @if (hasMorePages || isLoadingMore)
    {
        <div class="infinite-scroll-sentinel" @ref="infiniteScrollSentinel"></div>
    }
}

@* Bulk assign author modal *@
@if (bulkAssignOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Assign to Author</h5>
                    <button type="button" class="btn-close" @onclick="() => bulkAssignOpen = false" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (bulkAssignError is not null)
                    {
                        <div class="alert alert-danger py-2">@bulkAssignError</div>
                    }
                    <label class="form-label">Author</label>
                    <select class="form-select" @bind="bulkAssignAuthorId">
                        <option value="0">— Select author —</option>
                        @if (authors is not null)
                        {
                            @foreach (var a in authors)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => bulkAssignOpen = false">Cancel</button>
                    <button type="button" class="btn btn-primary"
                            disabled="@(bulkActionBusy || bulkAssignAuthorId == 0)"
                            @onclick="BulkAssignToAuthorAsync">
                        @if (bulkActionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Assign
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<EditExtraContentTagsModal IsOpen="tagsModalOpen"
                          Title="@tagsModalTitle"
                          ItemIds="tagsModalItemIds"
                          InitialTagNames="tagsModalInitialNames"
                          OnClose="CloseTagsModal"
                          OnSaved="OnTagsSavedAsync" />

@if (showAddContentPicker)
{
    <FileSystemPicker Mode="FileSystemPicker.PickerMode.File"
                      AllowMultiple="true"
                      Title="Select files to register (paths are not moved or copied)"
                      OnConfirmMultiple="OnExternalFilesConfirmedAsync"
                      OnCancel="CancelAddContentPicker" />
}
