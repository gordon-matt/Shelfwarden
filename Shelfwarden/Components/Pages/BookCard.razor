@inject IBookService BookService
@inject IUserContextService UserContext

@if (Book is not null)
{
    <a class="book-card" href="@($"books/{Book.Id}")" title="@Book.Title"
       @onclick="HandleCardClickAsync"
       @onclick:preventDefault="@SelectionMode">
        <div class="book-cover">
            @if (!string.IsNullOrWhiteSpace(Book.CoverImagePath))
            {
                <img src="@($"covers/{Book.Id}")" alt="@Book.Title" loading="lazy" />
            }
            else
            {
                <i class="bi bi-book placeholder-icon"></i>
            }

            @if (IsFinished)
            {
                <span class="book-finished-badge" title="Read">
                    <i class="bi bi-check-lg"></i>
                </span>
            }

            @if (Book.FileFormat != EbookFormat.Unknown)
            {
                <span class="book-format-badge">@Book.FileFormat.ToString().ToUpperInvariant()</span>
            }

            @* Three-dot context menu — bottom-right of the cover. We keep it as a Bootstrap
               dropdown so click-away handling and keyboard nav come for free. Each interactive
               child carries `@onclick:stopPropagation="true"` so its click doesn't bubble up to
               the outer `<a class="book-card">` and trigger an unwanted navigate to the detail
               page. We deliberately DO NOT set `:preventDefault` on the wrapper — that would
               cancel the default action of every bubbled click, including the Read/Edit anchor
               navigations themselves.

               `data-bs-config` is a Bootstrap 5.2+ JSON config blob merged into the dropdown's
               options. Bootstrap's Dropdown does NOT honour `data-bs-strategy` (that's tooltip /
               popover only), so we have to push `strategy: "fixed"` in via `popperConfig`. With
               a fixed strategy, Popper positions the menu with `position: fixed`, which escapes
               `.book-cover { overflow: hidden }` (this only works because no ancestor uses
               `transform`/`filter`/`will-change` — those would re-establish the containing
               block and re-clip the menu). *@
            <div class="book-card-menu dropend">
                <button type="button"
                        class="btn btn-sm book-card-menu-toggle"
                        data-bs-toggle="dropdown"
                        data-bs-config='{"popperConfig":{"strategy":"fixed"}}'
                        aria-expanded="false"
                        aria-label="Book actions"
                        @onclick:stopPropagation="true"
                        @onclick:preventDefault="true">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="@($"read/{Book.Id}")"
                           @onclick:stopPropagation="true">
                            <i class="bi bi-book-half me-1"></i> Read
                        </a>
                    </li>
                    @if (UserContext.IsAdministrator())
                    {
                        <li>
                            <a class="dropdown-item" href="@($"books/{Book.Id}/edit")"
                               @onclick:stopPropagation="true">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item"
                                disabled="@isUpdatingProgress"
                                @onclick="ToggleReadAsync"
                                @onclick:stopPropagation="true"
                                @onclick:preventDefault="true">
                            @if (IsFinished)
                            {
                                <i class="bi bi-bookmark-x me-1"></i>
                                <span>Mark as Unread</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Mark as Read</span>
                            }
                        </button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <AddToReadingListAction BookId="Book.Id" />
                    @if (ExtraMenuItems is not null)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        @ExtraMenuItems
                    }
                </ul>
            </div>

            @if (CurrentProgress is > 0 and < 100)
            {
                <div class="book-cover-progress" role="progressbar"
                     aria-valuenow="@CurrentProgress" aria-valuemin="0" aria-valuemax="100">
                    <div class="bar" style="width: @($"{CurrentProgress:0}%")"></div>
                </div>
            }
        </div>
        <div class="book-meta">
            <div class="book-title">@Book.Title</div>
            <div class="book-author">
                @(string.IsNullOrEmpty(Book.PrimaryAuthor) ? "Unknown author" : Book.PrimaryAuthor)
            </div>
            @if (!string.IsNullOrEmpty(Book.SeriesName))
            {
                <div class="book-author small">
                    <i class="bi bi-collection"></i> @Book.SeriesName
                    @if (Book.NumberInSeries.HasValue)
                    {
                        <span> · #@Book.NumberInSeries</span>
                    }
                </div>
            }
        </div>
    </a>
}
