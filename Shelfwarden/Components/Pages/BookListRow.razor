@* Horizontal "list view" row for a book. Mirrors BookCard.razor (cover + meta + read/edit
   actions) but lays them out in a wide row with room for a truncated description. *@

@if (Book is not null)
{
    <a class="book-list-row" href="@($"books/{Book.Id}")" title="@Book.Title"
       @onclick="HandleRowClickAsync"
       @onclick:preventDefault="@SelectionMode">
        <div class="book-list-cover">
            @if (!string.IsNullOrWhiteSpace(Book.CoverImagePath))
            {
                <img src="@($"covers/{Book.Id}")" alt="@Book.Title" loading="lazy" />
            }
            else
            {
                <i class="bi bi-book placeholder-icon"></i>
            }

            @if (Book.FileFormat != EbookFormat.Unknown)
            {
                <span class="book-format-badge">@Book.FileFormat.ToString().ToUpperInvariant()</span>
            }

            @if (Book.ProgressPercentage > 0)
            {
                <div class="book-cover-progress" role="progressbar"
                     aria-valuenow="@Book.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                    <div class="bar" style="width: @($"{Book.ProgressPercentage:0}%")"></div>
                </div>
            }
        </div>

        <div class="book-list-body">
            <div class="book-list-title">@Book.Title</div>
            @if (!string.IsNullOrEmpty(Book.Subtitle))
            {
                <div class="book-list-subtitle">@Book.Subtitle</div>
            }
            <div class="book-list-author">
                @(string.IsNullOrEmpty(Book.PrimaryAuthor) ? "Unknown author" : Book.PrimaryAuthor)
                @if (!string.IsNullOrEmpty(Book.SeriesName))
                {
                    <span class="ms-2 text-secondary">
                        <i class="bi bi-collection"></i> @Book.SeriesName
                        @if (Book.NumberInSeries.HasValue)
                        {
                            <span> · #@Book.NumberInSeries</span>
                        }
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Book.Description))
            {
                <p class="book-list-description">@Truncate(Book.Description, DescriptionLength)</p>
            }
        </div>

        <div class="book-list-actions">
            <a class="btn btn-sm btn-primary"
               href="@($"read/{Book.Id}")"
               @onclick:stopPropagation="true">
                <i class="bi bi-book-half"></i> Read
            </a>
            <a class="btn btn-sm btn-outline-secondary"
               href="@($"books/{Book.Id}/edit")"
               title="Edit metadata"
               @onclick:stopPropagation="true">
                <i class="bi bi-pencil"></i>
            </a>
        </div>
    </a>
}
