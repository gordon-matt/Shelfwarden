@page "/books/{Id:int}/edit"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@inject IBookService BookService
@inject IAuthorService AuthorService
@inject ISeriesService SeriesService
@inject IGenreService GenreService
@inject ITagService TagService
@inject NavigationManager NavigationManager
@inject ILogger<BookEdit> Logger

<PageTitle>@(book?.Title is { } t ? $"Edit \"{t}\"" : "Edit book") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading book…</div>
    </div>
}
else if (book is null || form is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Book not found</h3>
        <p>It may have been deleted, or moved out of its shelf on disk.</p>
        <a class="btn btn-outline-secondary" href="books">
            <i class="bi bi-arrow-left"></i> Back to books
        </a>
    </div>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="book-edit">
        <DataAnnotationsValidator />

        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
            <div>
                <a href="@($"books/{book.Id}")" class="text-secondary text-decoration-none small">
                    <i class="bi bi-arrow-left"></i> Back to @book.Title
                </a>
                <h1 class="mb-0 mt-1">Edit book</h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary" @onclick="OpenMetadataModal">
                    <i class="bi bi-cloud-download me-1"></i> Fetch metadata
                </button>
                <a class="btn btn-outline-secondary" href="@($"books/{book.Id}")">Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                    }
                    Save
                </button>
            </div>
        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            </div>
        }

        <ValidationSummary class="alert alert-warning" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header"><strong>General</strong></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="form.Title" />
                            <ValidationMessage For="() => form.Title" class="text-danger small" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Sort title</label>
                                <InputText class="form-control" @bind-Value="form.SortTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subtitle</label>
                                <InputText class="form-control" @bind-Value="form.Subtitle" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="6" @bind-Value="form.Description" />
                            <div class="form-text">HTML is rendered on the detail page.</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Publication</strong></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Publisher</label>
                                <InputText class="form-control" @bind-Value="form.Publisher" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Published on</label>
                                <InputDate class="form-control" @bind-Value="form.PublishedOn" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Language</label>
                                <InputText class="form-control" @bind-Value="form.Language" placeholder="en, fr, de…" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ISBN</label>
                                <InputText class="form-control" @bind-Value="form.Isbn" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header"><strong>Series</strong></div>
                    <div class="card-body">
                        <label class="form-label">Series</label>
                        <div class="position-relative mb-3">
                            <input class="form-control" type="text"
                                   value="@seriesInput" @oninput="OnSeriesInput"
                                   @onfocus="OnSeriesFocus" @onkeydown="OnSeriesKeyDown"
                                   placeholder="Pick or create a series…" />
                            @if (selectedSeries is not null)
                            {
                                <button type="button" class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
                                        title="Clear" aria-label="Clear" @onclick="ClearSeries"></button>
                            }
                            @if (showSeriesSuggestions)
                            {
                                <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 220px; overflow-y: auto; z-index: 50;">
                                    @foreach (var s in seriesSuggestions)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(s.Name)">
                                                @s.Name
                                            </button>
                                        </li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(seriesInput) && !seriesSuggestions.Any(s => string.Equals(s.Name, seriesInput.Trim(), StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(seriesInput!.Trim())">
                                                <i class="bi bi-plus-lg"></i> Create "<strong>@seriesInput.Trim()</strong>"
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (selectedSeries is not null)
                        {
                            <label class="form-label">Number in series</label>
                            <InputNumber class="form-control" @bind-Value="form.NumberInSeries" step="0.01" />
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Authors</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="AuthorDto"
                                   Label="Authors"
                                   Selected="selectedAuthors"
                                   NameOf="@(a => a.Name)"
                                   SearchAsync="SearchAuthorsAsync"
                                   OnAddAsync="AddAuthorAsync" />
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Genres</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="GenreDto"
                                   Label="Genres"
                                   Selected="selectedGenres"
                                   NameOf="@(g => g.Name)"
                                   SearchAsync="SearchGenresAsync"
                                   OnAddAsync="AddGenreAsync" />
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Tags</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="string"
                                   Label="Tags"
                                   Selected="selectedTags"
                                   ChipCssSuffix="chip-tag"
                                   NameOf="@(t => t)"
                                   SearchAsync="SearchTagsAsync"
                                   OnAddAsync="AddTagAsync" />
                        <div class="form-text">Suggestions come from tags already used in your library; you can still create a new tag by typing its name.</div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    <BookMetadataModal IsOpen="showMetadataModal"
                       InitialTitle="@form.Title"
                       InitialAuthor="@selectedAuthors.FirstOrDefault()?.Name"
                       InitialIsbn="@form.Isbn"
                       OnClose="CloseMetadataModal"
                       OnApply="ApplyExternalMetadataAsync" />
}
