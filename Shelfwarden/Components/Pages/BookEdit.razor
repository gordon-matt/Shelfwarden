@page "/books/{Id:int}/edit"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@inject IBookService BookService
@inject IBookCoverService BookCoverService
@inject IAuthorService AuthorService
@inject ISeriesService SeriesService
@inject IUniverseService UniverseService
@inject IGenreService GenreService
@inject ITagService TagService
@inject NavigationManager NavigationManager
@inject ILogger<BookEdit> Logger

<PageTitle>@(book?.Title is { } t ? $"Edit \"{t}\"" : "Edit book") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading book…</div>
    </div>
}
else if (book is null || form is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Book not found</h3>
        <p>It may have been deleted, or moved out of its shelf on disk.</p>
        <a class="btn btn-outline-secondary" href="books">
            <i class="bi bi-arrow-left"></i> Back to books
        </a>
    </div>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="book-edit">
        <DataAnnotationsValidator />

        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
            <div>
                <a href="@($"books/{book.Id}")" class="text-secondary text-decoration-none small">
                    <i class="bi bi-arrow-left"></i> Back to @book.Title
                </a>
                <h1 class="mb-0 mt-1">Edit book</h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary" @onclick="OpenMetadataModal">
                    <i class="bi bi-cloud-download me-1"></i> Fetch metadata
                </button>
                <a class="btn btn-outline-secondary" href="@($"books/{book.Id}")">Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                    }
                    Save
                </button>
            </div>
        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            </div>
        }

        <ValidationSummary class="alert alert-warning" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header"><strong>General</strong></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="form.Title" />
                            <ValidationMessage For="() => form.Title" class="text-danger small" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Sort title</label>
                                <InputText class="form-control" @bind-Value="form.SortTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subtitle</label>
                                <InputText class="form-control" @bind-Value="form.Subtitle" />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="6" @bind-Value="form.Description" />
                            <div class="form-text">HTML is rendered on the detail page.</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Publication</strong></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Publisher</label>
                                <InputText class="form-control" @bind-Value="form.Publisher" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Published on</label>
                                <InputDate class="form-control" @bind-Value="form.PublishedOn" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Language</label>
                                <InputText class="form-control" @bind-Value="form.Language" placeholder="en, fr, de…" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ISBN</label>
                                <InputText class="form-control" @bind-Value="form.Isbn" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header"><strong>Cover</strong></div>
                    <div class="card-body">
                        <div class="book-edit-cover mb-2">
                            @if (revertCoverToFile)
                            {
                                <div class="alert alert-secondary py-2 mb-0 small">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    The file's embedded cover will be restored when you save.
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(pendingCoverUrl))
                            {
                                <img src="@pendingCoverUrl" class="img-fluid rounded border" alt="New cover" referrerpolicy="no-referrer" />
                                <div class="text-secondary small mt-1">
                                    <i class="bi bi-check-lg me-1"></i> New cover — applied when you save.
                                </div>
                            }
                            else
                            {
                                <img src="@($"covers/{book.Id}")" class="img-fluid rounded border" alt="@book.Title"
                                     onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none')" />
                                <div class="text-secondary small d-none"><i class="bi bi-image me-1"></i> No cover on file.</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(pendingCoverUrl) || revertCoverToFile)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 mb-2" @onclick="UndoCoverChange">
                                Undo cover change
                            </button>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenMetadataModal">
                                <i class="bi bi-images me-1"></i> Choose online…
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StageRevertCover">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Revert to file cover
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Series</strong></div>
                    <div class="card-body">
                        <label class="form-label">Series</label>
                        <div class="position-relative mb-3">
                            <input class="form-control" type="text"
                                   value="@seriesInput" @oninput="OnSeriesInput"
                                   @onfocus="OnSeriesFocus" @onkeydown="OnSeriesKeyDown"
                                   placeholder="Pick or create a series…" />
                            @if (selectedSeries is not null)
                            {
                                <button type="button" class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
                                        title="Clear" aria-label="Clear" @onclick="ClearSeries"></button>
                            }
                            @if (showSeriesSuggestions)
                            {
                                <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm" style="position: absolute; max-height: 220px; overflow-y: auto; z-index: 50;">
                                    @foreach (var s in seriesSuggestions)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(s.Name)">
                                                @s.Name
                                            </button>
                                        </li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(seriesInput) && !seriesSuggestions.Any(s => string.Equals(s.Name, seriesInput.Trim(), StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(seriesInput!.Trim())">
                                                <i class="bi bi-plus-lg"></i> Create "<strong>@seriesInput.Trim()</strong>"
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (selectedSeries is not null)
                        {
                            <label class="form-label">Number in series</label>
                            <InputNumber class="form-control" @bind-Value="form.NumberInSeries" step="0.01" />
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Universe</strong></div>
                    <div class="card-body">
                        <label class="form-label">Universe</label>
                        <select class="form-select" @bind="selectedUniverseId" @bind:after="OnUniverseChangedAsync">
                            <option value="0">— None —</option>
                            @foreach (var u in universeOptions)
                            {
                                <option value="@u.Id">@u.Name</option>
                            }
                        </select>
                        <div class="form-text">
                            A book's universe is stored separately from its series, so it stays put even if
                            the series moves.
                        </div>

                        @if (selectedUniverseId > 0)
                        {
                            <label class="form-label mt-3">Timeline date</label>
                            <select class="form-select" @bind="selectedTimelineDateId" disabled="@loadingDates">
                                <option value="0">— Unscheduled —</option>
                                @foreach (var d in timelineDates)
                                {
                                    <option value="@d.Id">@d.Label</option>
                                }
                            </select>
                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                <div class="form-text mb-0">
                                    The universe's dates, in timeline order. Reorder them from the universe page.
                                </div>
                                <button type="button" class="btn btn-link btn-sm px-0" @onclick="OpenDateModal">
                                    <i class="bi bi-plus-lg"></i> New date&hellip;
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Authors</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="AuthorDto"
                                   Label="Authors"
                                   Selected="selectedAuthors"
                                   NameOf="@(a => a.Name)"
                                   SearchAsync="SearchAuthorsAsync"
                                   OnAddAsync="AddAuthorAsync" />
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Genres</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="GenreDto"
                                   Label="Genres"
                                   Selected="selectedGenres"
                                   NameOf="@(g => g.Name)"
                                   SearchAsync="SearchGenresAsync"
                                   OnAddAsync="AddGenreAsync" />
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><strong>Tags</strong></div>
                    <div class="card-body">
                        <ChipInput TItem="string"
                                   Label="Tags"
                                   Selected="selectedTags"
                                   ChipCssSuffix="chip-tag"
                                   NameOf="@(t => t)"
                                   SearchAsync="SearchTagsAsync"
                                   OnAddAsync="AddTagAsync" />
                        <div class="form-text">Suggestions come from tags already used in your library; you can still create a new tag by typing its name.</div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    <BookMetadataModal IsOpen="showMetadataModal"
                       InitialTitle="@form.Title"
                       InitialAuthor="@selectedAuthors.FirstOrDefault()?.Name"
                       InitialIsbn="@form.Isbn"
                       OnClose="CloseMetadataModal"
                       OnApply="ApplyExternalMetadataAsync"
                       OnUseCover="StageCoverFromUrl" />

    @if (dateModalOpen)
    {
        <div class="modal modal-show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.35); z-index: 1060;"
             @onclick="CloseDateModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-calendar-event me-1"></i> New timeline date</h5>
                        <button type="button" class="btn-close" @onclick="CloseDateModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="btn-group w-100 mb-3" role="group" aria-label="Timeline type">
                            <input type="radio" class="btn-check" name="book-timeline-date-type" id="book-timeline-date-type-named" autocomplete="off"
                                   checked="@(dateModalTimelineType == TimelineType.Named)"
                                   @onchange="() => dateModalTimelineType = TimelineType.Named" />
                            <label class="btn btn-outline-secondary" for="book-timeline-date-type-named">Named</label>

                            <input type="radio" class="btn-check" name="book-timeline-date-type" id="book-timeline-date-type-numeric" autocomplete="off"
                                   checked="@(dateModalTimelineType == TimelineType.Numeric)"
                                   @onchange="() => dateModalTimelineType = TimelineType.Numeric" />
                            <label class="btn btn-outline-secondary" for="book-timeline-date-type-numeric">Numeric</label>
                        </div>

                        @if (dateModalTimelineType == TimelineType.Named)
                        {
                            <label class="form-label" for="book-timeline-date-text">Date</label>
                            <input id="book-timeline-date-text" class="form-control" maxlength="50" autofocus
                                   placeholder="10,191 AG · Spring 1998 · Before the Fall"
                                   @bind="dateModalText" @bind:event="oninput"
                                   @onkeydown="DateModalKeyDownAsync" />
                            <div class="form-text">
                                Added to the end of the universe's timeline and selected for this book. Reorder
                                the universe's dates from its own page.
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label" for="book-timeline-date-year-from">Year from</label>
                                    <input id="book-timeline-date-year-from" type="number" class="form-control" autofocus
                                           @bind="dateModalYearFrom" @onkeydown="DateModalKeyDownAsync" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="book-timeline-date-year-to">Year to <span class="text-body-secondary">(optional)</span></label>
                                    <input id="book-timeline-date-year-to" type="number" class="form-control"
                                           @bind="dateModalYearTo" @onkeydown="DateModalKeyDownAsync" />
                                </div>
                            </div>
                            <div class="form-text">
                                The universe's timeline renders on a real proportional axis, so overlapping
                                series ranges merge into one label.
                            </div>
                        }

                        @if (dateModalError is not null)
                        {
                            <div class="alert alert-warning mt-3 mb-0">@dateModalError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseDateModal" disabled="@dateModalBusy">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="CreateDateAsync"
                                disabled="@(dateModalBusy || !DateModalCanSave)">
                            @if (dateModalBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Add
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}
