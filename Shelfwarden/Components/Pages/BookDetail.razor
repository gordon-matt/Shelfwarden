@page "/books/{Id:int}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IBookService BookService
@inject IBookmarkService BookmarkService
@inject IBookUserService BookUserService
@inject IAudiobookService AudiobookService
@inject IAdditionalContentService ContentService
@inject IUserContextService UserContext
@inject NavigationManager NavigationManager
@inject IJSRuntime Js

<PageTitle>@(book?.Title ?? "Book") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading book…</div>
    </div>
}
else if (book is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Book not found</h3>
        <p>It may have been deleted, or moved out of its shelf on disk.</p>
        <a class="btn btn-outline-secondary" href="books">
            <i class="bi bi-arrow-left"></i> Back to books
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-3">
            <div class="book-cover rounded shadow-sm">
                @if (!string.IsNullOrWhiteSpace(book.CoverImagePath))
                {
                    <img src="@($"covers/{book.Id}")" alt="@book.Title" />
                }
                else
                {
                    <i class="bi bi-book placeholder-icon"></i>
                }
            </div>
        </div>
        <div class="col-md-9">
            <h1 class="mb-1">@book.Title</h1>
            @if (!string.IsNullOrEmpty(book.Subtitle))
            {
                <h2 class="h5 text-body-secondary">@book.Subtitle</h2>
            }

            <p class="mb-2">
                @if (book.Authors.Count > 0)
                {
                    <span>
                        by
                        @for (int i = 0; i < book.Authors.Count; i++)
                        {
                            var author = book.Authors[i];
                            <a href="@($"authors/{author.Id}")">@author.Name</a>
                            @if (i < book.Authors.Count - 1)
                            {
                                <text>, </text>
                            }
                        }
                    </span>
                }
                @if (book.Series is not null)
                {
                    <span class="ms-2">
                        in <a href="@($"series/{book.Series.Id}")">@book.Series.Name</a>
                        @if (book.NumberInSeries.HasValue)
                        {
                            <text> #@book.NumberInSeries</text>
                        }
                    </span>
                }
            </p>

            <div class="d-flex align-items-center gap-2 mb-2">
                <StarRating Value="book.Rating ?? 0" ValueChanged="SaveRatingAsync" AriaLabel="Your rating" />
                @if (book.Rating is > 0)
                {
                    <span class="text-secondary small">@book.Rating / 5</span>
                }
                else
                {
                    <span class="text-secondary small">Rate this book</span>
                }
            </div>

            <dl class="row small">
                @if (!string.IsNullOrEmpty(book.Publisher))
                {
                    <dt class="col-sm-3">Publisher</dt>
                    <dd class="col-sm-9">@book.Publisher</dd>
                }
                @if (book.PublishedOn.HasValue)
                {
                    <dt class="col-sm-3">Published</dt>
                    <dd class="col-sm-9">@book.PublishedOn.Value.ToString("yyyy-MM-dd")</dd>
                }
                @if (!string.IsNullOrEmpty(book.Language))
                {
                    <dt class="col-sm-3">Language</dt>
                    <dd class="col-sm-9">@book.Language</dd>
                }
                @if (!string.IsNullOrEmpty(book.Isbn))
                {
                    <dt class="col-sm-3">ISBN</dt>
                    <dd class="col-sm-9">@book.Isbn</dd>
                }
                @if (book.PageCount.HasValue)
                {
                    <dt class="col-sm-3">Pages</dt>
                    <dd class="col-sm-9">@book.PageCount</dd>
                }
                <dt class="col-sm-3">Format</dt>
                <dd class="col-sm-9">@book.FileFormat</dd>
                <dt class="col-sm-3">File size</dt>
                <dd class="col-sm-9">@FormatBytes(book.FileSizeBytes)</dd>
            </dl>

            @if (book.Genres.Count > 0)
            {
                <p class="mb-2 d-flex flex-wrap gap-1">
                    @foreach (var g in book.Genres)
                    {
                        <a class="chip chip-genre" href="@($"books?genreId={g.Id}")">
                            <i class="bi bi-tag"></i> @g.Name
                        </a>
                    }
                </p>
            }

            @if (book.Tags.Count > 0)
            {
                <p class="mb-3 d-flex flex-wrap gap-1">
                    @foreach (var t in book.Tags)
                    {
                        <a class="chip chip-tag text-decoration-none" href="@($"books?tagId={t.Id}")" title="Browse books tagged #@t.Name">
                            #@t.Name
                        </a>
                    }
                </p>
            }

            <ul class="nav nav-tabs mt-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == DetailTab.Description ? "active" : null)" type="button"
                            @onclick="() => activeTab = DetailTab.Description">
                        <i class="bi bi-card-text"></i> Description
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == DetailTab.Bookmarks ? "active" : null)" type="button"
                            @onclick="() => activeTab = DetailTab.Bookmarks">
                        <i class="bi bi-bookmarks"></i> Bookmarks
                        @if (bookmarks.Count > 0)
                        {
                            <span class="badge text-bg-secondary ms-1">@bookmarks.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == DetailTab.Notes ? "active" : null)" type="button"
                            @onclick="() => activeTab = DetailTab.Notes">
                        <i class="bi bi-journal-text"></i> Notes
                    </button>
                </li>
            </ul>
            <div class="border border-top-0 rounded-bottom p-3 mb-3">
                @if (activeTab == DetailTab.Description)
                {
                    @if (!string.IsNullOrEmpty(book.Description))
                    {
                        <div class="book-description">@((MarkupString)book.Description)</div>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">No description available.</p>
                    }
                }
                else if (activeTab == DetailTab.Bookmarks)
                {
                    @if (bookmarks.Count == 0)
                    {
                        <p class="text-secondary mb-0">You haven't added any bookmarks to this book yet.</p>
                    }
                    else
                    {
                        <div class="accordion" id="bookmarksAccordion">
                            @foreach (var bm in bookmarks)
                            {
                                bool isOpen = expandedBookmarkId == bm.Id;
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(isOpen ? null : "collapsed")" type="button"
                                                @onclick="() => ToggleBookmark(bm)">
                                            <span class="d-flex flex-column text-start">
                                                <span class="fw-semibold">@(bm.Title ?? DefaultBookmarkTitle(bm))</span>
                                                <span class="text-secondary small">
                                                    @bm.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                    @if (bm.PageNumber.HasValue)
                                                    {
                                                        <text> · Page @bm.PageNumber</text>
                                                    }
                                                </span>
                                            </span>
                                        </button>
                                    </h2>
                                    @if (isOpen)
                                    {
                                        <div class="accordion-collapse collapse show">
                                            <div class="accordion-body">
                                                <textarea class="form-control" rows="3"
                                                          placeholder="Add a note for this bookmark…"
                                                          @bind="bookmarkNoteDraft"></textarea>
                                                <div class="d-flex align-items-center gap-2 mt-2">
                                                    <button class="btn btn-sm btn-primary" disabled="@bookmarkNoteSaving"
                                                            @onclick="() => SaveBookmarkNoteAsync(bm)">
                                                        <i class="bi bi-save"></i> Save note
                                                    </button>
                                                    <a class="btn btn-sm btn-outline-secondary" href="@($"read/{book.Id}")">
                                                        <i class="bi bi-box-arrow-up-right"></i> Open
                                                    </a>
                                                    <button class="btn btn-sm btn-outline-danger ms-auto"
                                                            @onclick="() => RemoveBookmarkAsync(bm)">
                                                        <i class="bi bi-trash"></i> Remove
                                                    </button>
                                                </div>
                                                @if (bookmarkNoteFlash is not null)
                                                {
                                                    <div class="text-success small mt-2">@bookmarkNoteFlash</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <textarea class="form-control" rows="8"
                              placeholder="Your private notes about this book…"
                              @bind="bookNotesDraft"></textarea>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button class="btn btn-primary" disabled="@bookNotesSaving" @onclick="SaveBookNotesAsync">
                            <i class="bi bi-save"></i> Save notes
                        </button>
                        @if (bookNotesFlash is not null)
                        {
                            <span class="text-success small">@bookNotesFlash</span>
                        }
                    </div>
                }
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="@($"read/{book.Id}")">
                    <i class="bi bi-book-half"></i> Read
                </a>
                @if (audiobookSupported)
                {
                    @if (audiobook is null || audiobook.State is AudiobookState.None or AudiobookState.Failed)
                    {
                        @if (isAdministrator)
                        {
                            <button class="btn btn-outline-primary" type="button" @onclick="StartGenerateFlowAsync">
                                <i class="bi bi-headphones"></i> Generate Audio
                            </button>
                        }
                    }
                    else if (audiobook.State == AudiobookState.Completed)
                    {
                        <button class="btn btn-success" type="button" @onclick="ToggleListen">
                            <i class="bi bi-volume-up"></i>
                            @(showPlayer ? "Hide Player" : "Listen")
                        </button>
                        @if (isAdministrator)
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="StartGenerateFlowAsync"
                                    title="Regenerate with different sections, chapters or voice">
                                <i class="bi bi-arrow-repeat"></i> Regenerate
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-outline-primary" type="button" disabled>
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            @(audiobook.State == AudiobookState.Pending ? "Queued…" : "Generating…")
                        </button>
                    }
                }
                @* Every "Add to…" goes through a modal — listing the targets inline made this
                   menu unusable once a library had more than a handful of them. *@
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-plus-circle"></i> Add to&hellip;
                    </button>
                    <ul class="dropdown-menu">
                        <AddToActions BookId="book.Id" SubjectName="@book.Title" />
                    </ul>
                </div>
                <a class="btn btn-outline-secondary" href="@($"files/{book.Id}?download=true")">
                    <i class="bi bi-download"></i> Download
                </a>

                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <a class="btn btn-outline-secondary" href="@($"books/{book.Id}/edit")">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <button class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>

            @if (audiobookSupported && audiobook is not null && audiobook.State != AudiobookState.None)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <div>
                                <h3 class="h6 mb-1">
                                    <i class="bi bi-headphones"></i> Audiobook
                                    <span class="badge ms-1 @StatusBadgeClass(audiobook.State)">@FormatState(audiobook.State)</span>
                                </h3>
                                <div class="small text-body-secondary">
                                    Voice: <code>@audiobook.VoiceName</code>
                                    @if (audiobook.SplitByChapter && audiobook.Chapters is { Count: > 0 } chapters)
                                    {
                                        <text> · @chapters.Count chapters</text>
                                    }
                                    @if (audiobook.State == AudiobookState.Completed && audiobook.OutputSizeBytes is long sz)
                                    {
                                        <text> · @FormatBytes(sz)</text>
                                    }
                                    @if (audiobook.State == AudiobookState.Completed && audiobook.DurationSeconds is double secs && secs > 0)
                                    {
                                        <text> · @FormatDuration(secs)</text>
                                    }
                                </div>
                            </div>
                            @if (audiobook.State is AudiobookState.Pending or AudiobookState.Running)
                            {
                                <div class="text-end small text-body-secondary text-nowrap">
                                    @if (IsStitchingPhase(audiobook))
                                    {
                                        <span class="text-body">Stitching&hellip;</span>
                                    }
                                    else if (audiobook.TotalChunks > 0)
                                    {
                                        <text>@audiobook.CompletedChunks / @audiobook.TotalChunks chunks</text>
                                    }
                                    else
                                    {
                                        <text>Preparing&hellip;</text>
                                    }
                                </div>
                            }
                        </div>

                        @if (isAdministrator)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @if (audiobook.State is AudiobookState.Pending or AudiobookState.Running or AudiobookState.Failed)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            disabled="@audiobookActionBusy"
                                            @onclick="CancelAudiobookGenerationAsync">
                                        <i class="bi bi-x-circle"></i>
                                        @(audiobook.State == AudiobookState.Failed ? "Clear and try again" : "Cancel generation")
                                    </button>
                                }
                                @if (audiobook.State == AudiobookState.Completed)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            disabled="@audiobookActionBusy"
                                            title="Remove the file so you can generate again with another voice"
                                            @onclick="DeleteFinishedAudiobookAsync">
                                        <i class="bi bi-trash"></i> Delete audiobook
                                    </button>
                                }
                            </div>
                        }

                        @if (generateError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-2 small">@generateError</div>
                        }

                        @if (audiobook.State is AudiobookState.Pending or AudiobookState.Running)
                        {
                            @if (!string.IsNullOrWhiteSpace(audiobook.CurrentStage))
                            {
                                <p class="small fw-semibold mt-3 mb-0">@audiobook.CurrentStage</p>
                            }
                            <div class="progress mt-2" style="height: 0.5rem;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width: @((audiobook.PercentComplete ?? 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"
                                     aria-valuenow="@(audiobook.PercentComplete ?? 0)"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            @if (IsStitchingPhase(audiobook))
                            {
                                <p class="small text-body-secondary mt-2 mb-0">
                                    All speech parts are done. The app is now joining them and compressing the file
                                    to M4A. <strong>This step can take a while</strong> for long books (large files
                                    to copy and encode) — it is not stuck. This page keeps polling until the
                                    audiobook is ready.
                                </p>
                            }
                            else
                            {
                                <p class="small text-body-secondary mt-2 mb-0">
                                    Audiobook generation runs in the background — feel free to navigate away and come
                                    back later. Status updates automatically.
                                </p>
                            }
                        }
                        else if (audiobook.State == AudiobookState.Failed)
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 small">
                                <strong>Generation failed.</strong>
                                @if (!string.IsNullOrWhiteSpace(audiobook.ErrorMessage))
                                {
                                    <text> @audiobook.ErrorMessage</text>
                                }
                            </div>
                        }
                        else if (audiobook.State == AudiobookState.Completed && showPlayer)
                        {
                            @if (audiobook.SplitByChapter && audiobook.Chapters is { Count: > 0 })
                            {
                                <ul class="list-group list-group-flush mt-3 audiobook-chapter-list">
                                    @foreach (var chapter in audiobook.Chapters)
                                    {
                                        <li class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                                <span class="fw-medium">@(chapter.Index + 1). @chapter.Title</span>
                                                <span class="small text-body-secondary text-nowrap d-flex align-items-center gap-2">
                                                    @if (chapter.DurationSeconds > 0)
                                                    {
                                                        <text>@FormatDuration(chapter.DurationSeconds)</text>
                                                    }
                                                    <a href="@($"audiobooks/{book.Id}/chapters/{chapter.Index}")"
                                                       download="@($"{chapter.Index + 1:D3} - {chapter.Title}.m4a")"
                                                       title="Download this chapter">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    @if (isAdministrator)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger border-0 py-0"
                                                                title="Remove this chapter"
                                                                disabled="@audiobookActionBusy"
                                                                @onclick="() => DeleteChapterAsync(chapter.Index)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </span>
                                            </div>
                                            <audio controls preload="none" class="w-100 mt-1"
                                                   src="@($"audiobooks/{book.Id}/chapters/{chapter.Index}")"></audio>
                                        </li>
                                    }
                                </ul>
                                <p class="small text-body-secondary mt-2 mb-0">
                                    <a href="@($"audiobooks/{book.Id}/zip")" download="@($"{book.Title}.zip")">
                                        <i class="bi bi-file-zip"></i> Download all chapters (.zip)
                                    </a>
                                </p>
                            }
                            else
                            {
                                <audio controls preload="metadata" class="w-100 mt-3" src="@($"audiobooks/{book.Id}")"></audio>
                                <p class="small text-body-secondary mt-2 mb-0">
                                    <a href="@($"audiobooks/{book.Id}")" download="@($"{book.Title}.m4a")">
                                        <i class="bi bi-download"></i> Download .m4a
                                    </a>
                                </p>
                            }
                        }
                    </div>
                </div>
            }

        </div>
    </div>

    @* Extra content associated with this book *@
    @if (bookExtraContent is { Count: > 0 })
    {
        <div class="mt-4">
            <h3 class="h5 mb-3">
                <i class="bi bi-folder2-open me-1"></i> Extra Content
            </h3>
            <AdditionalContentGrid Items="bookExtraContent"
                                   TagScopeAuthorId="extraContentTagScopeAuthorId"
                                   OnItemDeleted="RefreshExtraContentAsync"
                                   OnItemRenamed="OnContentItemRenamed"
                                   OnItemsChanged="RefreshExtraContentAsync" />
        </div>
    }

    <SectionEditor IsOpen="sectionEditorOpen"
                   Busy="sectionsBusy"
                   Sections="detectedSections"
                   Quality="detectionQuality"
                   Warning="detectionWarning"
                   SplitByChapter="splitByChapter"
                   SplitByChapterChanged="OnSplitByChapterChanged"
                   IsPdf="@(book?.FileFormat == EbookFormat.Pdf)"
                   BookId="Id"
                   SectionsChanged="OnSectionsRebuilt"
                   OnClose="CloseSectionEditor"
                   OnContinue="OnSectionsContinue" />

    <VoicePickerModal IsOpen="voicePickerOpen"
                      InitialVoiceName="@(audiobook?.VoiceName ?? "af_heart")"
                      OnClose="CloseVoicePicker"
                      OnBack="OnVoiceBack"
                      OnSelected="OnVoiceSelected" />

    @if (pendingVoiceConfirmation is not null && book is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Generate audiobook?</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelGenerate"></button>
                    </div>
                    <div class="modal-body">
                        <p>
                            We'll generate an audiobook of <strong>@book.Title</strong> using voice
                            <code>@pendingVoiceConfirmation</code>.
                        </p>
                        <p class="mb-0">
                            <strong>This can take a long time</strong> — typically several hours for a full novel,
                            depending on your CPU. The job runs in the background and you can navigate away; the
                            "Listen" button will appear here when it's finished.
                        </p>
                        @if (generateError is not null)
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 small">@generateError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelGenerate">Cancel</button>
                        <button type="button" class="btn btn-primary" disabled="@enqueuingGenerate" @onclick="ConfirmGenerateAsync">
                            @if (enqueuingGenerate)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Yes, start generating
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}
