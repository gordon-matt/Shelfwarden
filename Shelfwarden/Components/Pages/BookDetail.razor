@page "/books/{Id:int}"
@attribute [Authorize]
@inject IBookService BookService
@inject IBookmarkService BookmarkService
@inject ICollectionService CollectionService
@inject IReadingListService ReadingListService
@inject NavigationManager NavigationManager

<PageTitle>@(book?.Title ?? "Book") - Shelfwarden</PageTitle>

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading book…</div>
    </div>
}
else if (book is null)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>Book not found</h3>
        <p>It may have been deleted, or moved out of its library on disk.</p>
        <a class="btn btn-outline-secondary" href="books">
            <i class="bi bi-arrow-left"></i> Back to books
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-3">
            <div class="book-cover rounded shadow-sm">
                @if (!string.IsNullOrWhiteSpace(book.CoverImagePath))
                {
                    <img src="@($"covers/{book.Id}")" alt="@book.Title" />
                }
                else
                {
                    <i class="bi bi-book placeholder-icon"></i>
                }
            </div>
        </div>
        <div class="col-md-9">
            <h1 class="mb-1">@book.Title</h1>
            @if (!string.IsNullOrEmpty(book.Subtitle))
            {
                <h2 class="h5 text-body-secondary">@book.Subtitle</h2>
            }

            <p class="mb-2">
                @if (book.Authors.Count > 0)
                {
                    <span>
                        by
                        @for (int i = 0; i < book.Authors.Count; i++)
                        {
                            var author = book.Authors[i];
                            <a href="@($"books?authorId={author.Id}")">@author.Name</a>
                            @if (i < book.Authors.Count - 1)
                            {
                                <text>, </text>
                            }
                        }
                    </span>
                }
                @if (book.Series is not null)
                {
                    <span class="ms-2">
                        in <a href="@($"books?seriesId={book.Series.Id}")">@book.Series.Name</a>
                        @if (book.NumberInSeries.HasValue)
                        {
                            <text> #@book.NumberInSeries</text>
                        }
                    </span>
                }
            </p>

            <dl class="row small">
                @if (!string.IsNullOrEmpty(book.Publisher))
                {
                    <dt class="col-sm-3">Publisher</dt>
                    <dd class="col-sm-9">@book.Publisher</dd>
                }
                @if (book.PublishedOn.HasValue)
                {
                    <dt class="col-sm-3">Published</dt>
                    <dd class="col-sm-9">@book.PublishedOn.Value.ToString("yyyy-MM-dd")</dd>
                }
                @if (!string.IsNullOrEmpty(book.Language))
                {
                    <dt class="col-sm-3">Language</dt>
                    <dd class="col-sm-9">@book.Language</dd>
                }
                @if (!string.IsNullOrEmpty(book.Isbn))
                {
                    <dt class="col-sm-3">ISBN</dt>
                    <dd class="col-sm-9">@book.Isbn</dd>
                }
                @if (book.PageCount.HasValue)
                {
                    <dt class="col-sm-3">Pages</dt>
                    <dd class="col-sm-9">@book.PageCount</dd>
                }
                <dt class="col-sm-3">Format</dt>
                <dd class="col-sm-9">@book.FileFormat</dd>
                <dt class="col-sm-3">File size</dt>
                <dd class="col-sm-9">@FormatBytes(book.FileSizeBytes)</dd>
            </dl>

            @if (book.Genres.Count > 0)
            {
                <p class="mb-2 d-flex flex-wrap gap-1">
                    @foreach (var g in book.Genres)
                    {
                        <a class="chip chip-genre" href="@($"books?genreId={g.Id}")">
                            <i class="bi bi-tag"></i> @g.Name
                        </a>
                    }
                </p>
            }

            @if (book.Tags.Count > 0)
            {
                <p class="mb-3 d-flex flex-wrap gap-1">
                    @foreach (var t in book.Tags)
                    {
                        <span class="chip chip-tag">#@t</span>
                    }
                </p>
            }

            @if (!string.IsNullOrEmpty(book.Description))
            {
                <h3 class="h6 mt-3">Description</h3>
                <p>@((MarkupString)book.Description)</p>
            }

            @if (bookmarks.Count > 0)
            {
                <h3 class="h6 mt-3 mb-2">
                    <i class="bi bi-bookmarks"></i> Your bookmarks
                    <span class="badge text-bg-secondary ms-1">@bookmarks.Count</span>
                </h3>
                <ul class="list-unstyled mb-3">
                    @foreach (var bm in bookmarks)
                    {
                        <li class="bookmark-row">
                            <a class="btn btn-link p-0 text-start" href="@($"read/{book.Id}")">
                                <span class="d-block fw-semibold">@(bm.Title ?? DefaultBookmarkTitle(bm))</span>
                                <span class="d-block text-secondary small">
                                    @bm.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    @if (bm.PageNumber.HasValue)
                                    {
                                        <text> · Page @bm.PageNumber</text>
                                    }
                                </span>
                            </a>
                            <button class="btn btn-sm btn-outline-secondary border-0" title="Remove" @onclick="() => RemoveBookmarkAsync(bm)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="mt-4 d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="@($"read/{book.Id}")">
                    <i class="bi bi-book-half"></i> Read
                </a>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false" @onclick="EnsureAddToLoadedAsync">
                        <i class="bi bi-plus-circle"></i> Add to&hellip;
                    </button>
                    <ul class="dropdown-menu" style="min-width: 16rem;">
                        <li><h6 class="dropdown-header">Collections</h6></li>
                        @if (collections is null)
                        {
                            <li><span class="dropdown-item-text text-secondary small">Loading…</span></li>
                        }
                        else if (collections.Count == 0)
                        {
                            <li><span class="dropdown-item-text text-secondary small">No collections yet</span></li>
                        }
                        else
                        {
                            @foreach (var c in collections)
                            {
                                <li>
                                    <button type="button" class="dropdown-item d-flex justify-content-between align-items-center"
                                            @onclick="() => AddToCollectionAsync(c)">
                                        <span><i class="bi bi-bookshelf"></i> @c.Name</span>
                                        @if (c.IsGlobal)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-globe"></i></span>
                                        }
                                    </button>
                                </li>
                            }
                        }
                        <li>
                            <button type="button" class="dropdown-item text-primary"
                                    @onclick="() => StartCreate(AddToTarget.Collection)">
                                <i class="bi bi-plus-lg"></i> New collection&hellip;
                            </button>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">Reading lists</h6></li>
                        @if (readingLists is null)
                        {
                            <li><span class="dropdown-item-text text-secondary small">Loading…</span></li>
                        }
                        else if (readingLists.Count == 0)
                        {
                            <li><span class="dropdown-item-text text-secondary small">No reading lists yet</span></li>
                        }
                        else
                        {
                            @foreach (var l in readingLists)
                            {
                                <li>
                                    <button type="button" class="dropdown-item"
                                            @onclick="() => AddToReadingListAsync(l)">
                                        <i class="bi bi-list-ol"></i> @l.Name
                                    </button>
                                </li>
                            }
                        }
                        <li>
                            <button type="button" class="dropdown-item text-primary"
                                    @onclick="() => StartCreate(AddToTarget.ReadingList)">
                                <i class="bi bi-plus-lg"></i> New reading list&hellip;
                            </button>
                        </li>
                    </ul>
                </div>
                <a class="btn btn-outline-secondary" href="@($"covers/{book.Id}")" target="_blank" rel="noopener">
                    <i class="bi bi-image"></i> View cover
                </a>
                <a class="btn btn-outline-secondary" href="@($"books/{book.Id}/edit")">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <AuthorizeView Roles="@Constants.Roles.Administrator">
                    <Authorized>
                        <button class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>

            @if (creatingTarget is not null)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title">
                            @(creatingTarget == AddToTarget.Collection ? "New collection" : "New reading list")
                        </h6>
                        <div class="d-flex gap-2 align-items-start flex-wrap">
                            <input class="form-control" style="max-width: 24rem;"
                                   placeholder="Name…" @bind="newName" @bind:event="oninput" />
                            <button class="btn btn-primary" disabled="@(creating || string.IsNullOrWhiteSpace(newName))"
                                    @onclick="CreateAndAddAsync">
                                <i class="bi bi-check-lg"></i> Create &amp; add
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CancelCreate">
                                Cancel
                            </button>
                        </div>
                        @if (addToError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0">@addToError</div>
                        }
                    </div>
                </div>
            }
            else if (addToFlash is not null)
            {
                <div class="alert alert-success mt-3 mb-0 py-2 small d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle"></i> @addToFlash
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BookDto? book;
    private bool loading = true;
    private readonly List<BookmarkDto> bookmarks = [];

    private IReadOnlyList<CollectionDto>? collections;
    private IReadOnlyList<ReadingListDto>? readingLists;
    private bool addToLoaded;
    private AddToTarget? creatingTarget;
    private string newName = string.Empty;
    private bool creating;
    private string? addToError;
    private string? addToFlash;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var result = await BookService.GetByIdAsync(Id);
        book = result.IsSuccess ? result.Value : null;

        bookmarks.Clear();
        if (book is not null)
        {
            var bmResult = await BookmarkService.ListAsync(Id);
            if (bmResult.IsSuccess)
            {
                bookmarks.AddRange(bmResult.Value);
            }
        }

        loading = false;
    }

    private async Task DeleteAsync()
    {
        var result = await BookService.DeleteAsync(Id);
        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("books");
        }
    }

    private async Task RemoveBookmarkAsync(BookmarkDto bm)
    {
        var result = await BookmarkService.DeleteAsync(bm.Id);
        if (result.IsSuccess)
        {
            bookmarks.Remove(bm);
        }
    }

    /// <summary>
    /// Lazy-load the collections / reading lists the first time the dropdown opens —
    /// the typical book detail visit doesn't touch them at all, so eagerly fetching is wasted work.
    /// </summary>
    private async Task EnsureAddToLoadedAsync()
    {
        if (addToLoaded) return;
        addToLoaded = true;

        var collectionsTask = CollectionService.ListAsync();
        var listsTask = ReadingListService.ListAsync();
        await Task.WhenAll(collectionsTask, listsTask);

        collections = collectionsTask.Result.IsSuccess ? collectionsTask.Result.Value : [];
        readingLists = listsTask.Result.IsSuccess ? listsTask.Result.Value : [];
    }

    private async Task AddToCollectionAsync(CollectionDto c)
    {
        var result = await CollectionService.AddBookAsync(c.Id, Id);
        FlashAddTo(result.IsSuccess
            ? $"Added to collection \"{c.Name}\"."
            : (result.Errors.FirstOrDefault() ?? "Could not add to collection."), result.IsSuccess);
    }

    private async Task AddToReadingListAsync(ReadingListDto l)
    {
        var result = await ReadingListService.AddBookAsync(l.Id, Id);
        FlashAddTo(result.IsSuccess
            ? $"Added to reading list \"{l.Name}\"."
            : (result.Errors.FirstOrDefault() ?? "Could not add to reading list."), result.IsSuccess);
    }

    private void StartCreate(AddToTarget target)
    {
        creatingTarget = target;
        newName = string.Empty;
        addToError = null;
    }

    private void CancelCreate()
    {
        creatingTarget = null;
        addToError = null;
    }

    private async Task CreateAndAddAsync()
    {
        if (creatingTarget is null || string.IsNullOrWhiteSpace(newName)) return;

        creating = true;
        addToError = null;
        try
        {
            if (creatingTarget == AddToTarget.Collection)
            {
                var created = await CollectionService.CreateAsync(new CreateCollectionRequest { Name = newName });
                if (!created.IsSuccess)
                {
                    addToError = created.Errors.FirstOrDefault() ?? "Could not create collection.";
                    return;
                }
                var added = await CollectionService.AddBookAsync(created.Value.Id, Id);
                if (!added.IsSuccess)
                {
                    addToError = added.Errors.FirstOrDefault() ?? "Created collection but could not add the book.";
                    return;
                }

                // Refresh the dropdown so the new collection appears next time.
                addToLoaded = false;
                await EnsureAddToLoadedAsync();
                creatingTarget = null;
                FlashAddTo($"Created collection \"{created.Value.Name}\" and added this book.", success: true);
            }
            else
            {
                var created = await ReadingListService.CreateAsync(new CreateReadingListRequest { Name = newName });
                if (!created.IsSuccess)
                {
                    addToError = created.Errors.FirstOrDefault() ?? "Could not create reading list.";
                    return;
                }
                var added = await ReadingListService.AddBookAsync(created.Value.Id, Id);
                if (!added.IsSuccess)
                {
                    addToError = added.Errors.FirstOrDefault() ?? "Created list but could not add the book.";
                    return;
                }

                addToLoaded = false;
                await EnsureAddToLoadedAsync();
                creatingTarget = null;
                FlashAddTo($"Created reading list \"{created.Value.Name}\" and added this book.", success: true);
            }
        }
        finally
        {
            creating = false;
        }
    }

    private void FlashAddTo(string message, bool success)
    {
        if (success)
        {
            addToFlash = message;
            addToError = null;
        }
        else
        {
            addToError = message;
            addToFlash = null;
        }
    }

    private enum AddToTarget
    {
        Collection,
        ReadingList,
    }

    private static string DefaultBookmarkTitle(BookmarkDto bm)
        => bm.PageNumber.HasValue ? $"Page {bm.PageNumber}" : "Saved spot";

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return $"{value:0.##} {units[unit]}";
    }
}
