@page "/books/batch-edit"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@using System.Globalization
@using Shelfwarden.Extensions
@inject IBookService BookService
@inject IAuthorService AuthorService
@inject ISeriesService SeriesService
@inject IGenreService GenreService
@inject ITagService TagService
@inject NavigationManager NavigationManager
@inject ILogger<BatchEdit> Logger

<PageTitle>Batch edit - Shelfwarden</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
    <div>
        <a href="@returnUrl" class="text-secondary text-decoration-none small">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <h1 class="mb-0 mt-1">Batch edit</h1>
        @if (books is not null)
        {
            <div class="text-secondary small">
                @books.Count book@(books.Count == 1 ? "" : "s") loaded ·
                @books.Count(b => selectedIds.Contains(b.Id)) selected for save
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
        <button type="button" class="btn btn-primary" disabled="@(saving || books is null || books.Count == 0)" @onclick="SaveAsync">
            @if (saving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-check2-all me-1"></i>
            }
            Save changes
        </button>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
    </div>
}
@if (saveSummary is not null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-1"></i> @saveSummary
    </div>
}

@if (loading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
        <div class="mt-2">Loading books…</div>
    </div>
}
else if (books is null || books.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-question-circle empty-icon"></i>
        <h3>No books selected</h3>
        <p>Select one or more books on the books page first, then choose Batch edit.</p>
        <a class="btn btn-outline-secondary" href="books">
            <i class="bi bi-arrow-left"></i> Back to books
        </a>
    </div>
}
else
{
    @* ──────────────────────────────────────────────────────────────────────
       APPLY TO ALL panel — these affect every selected book uniformly. Each
       section has an explicit "Update" toggle; until ticked, the field is
       skipped at save time so users can't clobber values by accident.
       ────────────────────────────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi bi-stack"></i>
            <strong>Apply to all selected</strong>
            <span class="text-secondary small ms-2">Tick a section to include it in the batch save.</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6">
                    <BatchSectionSwitch Title="Series" @bind-Enabled="bulk.UpdateSeries">
                        <input class="form-control" type="text"
                               value="@seriesInput" @oninput="OnSeriesInput"
                               @onfocus="OnSeriesFocus" @onkeydown="OnSeriesKeyDown"
                               placeholder="Pick or create a series… (leave blank to clear)" />
                        @if (showSeriesSuggestions && seriesSuggestions.Count > 0)
                        {
                            <ul class="dropdown-menu d-block w-100 mt-1 shadow-sm"
                                style="position: relative; max-height: 220px; overflow-y: auto;">
                                @foreach (var s in seriesSuggestions)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(s.Name)">
                                            @s.Name
                                        </button>
                                    </li>
                                }
                                @if (!string.IsNullOrWhiteSpace(seriesInput) && !seriesSuggestions.Any(s => string.Equals(s.Name, seriesInput.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="() => SelectSeriesAsync(seriesInput!.Trim())">
                                            <i class="bi bi-plus-lg"></i> Create "<strong>@seriesInput.Trim()</strong>"
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="form-text">
                            Series number is edited per-row in the table below.
                        </div>
                    </BatchSectionSwitch>
                </div>

                <div class="col-lg-6">
                    <BatchSectionSwitch Title="Authors" @bind-Enabled="bulk.UpdateAuthors">
                        <BatchChipMode @bind-Mode="bulk.AuthorsMode" />
                        @if (bulk.AuthorsMode != ChipApplyMode.Remove)
                        {
                            <ChipInput TItem="AuthorDto"
                                       Label="Authors"
                                       Selected="bulkAuthors"
                                       NameOf="@(a => a.Name)"
                                       SearchAsync="SearchAuthorsAsync"
                                       OnAddAsync="AddAuthorAsync" />
                        }
                    </BatchSectionSwitch>
                </div>

                <div class="col-lg-6">
                    <BatchSectionSwitch Title="Genres" @bind-Enabled="bulk.UpdateGenres">
                        <BatchChipMode @bind-Mode="bulk.GenresMode" />
                        @if (bulk.GenresMode != ChipApplyMode.Remove)
                        {
                            <ChipInput TItem="GenreDto"
                                       Label="Genres"
                                       Selected="bulkGenres"
                                       NameOf="@(g => g.Name)"
                                       SearchAsync="SearchGenresAsync"
                                       OnAddAsync="AddGenreAsync" />
                        }
                    </BatchSectionSwitch>
                </div>

                <div class="col-lg-6">
                    <BatchSectionSwitch Title="Tags" @bind-Enabled="bulk.UpdateTags">
                        <BatchChipMode @bind-Mode="bulk.TagsMode" />
                        @if (bulk.TagsMode != ChipApplyMode.Remove)
                        {
                            <ChipInput TItem="string"
                                       Label="Tags"
                                       Selected="bulkTags"
                                       ChipCssSuffix="chip-tag"
                                       NameOf="@(t => t)"
                                       SearchAsync="SearchTagsAsync"
                                       OnAddAsync="AddTagAsync" />
                        }
                    </BatchSectionSwitch>
                </div>

                <div class="col-lg-6">
                    <BatchSectionSwitch Title="Publication" @bind-Enabled="bulk.UpdatePublication">
                        <BatchChipMode @bind-Mode="bulk.PublicationMode" />
                        @if (bulk.PublicationMode != ChipApplyMode.Remove)
                        {
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Publisher</label>
                                    <input class="form-control" @bind="bulk.Publisher" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Language</label>
                                    <input class="form-control" @bind="bulk.Language" placeholder="en, fr, de…" />
                                </div>
                            </div>
                        }
                    </BatchSectionSwitch>
                </div>
            </div>
        </div>
    </div>

    @* ──────────────────────────────────────────────────────────────────────
       PER-ROW grid — title / sort title / subtitle / # in series / desc.
       ────────────────────────────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi bi-table"></i>
            <strong>Per-book details</strong>
            <span class="text-secondary small ms-2">Edit one book per row. Untick to skip a row.</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle batch-edit-grid mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 36px;">
                            <input class="form-check-input" type="checkbox"
                                   checked="@(selectedIds.Count == books.Count)"
                                   @onchange="ToggleSelectAll" />
                        </th>
                        <th style="width: 56px;"></th>
                        <th>Title</th>
                        <th style="min-width: 11rem;">
                            <span class="d-block small text-body-secondary mb-1">Sort title</span>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="batchAutoSortTitle"
                                       @bind="autoUpdateSortTitle"
                                       @bind:after="OnAfterAutoUpdateSortTitleChanged" />
                                <label class="form-check-label small" for="batchAutoSortTitle">Auto Update Sort Title</label>
                            </div>
                        </th>
                        <th>Subtitle</th>
                        <th style="width: 90px;">#</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr class="@(selectedIds.Contains(row.Id) ? "" : "table-secondary text-secondary")">
                            <td>
                                <input class="form-check-input" type="checkbox"
                                       checked="@selectedIds.Contains(row.Id)"
                                       @onchange="e => ToggleRow(row.Id, (bool)(e.Value ?? false))" />
                            </td>
                            <td>
                                <a href="@($"books/{row.Id}")" target="_blank" title="Open in new tab">
                                    @if (!string.IsNullOrEmpty(row.CoverImagePath))
                                    {
                                        <img src="@($"covers/{row.Id}")" class="batch-edit-cover" alt="@row.Title" />
                                    }
                                    else
                                    {
                                        <div class="batch-edit-cover batch-edit-cover-empty">
                                            <i class="bi bi-book"></i>
                                        </div>
                                    }
                                </a>
                            </td>
                            <td><input class="form-control form-control-sm" @bind="row.Title" @bind:event="onchange" @bind:after="() => OnTitleChanged(row)" /></td>
                            <td><input class="form-control form-control-sm" @bind="row.SortTitle" /></td>
                            <td><input class="form-control form-control-sm" @bind="row.Subtitle" /></td>
                            <td><input class="form-control form-control-sm" type="number" step="0.01" @bind="row.NumberInSeries" @bind:event="onchange" @bind:after="() => OnNumberInSeriesChanged(row)" /></td>
                            <td>
                                <textarea class="form-control form-control-sm" rows="2" @bind="row.Description"></textarea>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
