@page "/audiobooks"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]

<PageTitle>Audiobooks - Shelfwarden</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-0">Audiobooks</h1>
        <p class="text-secondary mb-0">Every text-to-speech generation across the library.</p>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAsync" disabled="@loading">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="@(() => error = null)" aria-label="Close"></button>
    </div>
}

@if (loading && items is null)
{
    <p class="text-secondary"><em>Loading…</em></p>
}
else if (items is null || items.Count == 0)
{
    <div class="text-center text-secondary py-5">
        <i class="bi bi-headphones fs-1 d-block mb-2"></i>
        No audiobooks have been generated yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Voice</th>
                    <th>Status</th>
                    <th class="text-end">Size</th>
                    <th class="text-end">Length</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var badge = StatusBadge(item.State);
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="audiobook-table-cover">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverImagePath))
                                    {
                                        <img src="@($"covers/{item.BookId}")" alt="@item.BookTitle" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-book placeholder-icon"></i>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <a href="books/@item.BookId" class="fw-semibold text-decoration-none">@item.BookTitle</a>
                                    @if (!string.IsNullOrWhiteSpace(item.AuthorNames))
                                    {
                                        <div class="small text-secondary">@item.AuthorNames</div>
                                    }
                                    @if (item.SplitByChapter)
                                    {
                                        <span class="badge text-bg-light border">@item.ChapterCount chapter@(item.ChapterCount == 1 ? "" : "s")</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span class="text-secondary">@item.VoiceName</span></td>
                        <td style="min-width: 12rem;">
                            <span class="badge @badge.Css">@badge.Label</span>
                            @if (item.State is AudiobookState.Pending or AudiobookState.Running)
                            {
                                <div class="progress mt-1" style="height: 6px;" role="progressbar">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                         style="width: @((item.PercentComplete ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <div class="small text-secondary mt-1">
                                    @(item.CurrentStage ?? "Waiting…")
                                    @if (item.PercentComplete is double p)
                                    {
                                        <span>· @p.ToString("0.#")%</span>
                                    }
                                </div>
                            }
                            else if (item.State == AudiobookState.Failed && !string.IsNullOrWhiteSpace(item.ErrorMessage))
                            {
                                <div class="small text-danger mt-1" title="@item.ErrorMessage">@item.ErrorMessage</div>
                            }
                        </td>
                        <td class="text-end text-secondary">@FormatSize(item.OutputSizeBytes)</td>
                        <td class="text-end text-secondary">@FormatDuration(item.DurationSeconds)</td>
                        <td class="text-secondary small">@item.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end text-nowrap">
                            @if (item.State == AudiobookState.Completed)
                            {
                                @if (item.SplitByChapter)
                                {
                                    <a href="books/@item.BookId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-play-fill"></i> Play
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => TogglePlay(item.BookId)">
                                        <i class="bi @(playingBookId == item.BookId ? "bi-stop-fill" : "bi-play-fill")"></i>
                                        @(playingBookId == item.BookId ? "Stop" : "Play")
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger ms-1"
                                        @onclick="() => DeleteAsync(item)" disabled="@(busyBookId == item.BookId)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }
                            else if (item.State is AudiobookState.Pending or AudiobookState.Running)
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => CancelAsync(item)" disabled="@(busyBookId == item.BookId)">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            }
                            else if (item.State == AudiobookState.Failed)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => CancelAsync(item)" disabled="@(busyBookId == item.BookId)">
                                    <i class="bi bi-x-circle"></i> Clear
                                </button>
                            }
                        </td>
                    </tr>
                    @if (playingBookId == item.BookId && item.State == AudiobookState.Completed && !item.SplitByChapter)
                    {
                        <tr>
                            <td colspan="7" class="bg-body-tertiary">
                                <audio controls autoplay preload="metadata" class="w-100" src="@($"audiobooks/{item.BookId}")"></audio>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
