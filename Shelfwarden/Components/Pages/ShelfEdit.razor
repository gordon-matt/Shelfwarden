@page "/shelves/new"
@page "/shelves/{Id:int}/edit"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@using Shelfwarden.Infrastructure
@inject IShelfService ShelfService
@inject IUserInfoService UserInfoService
@inject ISidebarNavRefreshService SidebarNavRefresh
@inject NavigationManager NavigationManager
@inject ILogger<ShelfEdit> ShelfEditLogger
@inject IBookService BookService
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(IsCreate ? "New shelf" : $"Edit {model.Name}") - Shelfwarden</PageTitle>

<h1 class="mb-3">@(IsCreate ? "New shelf" : "Edit shelf")</h1>

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}

<EditForm Model="model" OnValidSubmit="SaveAsync" FormName="shelf-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="model.Name" />
        <ValidationMessage For="@(() => model.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" rows="3" @bind-Value="model.Description" />
        <ValidationMessage For="@(() => model.Description)" />
    </div>

    @if (Id is int && shelfBannerSettings is not null)
    {
        <div class="mb-3">
            <CardHeaderImageSelector @bind-Mode="bannerMode"
                                     SelectedBooks="bannerSelectedBooks"
                                     SearchBooksInScopeAsync="SearchBooksOnThisShelfForBannerAsync"
                                     OnUploadAsync="UploadThisShelfBannerAsync"
                                     OnSelectedBooksChanged="StateHasChanged" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Who can see this shelf</label>
        <p class="form-text mb-2">
            Leave both sections empty to allow <strong>every signed-in user</strong> to browse this shelf.
            If you add users or roles, only those accounts (or administrators) will see it.
        </p>

        <div class="row g-3">
            <div class="col-md-6">
                <span class="form-label d-block small text-body-secondary">Roles</span>
                <div class="border rounded p-3 bg-body-secondary bg-opacity-10">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="role-admin" @bind-Value="allowRoleAdministrator" />
                        <label class="form-check-label" for="role-admin">@Constants.Roles.Administrator</label>
                    </div>
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="role-user" @bind-Value="allowRoleUser" />
                        <label class="form-check-label" for="role-user">@Constants.Roles.User</label>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <span class="form-label d-block small text-body-secondary">Users</span>
                @if (catalogUsers is null)
                {
                    <p class="text-secondary small mb-0"><em>Loading users…</em></p>
                }
                else if (catalogUsers.Count == 0)
                {
                    <p class="text-secondary small mb-0">No users returned — cannot assign individuals.</p>
                }
                else
                {
                    <div class="border rounded p-2 shelf-user-checklist" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var u in catalogUsers)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@($"u-{u.Id}")"
                                       checked="@selectedUserIds.Contains(u.Id)"
                                       @onchange="e => ToggleUser(u.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="@($"u-{u.Id}")">
                                    @(u.Email ?? u.UserName)
                                    @if (!string.IsNullOrEmpty(u.DisplayName) && !string.Equals(u.DisplayName, u.UserName, StringComparison.Ordinal))
                                    {
                                        <span class="text-secondary small">(@u.DisplayName)</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Folders</label>
        <p class="form-text mb-2">Absolute paths to folders that contain ebooks. Subfolders are scanned recursively.</p>
        @for (int i = 0; i < folders.Count; i++)
        {
            int captured = i;
            <div class="input-group mb-1">
                <span class="input-group-text"><i class="bi bi-folder"></i></span>
                <input class="form-control" placeholder="/path/to/books" value="@folders[captured]"
                       @oninput="@(e => folders[captured] = e.Value?.ToString() ?? string.Empty)" />
                <button class="btn btn-outline-secondary" type="button" @onclick="() => ShowFolderPicker(captured)"
                        title="Browse container filesystem">
                    <i class="bi bi-folder2-open"></i>
                </button>
                <button class="btn btn-outline-danger" type="button" @onclick="() => RemoveFolder(captured)" disabled="@(folders.Count == 1)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        }
        <button class="btn btn-sm btn-outline-secondary mt-1" type="button" @onclick="AddFolder">
            <i class="bi bi-plus-lg"></i> Add folder
        </button>
    </div>

    @if (_showFolderPicker)
    {
        <FileSystemPicker Mode="FileSystemPicker.PickerMode.Folder"
                          Title="Select Shelf Folder"
                          OnConfirm="OnFolderPickerConfirm"
                          OnCancel="() => _showFolderPicker = false" />
    }

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <div class="alert alert-danger" role="alert">@saveError</div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit" disabled="@saving">
            @if (saving)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Save
        </button>
        <a class="btn btn-link" href="shelves">Cancel</a>
    </div>
</EditForm>
