@page "/setup"
@layout SetupLayout
@using Microsoft.AspNetCore.WebUtilities
@using Shelfwarden.Infrastructure
@inject IAuthProviderService AuthProvider
@inject ISetupService SetupService
@inject NavigationManager Nav
@inject ILogger<Setup> SetupWizardLogger

<PageTitle>First-run setup - Shelfwarden</PageTitle>

@* The wizard is anonymous on purpose — when Identity is the auth provider the user hasn't
   even created an admin account yet. Each mutating action goes through the SetupController
   so it has an HttpContext (for SignIn) and so the redirect-after-POST keeps Blazor's
   circuit state out of the picture. *@

@if (status is null)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (status.SetupComplete)
{
    <h1 class="h3 mb-3">All set</h1>
    <p>Setup is already complete. <a href="/">Go to the dashboard</a>.</p>
}
else
{
    <div class="setup-stepper" aria-label="Setup progress">
        @foreach (var s in steps)
        {
            <div class="setup-step @(s.Id == CurrentStep ? "active" : null) @(IsStepDone(s.Id) ? "done" : null)">
                <span class="setup-step-bullet">
                    @if (IsStepDone(s.Id))
                    {
                        <i class="bi bi-check-lg"></i>
                    }
                    else
                    {
                        @s.Number
                    }
                </span>
                <span class="setup-step-label">@s.Label</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @switch (CurrentStep)
    {
        case "welcome":
            <h1 class="h3 mb-2">Welcome to Shelfwarden</h1>
            <p class="text-secondary">
                You're three short steps away from your first shelf. We'll set up an
                administrator, point at a folder of books, and we're done.
            </p>
            <ul class="text-secondary small">
                <li>Authentication mode: <strong>@status.AuthProvider</strong></li>
                @if (status.ShelfCount > 0)
                {
                    <li>@status.ShelfCount shelf(s) already exist — you can go straight to "Finish".</li>
                }
            </ul>
            <div class="setup-actions">
                <a class="btn btn-primary" href="@NextLinkAfterWelcome()">
                    Get started <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            break;

        case "admin":
            <h1 class="h3 mb-2">Create your administrator</h1>
            <p class="text-secondary">
                Pick the email and password you'd like to use to sign in. We'll replace the
                default <code>admin@@shelfwarden.local</code> account with these values.
            </p>
            <form method="post" action="/setup/identity-admin" class="setup-form">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label" for="setup-email">Email</label>
                    <input id="setup-email" name="Email" type="email" class="form-control"
                           value="@adminEmail" required autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="setup-name">Display name</label>
                    <input id="setup-name" name="DisplayName" type="text" class="form-control"
                           value="Administrator" maxlength="128" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="setup-password">Password</label>
                    <input id="setup-password" name="Password" type="password" class="form-control"
                           required minlength="6" autocomplete="new-password" />
                    <div class="form-text">At least 6 characters.</div>
                </div>
                <div class="setup-actions">
                    <a class="btn btn-outline-secondary" href="/setup">Back</a>
                    <button class="btn btn-primary" type="submit">
                        Save and continue <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </form>
            break;

        case "shelf":
            @if (status.AuthProvider == nameof(Shelfwarden.Services.Auth.AuthProvider.Keycloak)
                 && !status.CallerIsAdministrator)
            {
                <h1 class="h3 mb-2">Sign in as an administrator</h1>
                <p class="text-secondary">
                    Shelfwarden is configured to use Keycloak for authentication. Sign in
                    with a user that has the <code>Administrator</code> realm role to finish setup.
                </p>
                <div class="setup-actions">
                    <a class="btn btn-primary" href="/auth/login?returnUrl=%2Fsetup%3Fstep%3Dshelf">
                        Sign in with Keycloak <i class="bi bi-box-arrow-in-right ms-1"></i>
                    </a>
                </div>
            }
            else
            {
                <h1 class="h3 mb-2">Add your first shelf</h1>
                <p class="text-secondary">
                    Point Shelfwarden at one or more folders that contain your ebooks. We'll scan
                    these in the background after setup finishes.
                </p>
                <form method="post" action="/setup/shelf" class="setup-form">
                    <AntiforgeryToken />
                    <div class="mb-3">
                        <label class="form-label" for="setup-lib-name">Shelf name</label>
                        <input id="setup-lib-name" name="name" type="text" class="form-control"
                               value="@shelfName" maxlength="256" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="setup-lib-folders">Folders (one per line)</label>
                        <textarea id="setup-lib-folders" name="folders" class="form-control" rows="4"
                                  placeholder="@FolderPlaceholder()" required>@shelfFolders</textarea>
                        <div class="form-text">Absolute paths. We'll create them later if they don't exist.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="setup-lib-desc">Description (optional)</label>
                        <input id="setup-lib-desc" name="description" type="text" class="form-control"
                               maxlength="2048" />
                    </div>
                    <div class="setup-actions">
                        <a class="btn btn-link" href="/setup?step=done">Skip — set up later</a>
                        <button class="btn btn-primary" type="submit">
                            Create shelf <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </form>
            }
            break;

        case "done":
            <h1 class="h3 mb-2">You're ready to go</h1>
            <p class="text-secondary">
                @if (status.ShelfCount > 0)
                {
                    <text>Shelfwarden has @status.ShelfCount shelf(s) configured. We'll start scanning
                    once you head to the dashboard.</text>
                }
                else
                {
                    <text>You skipped the shelf step — no problem. Head to <em>Shelves</em> in the
                    sidebar after sign-in to add one.</text>
                }
            </p>
            <form method="post" action="/setup/complete" class="setup-form">
                <AntiforgeryToken />
                <div class="setup-actions">
                    <a class="btn btn-outline-secondary" href="/setup?step=shelf">Back</a>
                    <button class="btn btn-success" type="submit">
                        Finish <i class="bi bi-check2 ms-1"></i>
                    </button>
                </div>
            </form>
            break;
    }
}

@code {
    [SupplyParameterFromQuery] public string? Step { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private SetupStatusDto? status;
    private string? errorMessage;
    private string adminEmail = "admin@shelfwarden.local";
    private string shelfName = "My Shelf";
    private string shelfFolders = "";

    private record StepDescriptor(string Id, int Number, string Label);

    private List<StepDescriptor> steps = [];

    private string CurrentStep => ResolveStep(Step);

    protected override async Task OnInitializedAsync()
    {
        var result = await SetupService.GetStatusAsync();
        if (result.IsSuccess)
        {
            status = result.Value;
            BuildSteps();
            SetupWizardLogger.LogInformation(
                "[SetupWizard] GetStatusAsync OK SetupComplete={Complete} Auth={Auth} ShelfCount={ShelfCount} CallerAdmin={Admin}",
                status.SetupComplete,
                status.AuthProvider,
                status.ShelfCount,
                status.CallerIsAdministrator);
        }
        else
        {
            errorMessage = ResultMessages.UserFacing(result, "Failed to load setup state.");
            SetupWizardLogger.LogWarning(
                "[SetupWizard] GetStatusAsync failed Status={Status} MessageLen={Len}",
                result.Status,
                errorMessage?.Length ?? 0);
        }
    }

    private void BuildSteps()
    {
        steps.Clear();
        steps.Add(new StepDescriptor("welcome", 1, "Welcome"));

        int n = 2;
        if (status?.AuthProvider == nameof(Shelfwarden.Services.Auth.AuthProvider.Identity))
        {
            steps.Add(new StepDescriptor("admin", n++, "Administrator"));
        }

        steps.Add(new StepDescriptor("shelf", n++, "First shelf"));
        steps.Add(new StepDescriptor("done", n, "Finish"));
    }

    private string ResolveStep(string? requested)
    {
        if (status is null) return "welcome";
        if (string.IsNullOrEmpty(requested)) return "welcome";

        bool valid = steps.Any(s => s.Id.Equals(requested, StringComparison.OrdinalIgnoreCase));
        return valid ? requested.ToLowerInvariant() : "welcome";
    }

    private bool IsStepDone(string stepId)
    {
        int currentIndex = steps.FindIndex(s => s.Id == CurrentStep);
        int targetIndex = steps.FindIndex(s => s.Id == stepId);
        return currentIndex >= 0 && targetIndex >= 0 && targetIndex < currentIndex;
    }

    private string NextLinkAfterWelcome()
    {
        if (status?.AuthProvider == nameof(Shelfwarden.Services.Auth.AuthProvider.Identity))
        {
            return "/setup?step=admin";
        }
        return "/setup?step=shelf";
    }

    private static string FolderPlaceholder()
    {
        return OperatingSystem.IsWindows()
            ? "D:\\Library\\Fiction\nD:\\Library\\NonFiction"
            : "/app/data/library/Fiction\n/app/data/library/NonFiction";
    }

    protected override void OnParametersSet()
    {
        LogQueryDiagnostics();

        if (!string.IsNullOrWhiteSpace(Error))
        {
            errorMessage = Error.Trim();
            SetupWizardLogger.LogWarning(
                "[SetupWizard] errorMessage from query SupplyParameter Len={Len} AfterTrim Len={TrimLen} ShowAlert={Show}",
                Error.Length,
                errorMessage?.Length ?? 0,
                !string.IsNullOrWhiteSpace(errorMessage));
            if (!string.IsNullOrEmpty(errorMessage) && errorMessage.Length <= 400)
            {
                SetupWizardLogger.LogWarning("[SetupWizard] errorMessage preview: {Preview}", errorMessage);
            }
        }
        else if (Error is not null)
        {
            SetupWizardLogger.LogWarning(
                "[SetupWizard] Error query present but whitespace-only SupplyLen={Len}",
                Error.Length);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(errorMessage))
        {
            SetupWizardLogger.LogWarning(
                "[SetupWizard] First render: showing alert with errorMessage length={Len}",
                errorMessage!.Length);
        }
    }

    /// <summary>Logs raw query vs supply parameters — helps debug proxy/encoding issues on NAS.</summary>
    private void LogQueryDiagnostics()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var qs = QueryHelpers.ParseQuery(uri.Query);
            qs.TryGetValue("error", out var errorFromQuery);
            string? parsed = errorFromQuery.Count > 0 ? errorFromQuery[0] : null;

            bool supplyMatchesParsed = string.Equals(Error, parsed, StringComparison.Ordinal);
            SetupWizardLogger.LogInformation(
                "[SetupWizard] Query diag PathAndQuery={Path} SupplyStep={SupplyStep} SupplyErrorLen={SupplyErrLen} ParsedErrorLen={ParsedLen} ParamsMatch={Match}",
                uri.PathAndQuery,
                Step,
                Error?.Length ?? 0,
                parsed?.Length ?? 0,
                supplyMatchesParsed);

            if (parsed is { Length: > 0 } && string.IsNullOrWhiteSpace(parsed))
            {
                SetupWizardLogger.LogWarning("[SetupWizard] Parsed 'error' is non-empty but all whitespace (invisible characters?) Codes={Codes}",
                    FormatCodePoints(parsed, 48));
            }

            if (parsed is { Length: > 0 } && !supplyMatchesParsed)
            {
                SetupWizardLogger.LogWarning(
                    "[SetupWizard] SupplyParameter Error differs from parsed query — binding issue? SupplyCodes={Supply} ParsedCodes={Parsed}",
                    FormatCodePoints(Error ?? "", 32),
                    FormatCodePoints(parsed, 32));
            }
        }
        catch (Exception ex)
        {
            SetupWizardLogger.LogError(ex, "[SetupWizard] LogQueryDiagnostics failed");
        }
    }

    private static string FormatCodePoints(string s, int maxChars)
    {
        int n = Math.Min(s.Length, maxChars);
        var parts = new string[n];
        for (int i = 0; i < n; i++)
        {
            parts[i] = $"U+{(uint)s[i]:X4}";
        }

        return string.Join(",", parts);
    }
}
