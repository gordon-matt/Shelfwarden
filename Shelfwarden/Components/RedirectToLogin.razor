@inject NavigationManager NavigationManager
@inject IAuthProviderService AuthProvider

@code {
    protected override void OnInitialized()
    {
        // For Identity, the Razor Page Identity UI handles login at /Identity/Account/Login.
        // For Keycloak, the OIDC challenge kicks in automatically via cookie auth.
        // For None, this page is unreachable because every request is already authenticated.
        string returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
        string target = AuthProvider.Provider switch
        {
            Shelfwarden.Services.AuthProvider.Identity => $"Identity/Account/Login?ReturnUrl=/{returnUrl}",
            Shelfwarden.Services.AuthProvider.Keycloak => $"auth/login?returnUrl={returnUrl}",
            _ => "/",
        };
        NavigationManager.NavigateTo(target, forceLoad: true);
    }
}
