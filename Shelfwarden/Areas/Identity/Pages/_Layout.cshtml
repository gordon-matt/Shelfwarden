@using System.Text.Json
@using Microsoft.Extensions.Options
@using Heroicsoft.NetForge.Abstractions.Theming
@using Heroicsoft.NetForge.Components.Theming
@inject IOptions<ForgeUiOptions> UiOptions
@*
    Layout for the embedded ASP.NET Identity UI. The app itself stays on Bootswatch, so this page
    does not load theme-init.js: that script would read a Bootswatch name out of the shared
    storage key and could write "light" or "dark" back over it. A short script only maps the
    stored theme onto the nf light/dark scheme.
*@
@{
    const string siteName = "Shelfwarden";
    var ui = UiOptions.Value;
    string? accentCss = ForgeAccentCss.Build(ui);
    string storageKey = Constants.ClientThemeLocalStorageKey;
    string defaultScheme = BootswatchThemes.IsDarkColorScheme(BootswatchThemes.Default) ? "dark" : "light";
    string darkThemesJson = JsonSerializer.Serialize(BootswatchThemes.DarkColorScheme.ToArray());
}
<!DOCTYPE html>
<html lang="en" data-theme="@defaultScheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script>
        (function () {
            var dark = @Html.Raw(darkThemesJson);
            var stored = null;
            try { stored = localStorage.getItem(@Html.Raw(JsonSerializer.Serialize(storageKey))); } catch (e) { }
            var name = stored ? String(stored).toLowerCase() : "";
            var theme = name ? (dark.indexOf(name) >= 0 ? "dark" : "light") : @Html.Raw(JsonSerializer.Serialize(defaultScheme));
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <link rel="stylesheet" href="~/_content/Heroicsoft.NetForge.Components/css/nf.css" />
    @if (accentCss is not null)
    {
        <style>@Html.Raw(accentCss)</style>
    }
</head>
<body>
    <div class="nf-standalone">
        <div class="nf-standalone-body">
            <div class="nf-auth-card">
                <a class="nf-brand-link" href="/">
                    <img class="nf-brand-logo nf-has-dark" src="~/img/Logo.png" alt="@siteName" />
                    <img class="nf-brand-logo-dark" src="~/img/Logo_Light.png" alt="" />
                </a>
                @RenderBody()
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
