<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.1.0</Version>
		<!--
			MySQL support is structurally wired but not yet active.

			Reason: Pomelo.EntityFrameworkCore.MySql does not yet have an EF Core 10
			compatible release (PRs #2019 / #2026 / #2032 are in flight as of 2026-04;
			the latest published version is 9.0.0 which targets EF Core 9). We can't
			pin EF Core 9 here because the shared Shelfwarden.Data uses EF Core 10.

			When Pomelo ships a 10.0.0 preview, uncomment the package references below
			and re-implement ApplicationDbContext / ApplicationDbContextFactory bodies.
			Until then, ApplicationDbContext throws NotSupportedException at runtime
			and the web project rejects DatabaseProvider="MySql" at startup.
		-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.Core" Version="1.8.23" />
		<PackageReference Include="Hangfire.NetCore" Version="1.8.23" />
		<!-- Pending EF Core 10 release of Pomelo:
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="10.0.0-*" />
		<PackageReference Include="Hangfire.Storage.MySql" Version="2.1.0-beta" />
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.6">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shelfwarden.Data\Shelfwarden.Data.csproj" />
	</ItemGroup>

</Project>
